{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "backend"
      ],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "--prefix",
        "hubsell-mobile"
      ],
      "port": 8081
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "hubsell-landing"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "mobile-web-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.HUBSELL_API='https://localhost:4000';process.env.NODE_TLS_REJECT_UNAUTHORIZED='0';require('child_process').spawn('npm',['run','web','--prefix','hubsell-mobile'],{stdio:'inherit',shell:true})"
      ],
      "port": 8081
    },
    {
      "name": "mobile-android-local",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "process.env.HUBSELL_API='https://localhost:4000';process.env.NODE_TLS_REJECT_UNAUTHORIZED='0';process.env.EXPO_PUBLIC_API_URL='http://10.0.2.2:8099';const cp=require('child_process');cp.spawn('node',['hubsell-mobile/scripts/dev-proxy.js'],{stdio:'inherit'});cp.spawn('npx',['expo','start','--android','--port','8082'],{stdio:'inherit',shell:true,cwd:'hubsell-mobile'})"
      ],
      "port": 8082
    }
  ]
}
