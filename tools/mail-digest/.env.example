# Sao chep file nay thanh .env (cung thu muc) roi dien mat khau ung dung.
# KHONG dan mat khau vao chat. File .env da nam trong .gitignore.

# --- Zoho Mail (to chuc tra tien -> imappro.zoho.com; tai khoan ca nhan moi la imap.zoho.com)
ZOHO_IMAP_HOST=imappro.zoho.com
ZOHO_IMAP_USER=dev@hubsell.vn
ZOHO_IMAP_PASS=
# Thu muc doc (phan cach bang dau |). Ban tin va DMARC chi dem so, khong doc.
ZOHO_FOLDERS=INBOX|Hỗ trợ|Thanh toán|Hạ tầng|Hệ thống
ZOHO_COUNT_ONLY_FOLDERS=Bản tin|DMARC

# --- Gmail (can bat Xac minh 2 buoc roi tao "Mat khau ung dung")
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_USER=hubselltech@gmail.com
GMAIL_IMAP_PASS=
GMAIL_FOLDERS=INBOX

# Lan chay dau tien nhin lai bao nhieu ngay (sau do chi doc thu moi hon lan truoc)
FIRST_RUN_LOOKBACK_DAYS=3
# Toi da bao nhieu ky tu noi dung moi thu dua vao ban tom tat
BODY_CHARS=400
# Toi da bao nhieu thu gan co trong Hop thu den duoc nhac lai moi ngay
PENDING_MAX=20
