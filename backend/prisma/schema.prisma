// Prisma schema — định nghĩa cấu trúc database cho Hubsell
// Tài liệu: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUM ----------

enum ChannelName {
  SHOPEE
  LAZADA
  TIKTOK
  OFFLINE
}

/// Vòng đời đơn hàng TMĐT.
///
/// PROCESSED là mốc chống in trùng và đóng gói lặp: đơn đã được xác nhận và
/// chuẩn bị xong nhưng CHƯA bàn giao cho shipper. Thiếu mốc này thì đơn vừa
/// xác nhận đã nhảy thẳng sang "Đang giao", nhân viên khác nhìn vào tưởng hàng
/// đã đi rồi, hoặc ngược lại vào in lại phiếu của đơn người kia đang gói.
enum ShippingStatus {
  PENDING // Chờ xử lý — đơn mới đồng bộ từ sàn về
  PROCESSED // Đã xử lý — đã xác nhận, đang/đã đóng gói, chờ bàn giao
  SHIPPING // Đang giao — đã bàn giao cho đơn vị vận chuyển
  DELIVERED // Đã giao thành công
  CANCELLED // Hủy / hoàn trả
}

/// Tình trạng hàng hoàn về kho (RTS — Return To Seller).
///
/// Tách khỏi shippingStatus vì đây là hai trục khác nhau: đơn có thể đã HỦY từ
/// lâu (trục vận chuyển) nhưng kiện hàng vẫn đang trên đường quay về (trục
/// hoàn). Gộp chung thì không biết đơn nào đã thực sự cầm được hàng trong tay.
/// Giải pháp hoàn SÀN CHỐT trên yêu cầu Trả hàng/Hoàn tiền (Shopee
/// return_solution: 0 = RETURN_REFUND, 1 = REFUND_ONLY; TikTok return_type;
/// Lazada request_type). Quyết định giá vốn có mất hay không trong Lãi/Lỗ:
/// REFUND_ONLY = khách giữ hàng (mất vốn), RETURN_REFUND = hàng về (thu hồi).
enum ReturnSolution {
  RETURN_REFUND
  REFUND_ONLY
}

enum ReturnStatus {
  NONE // không phải đơn hoàn
  AWAITING // đang chờ hàng quay về kho
  RECEIVED // đã nhận hàng về tay (quét mã) — CHƯA cộng tồn kho, chờ nhập kho
  RECEIVED_INTACT // đã nhập kho, hàng nguyên vẹn — ĐÃ cộng lại tồn kho
  DAMAGED // hư hỏng / mất / tráo hàng — KHÔNG cộng kho, chờ khiếu nại
  CLAIM_SETTLED // khiếu nại THẮNG — sàn/bưu cục đã đền bù
  WRITTEN_OFF // khiếu nại THUA — shop chịu hao hụt, tính vào lỗ
}

/// Đơn vị vận chuyển. Mỗi sàn thường dùng vài hãng, shop cần lọc theo hãng để
/// gom đơn giao cho đúng shipper khi họ đến lấy hàng.
enum Carrier {
  SPX // Shopee Express
  GHTK // Giao Hàng Tiết Kiệm
  GHN // Giao Hàng Nhanh
  JT // J&T Express
  VIETTEL_POST
  NINJA_VAN
  BEST // BEST Express
  KHAC // hãng khác / shop tự giao
}

enum InventoryLogType {
  IMPORT // Nhập kho
  EXPORT // Xuất kho
  SYNC   // Đồng bộ với sàn
}

enum ExpenseCategory {
  RENT      // Tiền mặt bằng
  SALARY    // Tiền nhân viên
  PACKAGING // Tiền đóng gói
  ADS       // Tiền quảng cáo sàn
  OTHER     // Chi phí khác
}

enum ExpenseType {
  FIXED    // Chi phí cố định (mặt bằng, lương...)
  VARIABLE // Chi phí biến đổi (quảng cáo, đóng gói...)
}

/// Chiều của một giao dịch vận hành: THU (tiền vào) hay CHI (tiền ra).
enum TransactionDirection {
  INCOME  // khoản THU vận hành (tiền vào)
  EXPENSE // khoản CHI vận hành (tiền ra)
}

/// "Túi tiền" mà khoản thu/chi tác động tới, ánh xạ thẳng sang cột của bảng
/// "Phân bổ dòng tiền theo gian hàng":
///  - PLATFORM_WALLET → cột "Tiền trên Ví sàn" (settled) của gian.
///  - BANK_ACCOUNT    → cột "Tiền về Ngân hàng" (withdrawn) của gian.
enum FundSourceType {
  PLATFORM_WALLET
  BANK_ACCOUNT
}

/// Trạng thái khiếu nại chênh lệch phí vận chuyển với sàn
enum ShippingDisputeStatus {
  CHO_KHIEU_NAI  // phát hiện lệch, chưa gửi khiếu nại
  DANG_KHIEU_NAI // đã gửi khiếu nại, đang chờ sàn xử lý
  DA_DOI_SOAT    // sàn đã đối soát/hoàn tiền xong
}

/// Trạng thái xử lý một khoản "sàn trả THIẾU" (rổ #2 trang Kiểm toán phí sàn)
enum FeeAuditStatus {
  CHO_XU_LY      // phát hiện lệch, chưa ai đụng
  DANG_KHIEU_NAI // đã gửi khiếu nại sàn, chờ phản hồi
  DA_XU_LY       // sàn đã bù tiền / giải thích thỏa đáng
  BO_QUA         // chủ shop xác nhận không đòi (số nhỏ, có lý do...)
}

/// Cơ sở tính của % thuế bổ sung — chủ shop chọn thẳng trên trang Thuế bổ
/// sung (đã bỏ khái niệm "đối tượng chịu thuế" trung gian):
///   PROFIT  → % nhân với LỢI NHUẬN trước thuế của kỳ (kiểu dự phòng TNDN)
///   REVENUE → % nhân với DOANH THU gốc của kỳ (kiểu thuế khoán hộ KD)
enum TaxCalculationBase {
  PROFIT
  REVENUE
}

/// Kỳ áp dụng của % thuế bổ sung khi lên báo cáo (khớp bộ lọc thời gian).
enum TaxFilterPeriod {
  MONTH   // theo tháng
  QUARTER // theo quý
  YEAR    // theo năm
}

/// Hai luồng phát hành HĐĐT theo NĐ 123/2020 — quyết định tab cấu hình và bộ
/// API MISA sẽ gọi khi xuất hóa đơn từ đơn hàng:
///   STANDARD — hóa đơn kê khai (doanh nghiệp): meInvoice + ký số eSign từng
///              hóa đơn, chờ CQT cấp mã.
///   POS      — hóa đơn từ máy tính tiền (HKD/bán lẻ, ký hiệu C26MXX): CQT cấp
///              DẢI MÃ trước, phát hành tức thì, KHÔNG ký số từng đơn.
enum InvoiceType {
  STANDARD
  POS
}

/// Vòng đời một yêu cầu phát hành hóa đơn điện tử gửi sang NCC.
enum InvoiceLogStatus {
  PENDING   // đã gửi yêu cầu, chờ NCC phát hành
  ISSUED    // NCC đã phát hành thành công (có số hóa đơn)
  CANCELLED // đã hủy hóa đơn
  FAILED    // NCC từ chối / lỗi — xem errorMessage
}

/// Vòng đời một job trong hàng đợi bền (shopee_webhook_logs) — dùng chung cho
/// sự kiện webhook Shopee VÀ job đối soát tồn kho (Double-Check).
enum WebhookJobStatus {
  PENDING    // chờ worker xử lý (hoặc chờ đến giờ retry — xem nextRetryAt)
  PROCESSING // worker đang cầm job này
  /// Đã đẩy tồn lên sàn thành công NHƯNG chưa tin — update_stock của Shopee có
  /// thể trả 200 mà dữ liệu trên sàn ghi trễ. Job nằm ở trạng thái này chờ đến
  /// giờ (nextRetryAt) để worker gọi API đọc lại tồn thực tế và so khớp.
  VERIFYING
  SUCCESS    // xử lý xong (job đối soát: tồn sàn ĐÃ khớp với Hubsell)
  FAILED     // đã retry đủ số lần vẫn lỗi — cần người xem (đã bắn cảnh báo)
}

/// Kết quả MỘT lượt đẩy tồn kho lên sàn (bảng đối soát InventorySyncLog).
enum StockSyncStatus {
  SUCCESS
  FAILED
}

/// Vai trò tài khoản — quyết định thấy gì và làm được gì.
enum Role {
  ADMIN     // Chủ shop: toàn quyền, thấy mọi gian hàng và mọi chỉ số tài chính
  SALES     // Nhân viên vận hành: CHỈ các gian hàng được phân công, không thấy giá vốn/lợi nhuận
  WAREHOUSE // Nhân viên kho: thấy đơn của MỌI gian hàng để nhặt/đóng, không thấy tài chính
}

// ---------- BẢNG ----------

/// Người dùng của hệ thống (chủ shop / nhân viên)
model User {
  id           String   @id @default(cuid())
  /// Nullable từ 10/08: TÀI KHOẢN NHÂN VIÊN kiểu "chủ/nhânviên" không cần email
  /// (chủ shop cấp/reset mật khẩu hộ). Chủ shop luôn có email.
  email        String?  @unique
  /// Tên đăng nhập (thay thế được email ở ô login). LƯU LOWERCASE, 3-30 ký tự
  /// [a-z0-9._], CẤM "@" — ô đăng nhập chung phân biệt: có @ = email, không @ =
  /// username. Nullable: user cũ/staff chưa đặt vẫn đăng nhập bằng email.
  username     String?  @unique
  passwordHash String
  fullName     String
  /// Quốc gia ISO 3166-1 alpha-2 (mặc định VN) — nền cho i18n/tiền tệ sau này.
  country      String   @default("VN")
  /// SĐT chuẩn E.164 (vd "+84912345678") — src/phone.ts chuẩn hoá khi đăng ký;
  /// nền cho OTP SMS/WhatsApp sau này. Nullable: user cũ/Google chưa có SĐT.
  phone        String?
  /// Ảnh đại diện dạng data URL base64 (image/jpeg|png|webp, FE đã thu nhỏ
  /// ~256px nên chỉ vài chục KB) — lưu thẳng trong DB, khỏi dựng object storage
  /// riêng cho một tấm ảnh nhỏ. Null = chưa đặt, FE hiện icon mặc định.
  avatar       String?
  /// `sub` Google trả về khi đăng nhập Google — khoá liên kết tài khoản OAuth.
  googleId     String?  @unique
  /// Quên mật khẩu: chỉ lưu SHA-256 CỦA token (lộ DB không lộ link reset),
  /// hạn 30 phút, dùng một lần (reset xong xoá cả hai cột).
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  role         Role     @default(SALES)
  /// Quản trị NỀN TẢNG Hubsell (khác ADMIN của shop): mở khóa khu /admin —
  /// thống kê người dùng đăng ký, nhật ký webhook toàn hệ thống. Không nằm
  /// trong enum Role để khỏi đụng ma trận quyền shop; gán bằng script
  /// scripts/grant-platform-admin.ts, KHÔNG có API nào tự bật được cờ này.
  isPlatformAdmin Boolean @default(false)

  // ── Affiliate Tiếp Thị (referral của CHÍNH Hubsell — khác module /koc-marketing) ──
  /// Số thứ tự người dùng TỰ TĂNG — xương sống của mã giới thiệu có cấu trúc
  /// "HUBSELL<seq>" (vd HUBSELL102): dễ đọc, dễ nhớ, không bao giờ trùng.
  referralSeq  Int     @unique @default(autoincrement())
  /// Mã giới thiệu duy nhất, định dạng "HUBSELL<referralSeq>" — sinh lười ở lần
  /// đầu mở trang Affiliate. Link chia sẻ: https://hubsell.tech/register?ref=<mã>.
  referralCode String? @unique
  /// Ai đã giới thiệu user này — set MỘT LẦN lúc đăng ký (qua ?ref=), không đổi.
  referredById String?
  referredBy   User?   @relation("ReferralTree", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("ReferralTree")

  createdAt    DateTime @default(now())
  /// Lần cuối tài khoản CÓ HOẠT ĐỘNG (request kèm token hợp lệ) — requireAuth
  /// chạm cột này tối đa 1 lần/6 giờ (fire-and-forget, không chặn request).
  /// Nền của chỉ số MAU/WAU trong Báo cáo nhà đầu tư; null = chưa ghi nhận
  /// (dữ liệu chỉ tích lũy từ khi deploy 13/08/2026).
  lastActiveAt DateTime?

  // Nhân viên thuộc về một chủ shop → dùng chung dữ liệu của shop đó.
  // ownerId = null nghĩa là chính user này là chủ shop.
  ownerId String?
  owner   User?   @relation("ShopStaff", fields: [ownerId], references: [id], onDelete: Cascade)
  staff   User[]  @relation("ShopStaff")

  /// Tên đăng nhập NHÂN VIÊN — đăng nhập dạng "<username chủ shop>/<staffUsername>"
  /// (vd "darkman/kho01"). KHÁC cột `username` (không gian tên riêng của chủ shop,
  /// unique toàn cục); staffUsername chỉ unique TRONG một shop — hai shop khác nhau
  /// thoải mái cùng có "kho01". Null với chủ shop và nhân viên cũ đăng nhập email.
  staffUsername String?

  /// Ma trận quyền tính năng của NHÂN VIÊN — mảng KHÓA LÁ từ permission-registry.ts
  /// (vd ["orders","finance.analytics"]). Chỉ có nghĩa khi ownerId != null; ADMIN
  /// (chủ shop) toàn quyền không cần mảng này. Mặc định RỖNG = chưa được cấp gì
  /// (default-deny). Trạng thái quyền CHA suy từ các lá lúc render, không lưu.
  permissions String[] @default([])

  channels          Channel[]
  products          Product[]
  operatingExpenses OperatingExpense[]

  // Phân quyền theo gian hàng — CHỈ có ý nghĩa với vai trò SALES.
  // Không gán gian nào = SALES đó chưa xem được đơn nào (mặc định đóng, an toàn
  // hơn là mở toàn bộ); ADMIN và WAREHOUSE vốn đã thấy mọi gian nên bỏ qua bảng này.
  staffChannels StaffChannel[] @relation("StaffChannels")

  // Trạng thái Trung tâm điều hành (Command Center) — gắn theo chủ shop.
  opsResolvedAlerts OpsResolvedAlert[] @relation("OpsResolvedAlerts")
  opsChatMessages   OpsChatMessage[]   @relation("OpsChatMessages")
  opsActivities     OpsActivity[]      @relation("OpsActivities")
  opsAlerts         OpsAlert[]         @relation("OpsAlerts")
  opsCenterVisit    OpsCenterVisit?    @relation("OpsCenterVisit")

  // Cấu hình hóa đơn điện tử & chữ ký số (Multi-Vendor Adapter).
  invoiceConfigs InvoiceConfig[]

  // Cấu hình Đồng bộ tồn kho đa sàn (switch tự động + tồn an toàn mặc định).
  syncSetting ShopSyncSetting?

  // Module Hóa đơn & Thuế: cấu hình thuế bổ sung + lịch sử phát hành hóa đơn.
  taxSetting  ShopTaxSetting?
  invoiceLogs InvoiceLog[]

  // Hóa đơn ĐẦU VÀO đồng bộ từ MISA meInvoice (dịch vụ Xử lý hóa đơn đầu vào).
  inputInvoices InputInvoice[]

  // Sổ KOC — mạng lưới creator của chủ shop (module /koc-marketing).
  kocPartners KocPartner[]

  // Ví Hubsell & Affiliate Tiếp Thị.
  hubsellWallet      HubsellWallet?
  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]

  // Gói dịch vụ & thuê bao Hubsell (GĐ1 thương mại hóa) — chỉ chủ shop có.
  subscription        Subscription?
  packagePayments     PackagePayment[]
  planUpgradeRequests PlanUpgradeRequest[]

  // Khu điều hành Hubsell (CRM nội bộ + nhật ký thao tác + sổ quỹ).
  careProfile        PlatformCustomerCare?  @relation("CareCustomer")
  careAssignments    PlatformCustomerCare[] @relation("CareAssignee")
  auditActions       PlatformAuditLog[]     @relation("AuditActor")
  ledgerEntries      PlatformLedgerEntry[]  @relation("LedgerCustomer")
  consultAssignments ConsultLead[]          @relation("ConsultLeadAssignee")

  // Tên đăng nhập nhân viên unique THEO TỪNG SHOP, không unique toàn hệ thống —
  // SaaS đa tenant: shop A có "kho01" không được chặn shop B tạo "kho01".
  @@unique([ownerId, staffUsername])
}

/// Kênh bán hàng đã kết nối (Shopee, Lazada, TikTok, Offline)
/// TẦNG 1 — GIAN HÀNG đã kết nối.
/// Một chủ shop có thể có NHIỀU gian hàng trên CÙNG một sàn (Shopee - Shop A,
/// Shopee - Shop B). `channelName` là SÀN, `shopName` mới là gian hàng.
model Channel {
  id          String      @id @default(cuid())
  userId      String
  channelName ChannelName // sàn: SHOPEE / LAZADA / TIKTOK / OFFLINE
  /// Tên gian hàng do chủ shop đặt — thứ phân biệt hai shop trên cùng một sàn.
  /// Mọi báo cáo phải hiển thị tên này, đừng gom theo channelName không thôi.
  shopName    String
  /// Id gian hàng bên phía sàn, để dành cho khi có tích hợp API thật
  externalShopId String?
  /// Tên gian hàng phía sàn trả về (khác shopName do chủ shop tự đặt để hiển thị)
  externalShopName String?
  /// access_token của sàn (TikTok Shop) — dùng để gọi API. Giai đoạn giả lập là token ảo.
  apiToken    String?
  /// refresh_token để làm mới access_token khi hết hạn (OAuth2 của sàn)
  refreshToken String?
  /// Thời điểm access_token hết hạn — trước khi gọi API phải kiểm tra & refresh nếu cần
  accessTokenExpireAt  DateTime?
  /// Thời điểm refresh_token hết hạn — quá hạn thì buộc chủ shop uỷ quyền lại
  refreshTokenExpireAt DateTime?
  /// shop_cipher của TikTok Shop — BẮT BUỘC gửi kèm mọi request API 202309 trở đi
  shopCipher  String?
  status      String      @default("ACTIVE") // ví dụ: ACTIVE, DISCONNECTED
  /// Thời điểm chuyển sang DISCONNECTED (ngắt tay / hết hạn ủy quyền / sàn thu
  /// hồi) — null khi ACTIVE. Bảng Phân bổ dòng tiền ẨN gian đã ngắt quá 30 ngày
  /// (giữ 30 ngày cho tiền đang giao/chờ đối soát về nốt).
  disconnectedAt DateTime?

  // ── Bookkeeping của worker order-auto-sync (nguồn cho cảnh báo "sàn trễ
  // đồng bộ" trên Trung tâm điều hành) ──
  /// Lần đồng bộ ĐƠN thành công gần nhất của worker (null = chưa từng chạy).
  lastSyncAt    DateTime?
  /// Lỗi của lần đồng bộ đơn gần nhất (null = lần gần nhất thành công).
  lastSyncError String?
  /// Số NHỊP đồng bộ đơn lỗi LIÊN TIẾP — thành công là reset về 0.
  syncFailCount Int         @default(0)

  // ── Số dư VÍ SÀN THẬT (bảng Phân bổ dòng tiền) ──
  /// Số dư ví hiện tại sàn báo (Shopee: current_balance của giao dịch ví mới
  /// nhất). null = sàn không có ví (Lazada/TikTok/Offline) hoặc chưa sync được.
  walletBalance         Decimal?  @db.Decimal(14, 2)
  /// Thời điểm đồng bộ số dư ví gần nhất — hiển thị "cập nhật lúc" trên bảng.
  walletBalanceSyncedAt DateTime?

  // % phí sàn mặc định dùng để TẠM TÍNH lợi nhuận khi đơn chưa được quyết toán.
  // VD: 0.12 = 12%. Có thể chỉnh riêng cho từng gian hàng.
  feeRate     Decimal     @default(0) @db.Decimal(5, 4)
  createdAt   DateTime    @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  channelProducts ChannelProduct[]
  staffAccess     StaffChannel[]
  invoiceConfigs  InvoiceConfig[] // api_key hóa đơn riêng của gian hàng này
  walletWithdrawals WalletWithdrawal[] // lệnh rút tiền ví sàn → ngân hàng
  operatingTxns   OperatingExpense[] // khoản thu/chi vận hành gắn nguồn tiền vào gian này
  adSpends        AdSpend[] // chi phí quảng cáo sàn theo ngày (sync từ Ads API)
  adsCampaigns    AdsCampaign[] // chiến dịch quảng cáo sản phẩm (sync từ Ads API)
  adsAssistantConfig AdsAssistantConfig? // luật Trợ lý quảng cáo riêng của gian
  adsActionLogs   AdsActionLog[] // sổ hành động của Trợ lý (GĐ3)
  inventorySyncLogs   InventorySyncLog[]   // nhật ký từng lượt đẩy tồn lên sàn
  inventorySyncAlerts InventorySyncAlert[] // cảnh báo lệch tồn chưa xử lý
  stockPushJobs       StockPushJob[]       // hàng đợi đẩy tồn khả dụng lên gian này
  deliveryTrackingTasks DeliveryTrackingTask[] // hàng đợi hỏi tracking cứu đơn giao thất bại

  @@unique([userId, channelName, shopName]) // không trùng tên gian trong cùng sàn
  /// KHÓA CHỐNG TRÙNG SHOP: một user chỉ có MỘT bản ghi cho mỗi shop_id trên mỗi
  /// sàn — callback OAuth upsert theo khóa này nên bấm "Liên kết" bao nhiêu lần
  /// cũng không đẻ ra gian trùng (Postgres coi NULL khác nhau nên gian OFFLINE /
  /// mock không có externalShopId vẫn tạo thoải mái).
  @@unique([userId, channelName, externalShopId])
  @@index([userId])
}

/// CHI PHÍ QUẢNG CÁO SÀN theo NGÀY của một gian hàng — sync READ-ONLY từ Ads
/// API của sàn (Shopee: get_all_cpc_ads_daily_performance, expense = tiền đã
/// tiêu). Idempotent theo (channelId, date): sàn có thể cập nhật lại chi tiêu
/// trong ngày nên chạy lặp GHI ĐÈ cùng bộ số. Báo cáo dòng tiền cộng vào cột
/// Chi phí — tách khỏi OperatingExpense (nhập tay) để không lẫn hai nguồn.
model AdSpend {
  id        String   @id @default(cuid())
  channelId String
  date      DateTime @db.Date // ngày chi tiêu (theo múi giờ sàn)
  amount    Decimal  @db.Decimal(12, 2) // tiền ads đã tiêu trong ngày
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([channelId])
}

/// CHIẾN DỊCH QUẢNG CÁO SẢN PHẨM của một gian hàng — sync READ-ONLY từ Ads API
/// (Shopee: get_product_level_campaign_id_list + setting_info). Trợ lý quảng
/// cáo đọc bảng này để hiển thị/đánh giá; GIAI ĐOẠN 1 tuyệt đối không ghi
/// ngược lên sàn. campaignId giữ dạng String (id sàn có thể vượt Int32 — cùng
/// quy ước với ChannelProduct.externalId).
model AdsCampaign {
  id            String    @id @default(cuid())
  channelId     String
  campaignId    String // campaign_id bên sàn
  adType        String    @default("") // auto | manual
  name          String    @default("") // ad_name — campaign auto có thể trống
  status        String    @default("") // ongoing | scheduled | ended | paused | deleted | closed
  placement     String    @default("") // search | discovery | all
  biddingMethod String    @default("") // auto | manual
  budget        Decimal   @default(0) @db.Decimal(14, 2) // ngân sách campaign, 0 = không giới hạn
  roasTarget    Decimal?  @db.Decimal(8, 2) // mục tiêu ROAS (auto bidding); NULL = không đặt
  startTime     DateTime? // campaign_duration.start_time
  endTime       DateTime? // campaign_duration.end_time; NULL = không hẹn ngày tắt
  /// item_id_list của campaign, nối bằng dấu phẩy ("8027...,8031...") — dùng để
  /// map về ChannelProduct (externalId = item hoặc item-model) khi tính ROAS hòa vốn.
  itemIds       String    @default("")

  /// QUYẾT ĐỊNH CỦA CHỦ SHOP với verdict Trợ lý (GĐ2 — Trợ lý chỉ đề xuất):
  /// "" = chưa quyết; HANDLED = đã xử lý trên Seller Center; WATCHING = theo
  /// dõi thêm (ẩn cảnh báo, tiếp tục quan sát); IGNORED = bỏ qua cảnh báo.
  /// Kèm verdict TẠI THỜI ĐIỂM QUYẾT — verdict đổi loại thì cảnh báo hiện lại.
  assistantDecision        String    @default("")
  assistantDecisionVerdict String    @default("")
  assistantDecisionAt      DateTime?

  lastSyncedAt  DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  channel    Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  dailyPerf  AdsCampaignDailyPerf[]
  actionLogs AdsActionLog[]

  @@unique([channelId, campaignId])
  @@index([channelId])
}

/// HIỆU SUẤT THEO NGÀY của một chiến dịch quảng cáo — sync READ-ONLY từ
/// get_product_campaign_daily_performance. Idempotent theo (campaign, ngày):
/// sàn cập nhật lại số trong ngày thì chạy lặp ghi đè. Cặp direct/broad theo
/// đúng định nghĩa Shopee: direct = đơn của chính SP chạy ads, broad = mọi đơn
/// của shop trong 7 ngày sau click.
model AdsCampaignDailyPerf {
  id            String   @id @default(cuid())
  adsCampaignId String
  date          DateTime @db.Date // ngày hiệu suất (múi giờ sàn)
  impression    Int      @default(0)
  clicks        Int      @default(0)
  expense       Decimal  @default(0) @db.Decimal(14, 2) // tiền ads đã tiêu trong ngày
  broadOrder    Int      @default(0)
  broadGmv      Decimal  @default(0) @db.Decimal(14, 2)
  directOrder   Int      @default(0)
  directGmv     Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt     DateTime @updatedAt

  adsCampaign AdsCampaign @relation(fields: [adsCampaignId], references: [id], onDelete: Cascade)

  @@unique([adsCampaignId, date])
  @@index([adsCampaignId])
}

/// LUẬT TRỢ LÝ QUẢNG CÁO riêng của một gian (GĐ2). Cấu trúc JSON xem
/// ShopeeAssistantConfig trong integrations/shopee/ads-assistant-rules.ts —
/// backend luôn vá bản lưu qua normalize (schema cũ không vỡ khi thêm luật).
/// Chưa có dòng = dùng bộ mặc định.
model AdsAssistantConfig {
  id        String   @id @default(cuid())
  channelId String   @unique
  config    Json
  updatedAt DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

/// SỔ HÀNH ĐỘNG của Trợ lý quảng cáo (GĐ3 — tự thực thi). Mỗi dòng = một lần
/// Trợ lý ĐỊNH (dry_run) hoặc ĐÃ (live) thao tác lên sàn. Ba vai trò:
///   1. Kiểm toán: chủ shop truy lại vì sao campaign bị tạm dừng, căn cứ nào.
///   2. Idempotency: referenceId unique "pause-{campaignRowId}-{yyyy-mm-dd}"
///      → 1 hành động/campaign/ngày, sweep chạy lặp không bắn trùng.
///   3. Quota: đếm hành động/ngày/gian để tôn trọng giới hạn sàn
///      (~10 thao tác/sản phẩm/ngày — vượt là Shopee khóa sửa item).
model AdsActionLog {
  id            String   @id @default(cuid())
  channelId     String
  adsCampaignId String
  action        String // "pause" — v1 chỉ tạm dừng (cắt lỗ), chưa đụng budget/bid
  mode          String // dry_run (diễn tập, không gọi sàn) | live
  verdict       String // verdict kích hoạt: pause_now | spike
  reasons       String   @default("") // căn cứ tại thời điểm hành động, nối "\n"
  referenceId   String   @unique // chống double-fire; mode live gửi kèm lên sàn
  status        String // PLANNED (dry_run) | SUCCESS | FAILED
  error         String? // nguyên văn lỗi sàn — tư liệu học enum edit_action
  createdAt     DateTime @default(now())

  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  adsCampaign AdsCampaign @relation(fields: [adsCampaignId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([adsCampaignId, createdAt])
}

/// LỆNH RÚT TIỀN từ VÍ SÀN về NGÂN HÀNG.
///
/// Bảng dòng tiền tách "Tiền trên Ví sàn" (đã quyết toán, còn nằm ở ví sàn) khỏi
/// "Tiền về Ngân hàng" (đã rút về bank thật). Mỗi bản ghi ở đây = một lần tiền
/// rời ví sàn: TRỪ khỏi cột Ví sàn, CỘNG vào cột Ngân hàng.
///
/// Hai nguồn ghi nhận:
///  - SYNC   : đọc từ lịch sử ví của sàn (Shopee get_wallet_transaction_list),
///             read-only, idempotent theo externalTxnId.
///  - MANUAL : kế toán tự xác nhận đã rút (khi muốn khớp trước lúc sàn đồng bộ).
model WalletWithdrawal {
  id              String           @id @default(cuid())
  channelId       String
  amount          Decimal          @db.Decimal(12, 2) // số tiền rút (dương)
  status          String           @default("SUCCESS") // SUCCESS | PENDING | FAILED
  source          WithdrawalSource @default(MANUAL)
  /// Id giao dịch phía sàn — khoá idempotent khi đồng bộ. NULL cho bản ghi nhập tay.
  externalTxnId   String?
  transactionTime DateTime // thời điểm rút (sàn báo, hoặc kế toán nhập)
  note            String?
  createdAt       DateTime         @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Đồng bộ một giao dịch sàn chỉ ghi 1 lần. Postgres coi mỗi NULL là khác nhau
  /// nên nhiều bản ghi MANUAL (externalTxnId = NULL) vẫn chèn được bình thường.
  @@unique([channelId, externalTxnId])
  @@index([channelId])
}

enum WithdrawalSource {
  MANUAL // kế toán tự xác nhận
  SYNC   // đọc từ API ví của sàn
}

/// Phân quyền gian hàng cho nhân viên: nhân viên (staffId) được gán vào kênh
/// (channelId). Sự TỒN TẠI của bản ghi = nhân viên được phân công gian này (dùng
/// để lọc tầm nhìn dữ liệu ở channel-filter). Bốn cờ bên dưới tinh chỉnh nhân
/// viên được làm GÌ trong gian đó — bật/tắt độc lập từng chức năng.
///
/// Mặc định `true` để dữ liệu cũ (đã phân công trước khi có phân quyền chi tiết)
/// giữ nguyên toàn quyền như trước, không bị mất quyền âm thầm sau khi nâng cấp.
model StaffChannel {
  id        String @id @default(cuid())
  staffId   String
  channelId String

  // 10/08: 4 cờ canFinance/canWarehouse/canAds/canOrders ĐÃ GỠ — chúng được lưu
  // nhưng chưa từng được API nào kiểm tra (cờ chết). Quyền TÍNH NĂNG giờ nằm ở
  // User.permissions (cây phân quyền); bảng này chỉ còn một việc: PHẠM VI GIAN
  // HÀNG — nhân viên thấy dữ liệu của những gian nào.

  staff   User    @relation("StaffChannels", fields: [staffId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([staffId, channelId])
  @@index([staffId])
}

// ---------- TRUNG TÂM ĐIỀU HÀNH (Command Center) ----------
//
// Cảnh báo gốc vẫn được SINH Ở FRONTEND (dữ liệu mock/quét theo thời gian thực),
// nên 3 bảng dưới đây KHÔNG lưu cảnh báo — chỉ ghi nhận những THAY ĐỔI do người
// dùng tạo ra để không mất khi F5:
//   1) cảnh báo nào đã được đánh dấu "Đã xử lý"
//   2) các tin nhắn thảo luận mới theo từng cảnh báo
//   3) các sự kiện nhật ký vận hành mới phát sinh
// Tất cả gắn theo `ownerId` (chủ shop) — mỗi shop một không gian riêng.

/// Cảnh báo đã được đánh dấu "Đã xử lý". Có bản ghi = đã xử lý (làm mờ thẻ).
model OpsResolvedAlert {
  id         String   @id @default(cuid())
  ownerId    String
  /// id cảnh báo phía frontend (VD "al-inv-grp-1", "al-fin-1").
  alertId    String
  /// Vai trò vận hành đã tick (ADMIN/KHO/KE_TOAN/MARKETING) — lưu dạng chuỗi vì
  /// đây là vai trò riêng của Command Center, không phải enum Role đăng nhập.
  byRole     String
  resolvedAt DateTime @default(now())

  owner User @relation("OpsResolvedAlerts", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, alertId]) // mỗi cảnh báo chỉ một bản ghi đã-xử-lý cho mỗi shop
  @@index([ownerId])
}

/// Một tin nhắn thảo luận gắn với một cảnh báo cụ thể.
model OpsChatMessage {
  id        String   @id @default(cuid())
  ownerId   String
  alertId   String
  author    String
  /// Vai trò vận hành người gửi (chuỗi, xem ghi chú ở OpsResolvedAlert).
  role      String
  /// Nội dung tin ở dạng JSON của ChatBody: text | table | image.
  body      String
  createdAt DateTime @default(now())

  owner User @relation("OpsChatMessages", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, alertId])
}

/// Một dòng nhật ký vận hành.
model OpsActivity {
  id        String   @id @default(cuid())
  ownerId   String
  tag       String // inventory | finance | channel | ads
  message   String
  createdAt DateTime @default(now())

  owner User @relation("OpsActivities", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

/// CẢNH BÁO VẬN HÀNH THẬT — bảng HỢP NHẤT cho mọi detector của Trung tâm điều
/// hành (cháy hàng, gian mất kết nối, đơn lỗ, chênh phí ship…). Mỗi điều kiện
/// đang tồn tại chỉ có MỘT bản ghi (khoá ownerId × type × dedupeKey); detector
/// upsert theo khoá đó và TỰ ĐÓNG (AUTO_CLOSED) khi điều kiện biến mất.
model OpsAlert {
  id        String @id @default(cuid())
  ownerId   String
  /// Loại detector: stockout | channel-disconnected | loss-orders |
  /// shipping-fee-diff | channel-sync-stalled | ads-spike
  type      String
  /// Khoá chống trùng trong phạm vi (owner × type), VD id gian hàng.
  dedupeKey String
  tag       String // inventory | finance | channel | ads | tax
  severity  String // high | medium | low
  title     String
  summary   String
  /// JSON ActionParams cho nút xử lý phía frontend (VD {kind:"navigate",href}).
  payload   String?

  /// OPEN → đang hiện; RESOLVED → chủ shop tick tay (ẩn cho tới khi điều kiện
  /// hết hẳn rồi tái phát); AUTO_CLOSED → detector xác nhận điều kiện đã hết.
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  owner User @relation("OpsAlerts", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, type, dedupeKey])
  @@index([ownerId, status])
}

/// Lần mở Trung tâm điều hành gần nhất của mỗi chủ shop — mốc để gắn nhãn "Mới"
/// cho cảnh báo phát sinh sau lần xem trước (không dùng mốc cứng 24h).
model OpsCenterVisit {
  ownerId    String   @id
  lastSeenAt DateTime @default(now())

  owner User @relation("OpsCenterVisit", fields: [ownerId], references: [id], onDelete: Cascade)
}

// ---------- HÓA ĐƠN ĐIỆN TỬ & CHỮ KÝ SỐ (Multi-Vendor Adapter) ----------
//
// Cấu hình kết nối tới các NCC hóa đơn (MISA/Viettel/Bkav/Custom) để chuẩn bị
// tích hợp API thương mại. Tách bảng riêng để module này đóng gói độc lập, không
// làm phình model Product/Channel.
//
// PHẠM VI theo `channelId`:
//   - channelId = NULL  → cấu hình MẶC ĐỊNH cấp shop (chọn NCC, phương thức ký,
//     partnerCode của Hubsell, thông tin đăng nhập chung).
//   - channelId != NULL → override cho MỘT gian hàng, chủ yếu giữ `apiKey` riêng
//     của gian đó (phục vụ đối soát hoa hồng theo từng shop sau này).

/// Cấu hình hóa đơn điện tử của shop (và api_key riêng theo gian hàng).
///
/// GẮN THEO ownerId (chủ shop) chứ KHÔNG theo gian hàng: một chủ shop = một
/// pháp nhân = một MST, dù bán trên bao nhiêu gian (NĐ 123/2020 — hóa đơn phát
/// hành theo pháp nhân, không theo kênh bán). Nhiều pháp nhân → nhiều tài
/// khoản Hubsell. Dòng channelId != null chỉ giữ apiKey riêng của gian.
model InvoiceConfig {
  id        String  @id @default(cuid())
  ownerId   String
  channelId String? // NULL = cấu hình cấp shop; có giá trị = cấu hình riêng 1 gian

  // ---- (1) Thông tin PHÁP NHÂN & THUẾ — bắt buộc để phát hành HĐĐT hợp lệ
  //      theo NĐ 123/2020 (hóa đơn phải mang MST + tên + địa chỉ người bán).
  taxCode        String? // MST người bán: 10 số hoặc 10-3 số (chi nhánh)
  companyName    String? // tên pháp nhân ĐÚNG đăng ký kinh doanh (in lên hóa đơn)
  companyAddress String? // địa chỉ trụ sở theo ĐKKD

  // ---- (2) Kết nối NCC hóa đơn (meInvoice khi provider = MISA)
  provider     String  @default("MISA") // MISA | VIETTEL | BKAV | CUSTOM
  partnerCode  String? // Mã đại lý ISV của Hubsell với NCC (isvCode) — đối soát hoa hồng
  clientId     String? // Mã định danh (Client ID) do NCC cấp
  secretKey    String? // Khóa bảo mật — nhạy cảm, chỉ trả về dạng che khi đọc
  apiKey       String? // API key RIÊNG cho từng gian hàng — nhạy cảm, trả về che
  customApiUrl String? // Endpoint khi provider = CUSTOM
  /// MẪU SỐ hóa đơn theo TT 78/2021 (VD "1" = HĐ GTGT) — phải khớp mẫu đã
  /// đăng ký với CQT trên meInvoice, sai là NCC từ chối phát hành.
  invoicePattern String?
  /// KÝ HIỆU hóa đơn theo TT 78/2021 (VD "C26TAA") — meInvoice tra đúng ký
  /// hiệu này để cấp số; không có/không khớp là lỗi "ký hiệu không tồn tại".
  invoiceSeries String?
  /// TÀI KHOẢN meInvoice CỦA SHOP (23/08 — kiến trúc multi-tenant): đăng nhập
  /// lấy token bằng bộ {MST + username + password} của CHÍNH shop, nên hóa đơn
  /// phát hành mang pháp nhân của shop. Client ID/Secret là khóa app Hubsell
  /// dùng chung (env) — khách không phải đăng ký gì trên developer.misa.vn.
  meinvoiceUsername String?
  meinvoicePassword String? // nhạy cảm — chỉ trả về dạng che khi đọc

  // ---- (3) Chữ ký số — USB_TOKEN (thủ công) | ESIGN_CLOUD (MISA eSign từ xa,
  //      ký nền tự động không cần cắm USB)
  signMethod String @default("USB_TOKEN")
  /// Bộ khóa tích hợp MISA eSign của shop (header x-clientId / x-clientKey).
  esignClientId  String?
  esignSecretKey String? // nhạy cảm — chỉ trả dạng che
  /// Tài khoản eSign để login-api lấy token ký nền.
  esignUsername String?
  esignPassword String? // nhạy cảm — chỉ trả dạng che
  /// SERIAL CHỨNG THƯ SỐ dùng ký (chọn đúng cert khi tài khoản có nhiều) —
  /// map certAlias trong yêu cầu ký Signing/hash.
  certSerial String?

  // ---- (4) meInvoice POS — HÓA ĐƠN TỪ MÁY TÍNH TIỀN (HKD/bán lẻ).
  //      CQT cấp DẢI MÃ trước cho máy đã đăng ký → phát hành tức thì tại máy,
  //      KHÔNG cần eSign ký từng đơn (miễn ký số lẻ theo NĐ 123 Đ.11; dữ liệu
  //      chuyển CQT theo bảng tổng hợp). Bộ khóa API RIÊNG với meInvoice chuẩn.
  /// NCC luồng máy tính tiền — CHỌN RIÊNG với provider kê khai (shop có thể
  /// kê khai qua MISA nhưng POS qua NCC khác). Cùng bộ giá trị MISA|VIETTEL|VNPT|BKAV.
  posProvider  String  @default("MISA")
  posClientId  String?
  posSecretKey String? // nhạy cảm — chỉ trả dạng che
  /// Dải mã CQT cấp sẵn cho máy tính tiền.
  posCodePrefix String?
  /// Mã máy tính tiền đã đăng ký với CQT.
  posMachineId String?
  /// Ký hiệu HĐ máy tính tiền theo TT 78/2021 — ký tự thứ 4 BẮT BUỘC là M
  /// (VD "C26MAA"); khác ký hiệu kê khai (invoiceSeries).
  posSeries String?

  /// Luồng phát hành dùng khi xuất hóa đơn từ đơn hàng (tab đang cấu hình chỉ
  /// là giao diện — cờ này mới quyết định gọi bộ API nào).
  defaultInvoiceType InvoiceType @default(STANDARD)

  /// TỰ ĐỘNG PHÁT HÀNH (23/08, học theo Salework): worker quét định kỳ, tự
  /// xuất hóa đơn cho đơn ĐÃ GIAO THÀNH CÔNG + ĐÃ ĐỐI SOÁT chưa có hóa đơn.
  /// Mặc định TẮT — chủ shop chủ động bật ở trang Kết nối & Xuất hóa đơn.
  autoIssueEnabled Boolean @default(false)
  /// TỰ ĐỘNG ĐIỀU CHỈNH (24/08, TT 91/2026 Đ.10 k.5c): đơn hoàn NHẬP KHO mà đã
  /// có hóa đơn ISSUED → tự lập hóa đơn điều chỉnh GIẢM toàn bộ (số âm).
  /// Mặc định TẮT — bật cạnh công tắc Tự động phát hành.
  autoAdjustEnabled Boolean @default(false)

  /// % thuế suất GTGT MẶC ĐỊNH của shop (24/08 — anh Trung chốt: kho vật lý chỉ
  /// quản số lượng, không bắt liên kết SKU để có thuế suất). Dòng hàng không có
  /// Product.vatRate riêng sẽ dùng mức này khi lên hóa đơn: 0 / 5 / 8 / 10.
  defaultVatRate Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([ownerId, channelId]) // 1 cấu hình cho mỗi (shop, gian) — NULL là cấu hình mặc định
  @@index([ownerId])
}

/// CẤU HÌNH THUẾ của một shop (trang "Thuế bổ sung") — đúng 1 bản ghi/chủ shop.
///
/// Bảng TINH GỌN chỉ giữ lựa chọn của người dùng: % thuế bổ sung + cơ sở tính
/// + kỳ áp dụng. THUẾ SÀN TMĐT 1.5% do luật ấn định KHÔNG lưu ở đây — nó là
/// hằng số PLATFORM_TAX_RATE trong tax-config.ts (đổi luật thì sửa một chỗ đó).
///
/// Tỷ lệ lưu dạng PHÂN SỐ như Channel.feeRate: 0.2 = 20%.
model ShopTaxSetting {
  id      String @id @default(cuid())
  ownerId String @unique

  /// % thuế ước tính bổ sung. 0 = không trích thêm.
  customTaxRate Decimal @default(0) @db.Decimal(5, 4)

  /// Nhân % vào LỢI NHUẬN hay DOANH THU — xem enum TaxCalculationBase.
  calculationBase TaxCalculationBase @default(PROFIT)

  /// Kỳ áp dụng % bổ sung (Tháng/Quý/Năm) — báo cáo dùng để chú thích và
  /// khớp với bộ lọc thời gian đang chọn.
  filterPeriod TaxFilterPeriod @default(MONTH)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

/// NHẬT KÝ HÓA ĐƠN ĐIỆN TỬ — mỗi bản ghi = một lần gọi NCC phát hành/hủy hóa
/// đơn cho một đơn hàng (trang "Lịch sử & Báo cáo thuế" đối soát trên bảng này).
///
/// Giữ orderCode TÁCH RIÊNG khỏi quan hệ orderId: đơn có thể bị xóa theo kênh
/// (Cascade) nhưng hóa đơn đã phát hành là chứng từ pháp lý — log phải còn
/// nguyên mã đơn để tra soát với cơ quan thuế.
model InvoiceLog {
  id      String @id @default(cuid())
  ownerId String
  orderId String? // SetNull khi đơn bị xóa — log vẫn giữ nguyên orderCode

  orderCode String // mã đơn hàng (bản sao bền, không mất theo đơn)
  provider  String // NCC phát hành: MISA | BKAV | VIETTEL | VNPT | CUSTOM

  /// Số hóa đơn điện tử NCC cấp (VD "C25TAA-00001234"). NULL khi chưa phát hành xong.
  invoiceNo String?
  /// Mã giao dịch phía NCC — dùng để checkStatus/cancelInvoice sau này.
  transactionId String?
  /// Ký hiệu hóa đơn LÚC PHÁT HÀNH (VD "1K26TYY") — cần để tham chiếu hóa đơn
  /// gốc khi lập hóa đơn điều chỉnh (shop có thể đổi ký hiệu trong config sau).
  invoiceSeries String?
  /// Snapshot InvoiceLine[] đã gửi NCC — hóa đơn điều chỉnh ghi ÂM đúng số ĐÃ
  /// XUẤT (không dựng lại từ đơn kẻo lệch khi thuế suất/voucher đổi sau này).
  lines Json?
  /// Khác NULL = đây là HÓA ĐƠN ĐIỀU CHỈNH cho InvoiceLog gốc có id này
  /// (totalAmount/vatAmount khi đó mang số ÂM — báo cáo cộng dồn tự trừ).
  adjustmentForLogId String?

  status InvoiceLogStatus @default(PENDING)

  totalAmount Decimal @default(0) @db.Decimal(12, 2) // tổng tiền trên hóa đơn
  vatAmount   Decimal @default(0) @db.Decimal(12, 2) // tiền thuế GTGT đầu ra trên hóa đơn
  /// Số tiền thuế sàn TMĐT đã TRÍCH HỘ cho đơn này (1.5% doanh thu gốc) —
  /// nguồn số liệu cột "Thuế sàn trích hộ" của báo cáo đối soát.
  platformTaxWithheld Decimal @default(0) @db.Decimal(12, 2)

  errorMessage String? // lý do khi status = FAILED
  issuedAt     DateTime? // thời điểm NCC phát hành thành công

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  statusHistory InvoiceStatusHistory[] // audit log — mỗi lần đổi trạng thái một dòng

  @@index([ownerId, createdAt])
  @@index([orderId])
  // Webhook MISA tra hóa đơn theo mã giao dịch NCC — cần index để worker không quét bảng.
  @@index([transactionId])
  // Tra "hóa đơn gốc này đã có điều chỉnh chưa" khi lập/hiển thị.
  @@index([adjustmentForLogId])
}

/// HÓA ĐƠN ĐẦU VÀO đồng bộ từ MISA meInvoice (dịch vụ "Xử lý hóa đơn đầu vào"
/// — nội bộ MISA gọi là Inbot). Mỗi dòng = một hóa đơn nhà cung cấp xuất CHO
/// shop, kéo về bằng POLLING API `/invoices/v2/modified` (Inbot không có
/// webhook — xem misa-inbot.ts). Khoá idempotency (ownerId, misaInvoiceId):
/// polling trùng kỳ chỉ upsert, không nhân bản.
///
/// Trường nghiệp vụ map "best effort" từ payload PascalCase của MISA;
/// `rawPayload` giữ NGUYÊN VĂN JSON để đối chiếu/bổ sung cột về sau mà không
/// phải kéo lại từ MISA — đừng bỏ cột này.
model InputInvoice {
  id      String @id @default(cuid())
  ownerId String

  /// ID hóa đơn phía MISA (InvoiceID) — khoá tra cứu chi tiết + idempotency.
  misaInvoiceId String

  invoiceNo     String? // số hóa đơn (VD "00001234")
  invoiceSerial String? // ký hiệu (VD "1C26TAA")
  sellerTaxCode String? // MST nhà cung cấp xuất hóa đơn
  sellerName    String?
  invoiceDate   DateTime?
  totalAmount   Decimal @default(0) @db.Decimal(14, 2) // tổng thanh toán trên hóa đơn
  vatAmount     Decimal @default(0) @db.Decimal(14, 2) // tiền thuế GTGT đầu VÀO
  /// Trạng thái NGUYÊN VĂN MISA trả (chưa chuẩn hoá enum — đợi thấy đủ giá trị
  /// thật từ sandbox rồi mới chốt bộ trạng thái).
  statusRaw String?
  /// JSON nguyên văn (stringify) bản ghi MISA trả về lần đồng bộ gần nhất.
  rawPayload String

  syncedAt  DateTime @default(now()) // lần đồng bộ gần nhất chạm vào dòng này
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, misaInvoiceId])
  @@index([ownerId, invoiceDate])
  @@map("input_invoices")
}

/// Sản phẩm trong kho
model Product {
  id              String   @id @default(cuid())
  userId          String
  skuCode         String
  productName     String
  costPrice       Decimal  @default(0) @db.Decimal(12, 2) // giá vốn (cấu hình ở trang Cấu hình Giá vốn)
  sellingPrice    Decimal  @default(0) @db.Decimal(12, 2) // giá bán
  quantityInStock Int      @default(0)

  /// Số lượng đang bị GIỮ (hold) bởi các đơn sàn chưa chốt — xem Order.stockHeldAt.
  /// Tồn KHẢ DỤNG (đẩy lên sàn / hiển thị) = quantityInStock − holdQuantity.
  /// KHÔNG trừ thẳng quantityInStock vì hàng vẫn nằm trong kho vật lý.
  holdQuantity    Int      @default(0)

  /// TỒN AN TOÀN riêng của SKU này — số lượng giữ lại KHÔNG bán trên sàn (đệm
  /// chống bán vượt khi nhiều sàn nổ đơn sát nhau). NULL = dùng số mặc định
  /// toàn shop (ShopSyncSetting.safetyStockDefault). Tồn đẩy lên sàn =
  /// max(0, quantityInStock − holdQuantity − safetyStock).
  safetyStock     Int?
  imageUrl        String? // ảnh sản phẩm (tuỳ chọn)

  // ── Thuế & Hóa đơn điện tử (module đang dựng khung — GIỮ CHỖ) ──
  // Tên sản phẩm in trên hóa đơn có thể khác tên bán hàng (theo danh mục hàng hóa).
  taxName String?
  // % thuế suất GTGT đầu ra của SKU: 0 / 5 / 8 / 10. Lưu tĩnh khi user cấu hình,
  // module hóa đơn/đối soát thuế sau này sẽ đọc để tính VAT đầu ra.
  vatRate Int @default(0)

  // ── Thông số vật lý cho Trợ lý vận hành (AI CSKH) ──
  // Đặt ở Product (kho vật lý) chứ KHÔNG phải ChannelProduct: chất liệu/size là
  // thuộc tính của món hàng, dùng chung cho mọi sàn. AI Copilot nạp các trường
  // này vào ngữ cảnh để tư vấn size/chất liệu/bảo quản (xem copilot-engine.ts).
  /// Chất liệu — vd "100% cotton 2 chiều, 250gsm".
  material String?
  /// Hướng dẫn bảo quản — vd "Giặt máy nước lạnh, lộn trái khi giặt".
  careInstructions String?
  /// Bảng quy đổi size JSON: [{"size":"M","heightCm":[158,168],"weightKg":[52,62]}].
  /// Sản phẩm không mặc để null/[] — AI tự bỏ qua tư vấn size.
  sizeChart Json?

  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]
  channelProducts ChannelProduct[]
  orderItems    OrderItem[]
  kocSamples    KocSampleShipment[] // phiếu hàng mẫu KOC xuất từ SKU này

  @@unique([userId, skuCode]) // mỗi user không trùng mã SKU
  @@index([userId])
}

/// Đơn hàng thuộc về một kênh bán
model Order {
  id             String   @id @default(cuid())
  channelId      String
  orderCode      String
  customerName   String
  // Số điện thoại khách — dùng để tra cứu nhanh khi khách gọi hỏi đơn.
  // Cho phép trống vì đơn cũ đồng bộ về trước đây không có trường này.
  customerPhone  String?
  totalAmount    Decimal  @default(0) @db.Decimal(12, 2)

  // ===== VẬN CHUYỂN =====
  // Đơn vị vận chuyển (SPX, GHTK, J&T…) và mã vận đơn để in phiếu giao hàng.
  // Trống = sàn chưa gán đơn vị vận chuyển cho đơn này.
  carrier      Carrier?
  /// Tên hãng NGUYÊN VĂN sàn trả ("SPX Instant", "AhaMove", "Hỏa Tốc"…) —
  /// nguồn nhận diện đơn HỎA TỐC (enum Carrier đã gộp mất sắc thái này).
  shippingCarrierName String?
  trackingCode String?
  // Đã bấm "Xác nhận chuẩn bị hàng" chưa — mốc giữa lúc đơn về và lúc bàn giao
  // cho shipper, để chủ shop biết đơn nào đã đóng gói xong mà chưa ai đến lấy.
  packedAt DateTime?
  // Đã in phiếu giao hàng chưa. Đây là chốt chặn IN TRÙNG: nhiều nhân viên
  // cùng soát đơn thì người sau nhìn vào biết ngay phiếu đã được in, khỏi in
  // lại và gói lại đơn người khác đang làm.
  labelPrintedAt DateTime?

  // Số DÒNG HÀNG của đơn (đếm OrderItem, không phải tổng số lượng).
  // Lưu sẵn ở đây thay vì đếm quan hệ mỗi lần truy vấn, vì Prisma không lọc
  // được theo số lượng bản ghi con — mà kho cần lọc "đơn 1 sản phẩm" (dễ đóng,
  // làm trước) tách khỏi "đơn nhiều sản phẩm" (khó đóng, làm sau).
  // An toàn để lưu trùng: đơn ở Hubsell không sửa được dòng hàng sau khi tạo.
  itemCount Int @default(0)

  // ===== HÀNG HOÀN VỀ KHO (RTS) =====
  returnStatus ReturnStatus @default(NONE)
  returnNote   String? // ghi chú tình trạng kiện hàng khi nhận (vỡ, thiếu, bị tráo…)
  returnedAt   DateTime? // thời điểm kho xác nhận đã cầm hàng trên tay

  /// Mã vận đơn CHIỀU HOÀN (kiện khách gửi trả về kho). Shopee cấp tracking
  /// RIÊNG cho chiều ngược (tracking_number trong Returns API) — khác hẳn
  /// trackingCode chiều đi. Kho quét tem trên kiện hoàn là quét mã NÀY, nên
  /// lookup phải khớp được cả hai. Null = sàn chưa cấp / hoàn kiểu giao thất
  /// bại (kiện quay đầu giữ nguyên mã chiều đi).
  returnTrackingCode String?

  /// ---- SỐ CỦA SÀN VỀ YÊU CẦU HOÀN (19/08, chốt anh Trung: "không bịa giá") ----
  /// Giải pháp sàn chốt: hàng về hay khách giữ hàng. Null = chưa có yêu cầu /
  /// sàn chưa nói (đơn cờ cũ trước khi có trường này).
  returnSolution ReturnSolution?
  /// Số tiền hoàn SÀN BÁO trên yêu cầu còn sống (đang treo HOẶC đã ACCEPTED) —
  /// Shopee Returns refund_amount. KHÁC refundedAmount (số THẬT escrow): khi
  /// escrow chưa có, Lãi/Lỗ dùng số này thay vì tạm tính full doanh thu.
  platformRefundAmount Decimal @default(0) @db.Decimal(12, 2)
  /// Trạng thái yêu cầu hoàn NGUYÊN VĂN của sàn (Shopee: REQUESTED/PROCESSING/
  /// ACCEPTED/JUDGING/SELLER_DISPUTE…). Null = không có yêu cầu sống.
  platformReturnStatus String?
  /// Sàn xác nhận KIỆN HOÀN ĐÃ VỀ TAY seller (Shopee reverse_logistics_status
  /// = LOGISTICS_DELIVERY_DONE) → Lãi/Lỗ thu hồi giá vốn dù kho chưa quét;
  /// kho đánh DAMAGED/WRITTEN_OFF sau đó thì mới tính mất.
  returnDeliveredAt DateTime?

  /// Số tiền bưu cục/sàn đã đền cho kiện hàng hỏng hoặc mất.
  ///
  /// Chỉ có giá trị khi returnStatus = CLAIM_SETTLED. Thua kiện (WRITTEN_OFF)
  /// thì bằng 0 — phần đó là hao hụt shop chịu.
  ///
  /// Đây là TIỀN THU VỀ, không phải hàng: module Tài chính dùng số này để hạch
  /// toán dòng tiền bồi thường. Đừng nhầm sang tồn kho — hàng đã hỏng/mất thật.
  compensationAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Thời điểm SÀN báo đơn bắt đầu hoàn. Đây là mốc đếm ngược để đối soát:
  /// quá 7 ngày chưa quét trúng thì cảnh báo, quá 14 ngày thì coi như chưa về
  /// tay và làm căn cứ khiếu nại bưu cục.
  ///
  /// Để null khi KHÔNG BIẾT mốc này (đơn hoàn có từ trước khi hệ thống ghi
  /// nhận). Cố ý không lấy tạm createdAt để lấp chỗ trống: số ngày chờ là căn
  /// cứ đòi tiền bưu cục, bịa mốc ra là đi khiếu nại bằng số liệu sai.
  returnRequestedAt DateTime?

  /// CHỐT CHẶN CỘNG KHO TRÙNG.
  ///
  /// Tồn kho của một đơn chỉ được cộng lại ĐÚNG MỘT LẦN, dù đi qua đường nào:
  /// hủy đơn trước khi giao, hay nhận hàng hoàn về sau khi giao. Không có mốc
  /// này thì đơn bị hủy (đã cộng kho) mà nhân viên còn quét nhận hoàn nữa là
  /// kho phình ảo — bán ra hàng không có thật, đúng kiểu mất tiền âm thầm.
  stockRestoredAt DateTime?

  /// CHỐT CHẶN TRỪ KHO TRÙNG (song sinh với stockRestoredAt).
  ///
  /// Đơn từ webhook TikTok có thể được đẩy về NHIỀU LẦN (mỗi lần đổi trạng thái),
  /// còn đồng bộ lô lại chạy lặp — nên tồn kho của một đơn chỉ được TRỪ đúng một
  /// lần. Đánh mốc này ngay khi trừ kho; lần webhook sau thấy đã có mốc thì bỏ qua.
  /// (Đơn tạo qua webhook giả lập /mock-order trừ kho ngay lúc tạo nên không cần
  /// mốc; mốc này chỉ dùng cho luồng TikTok thật.)
  stockDeductedAt DateTime?

  /// GIỮ KHO TẠM (Hold Stock) — đơn sàn vừa đổ về nhưng CHƯA chốt (UNPAID...).
  ///
  /// Chưa được trừ thẳng quantityInStock (khách có thể bỏ thanh toán), nhưng
  /// cũng không thể coi như chưa bán — hai khách cùng lúc là bán vượt kho ngay.
  /// Giải pháp: cộng số lượng đơn vào Product.holdQuantity; tồn KHẢ DỤNG đẩy
  /// lên sàn = quantityInStock − holdQuantity. Mốc này chống hold trùng khi
  /// webhook bắn lại (song sinh với stockDeductedAt).
  stockHeldAt DateTime?

  /// Mốc đã NHẢ hold (khi đơn chốt → chuyển thành trừ thật, hoặc đơn hủy).
  /// Có mốc = holdQuantity đã được trả lại, không nhả lần hai.
  stockHoldReleasedAt DateTime?
  paymentStatus  String   @default("UNPAID")  // ví dụ: UNPAID, PAID, REFUNDED
  shippingStatus ShippingStatus @default(PENDING)

  /// Trạng thái HÓA ĐƠN ĐIỆN TỬ mới nhất của đơn (denormalize từ InvoiceLog để
  /// danh sách đơn lọc "đã/chưa xuất hóa đơn" không phải join). NULL = chưa từng
  /// phát hành. Webhook MISA là nơi cập nhật chính.
  einvoiceStatus InvoiceLogStatus?

  // ===== KHÁCH YÊU CẦU XUẤT HÓA ĐƠN (24/08 — Shopee get_buyer_invoice_info) =====
  /// Loại hóa đơn khách chọn khi đặt trên sàn: PERSONAL | COMPANY | HOUSEHOLD.
  /// NULL = khách không yêu cầu (đã hỏi sàn và sàn báo không có, hoặc chưa hỏi
  /// — phân biệt bằng buyerInvoiceFetchedAt). Giữ lại cả sau khi che info để
  /// badge/lịch sử vẫn biết đơn này từng có yêu cầu.
  invoiceRequestType String?
  /// Thông tin xuất hóa đơn khách cung cấp (tên/MST/email/địa chỉ — JSON chuẩn
  /// hóa từ invoice_detail của sàn). Sàn ẨN thông tin sau 30 ngày kể từ đơn
  /// hoàn thành nên phải kéo về sớm; phía Hubsell cron log-cleanup sẽ XÓA
  /// (DbNull) sau khi hóa đơn phát hành 30 ngày hoặc sau 90 ngày không phát
  /// hành — tuân thủ Luật bảo vệ dữ liệu cá nhân, data chỉ "ghé qua".
  buyerInvoiceInfo Json?
  /// Mốc đã hỏi sàn xong (kể cả kết quả "không yêu cầu") — chống hỏi lặp.
  /// NULL + đơn DELIVERED = worker sẽ hỏi ở lượt quét tới.
  buyerInvoiceFetchedAt DateTime?
  createdAt      DateTime @default(now())

  // ===== PHÍ SÀN 2 GIAI ĐOẠN =====
  // GĐ1 — TẠM TÍNH: khi đơn mới về, lấy % mặc định của kênh để ước tính.
  platformFee Decimal @default(0) @db.Decimal(12, 2) // phí sàn TẠM TÍNH

  // GĐ2 — QUYẾT TOÁN: khi đơn hoàn tất, sàn trả về số liệu tài chính THỰC TẾ.
  // Các trường này ghi đè số tạm tính khi lên báo cáo dòng tiền.
  isSettled       Boolean   @default(false) // đã được sàn quyết toán/giải ngân chưa
  settledAt       DateTime? // thời điểm quyết toán
  fixedFee        Decimal   @default(0) @db.Decimal(12, 2) // phí cố định
  serviceFee      Decimal   @default(0) @db.Decimal(12, 2) // phí dịch vụ (Freeship/Voucher Xtra)
  /// Phí "dịch vụ PiShip" (bảo hiểm giao hàng Shopee VN) — Seller Center tách
  /// dòng riêng khỏi Phí Dịch Vụ nên Hubsell cũng tách cột riêng, khỏi nhầm.
  sellerProtectionFee Decimal @default(0) @db.Decimal(12, 2)
  paymentFee      Decimal   @default(0) @db.Decimal(12, 2) // phí thanh toán
  affiliateFee    Decimal   @default(0) @db.Decimal(12, 2) // phí tiếp thị liên kết (Affiliate)
  sellerVoucher   Decimal   @default(0) @db.Decimal(12, 2) // voucher trợ giá do SHOP tự chịu
  /// Riêng phần voucher NGƯỜI BÁN giảm THẲNG vào số khách trả đơn này
  /// (voucher_from_seller Shopee) — KHÔNG gồm xu hoàn (khách vẫn trả đủ, xu
  /// dùng đơn sau). Là số CHIẾT KHẤU trừ vào dòng hàng khi phát hành hóa đơn.
  /// Lazada luôn 0: paid_price từng dòng ĐÃ trừ voucher người bán.
  sellerDiscountVoucher Decimal @default(0) @db.Decimal(12, 2)
  // --- Phí vận chuyển & đối soát khiếu nại ---
  shippingFeeQuoted Decimal @default(0) @db.Decimal(12, 2) // phí ship SÀN BÁO lúc đặt đơn
  shippingFeeActual Decimal @default(0) @db.Decimal(12, 2) // phí ship THỰC TẾ sàn trừ khi quyết toán
  // Chênh lệch = thực tế − sàn báo. LƯU DƯƠNG = số tiền shop bị trừ thêm (cần đòi lại).
  shippingFeeDiff   Decimal @default(0) @db.Decimal(12, 2)
  shippingDisputeStatus ShippingDisputeStatus @default(CHO_KHIEU_NAI)
  platformSubsidy Decimal   @default(0) @db.Decimal(12, 2) // trợ giá từ SÀN (giảm chi phí cho shop)
  actualPayout    Decimal   @default(0) @db.Decimal(12, 2) // tiền thực nhận về ví
  // --- KIỂM TOÁN PHÍ SÀN (trang /finance/fee-audit, 30/08) ---
  /// Snapshot số escrow ƯỚC TÍNH CỦA CHÍNH SÀN trước giải ngân (Shopee
  /// get_escrow_detail cho đơn chưa payout — cùng số màn "Doanh thu ước tính"
  /// Seller Center). syncShopeeSettlements KHÔNG ghi đè cột này: giữ làm MẪU SỐ
  /// so với actualPayout lúc quyết toán. NULL = sàn không cấp số ước tính
  /// (Lazada không có API này — đúng triết lý "không bịa số", không soi mò).
  expectedPayout  Decimal?  @db.Decimal(12, 2)
  /// = max(expectedPayout − actualPayout, 0), GHI MỘT LẦN lúc quyết toán.
  /// Tách cột thay vì tính lúc query vì Prisma không so được 2 cột trong where.
  payoutShortfall Decimal   @default(0) @db.Decimal(12, 2)
  payoutAuditStatus FeeAuditStatus @default(CHO_XU_LY) // xử lý khoản trả thiếu
  /// Mốc GIAO THÀNH CÔNG — ghi khi shippingStatus chuyển sang DELIVERED. Đơn
  /// backfill cũ nhận mốc lúc đồng bộ (muộn hơn thực tế) → phép đếm "quá hạn
  /// chưa trả tiền" chỉ THẬN TRỌNG hơn chứ không báo oan.
  deliveredAt     DateTime?
  // --- Bóc tách quyết toán CHI TIẾT (chỉ hiển thị ở Lãi/Lỗ Thực Hiện) ---
  // Các khoản này nằm NGOÀI công thức netRevenue dùng chung: trợ giá VC là bóc
  // tách nội bộ của phí ship (đã gói trong shippingFeeDiff), còn ví QC/thuế là
  // khoản sàn khấu trừ lúc GIẢI NGÂN — chúng đã phản ánh trong actualPayout.
  shipSubsidyPlatform Decimal @default(0) @db.Decimal(12, 2) // trợ giá VC từ SÀN
  shipSubsidyShop     Decimal @default(0) @db.Decimal(12, 2) // trợ giá VC do SHOP chịu
  adWalletTopup       Decimal @default(0) @db.Decimal(12, 2) // sàn trừ nạp ví quảng cáo khi giải ngân
  taxWithheld         Decimal @default(0) @db.Decimal(12, 2) // thuế sàn thu hộ (VD 1.5%)
  /// TIỀN ĐÃ HOÀN CHO KHÁCH (magnitude dương) — nguồn: Shopee escrow
  /// seller_return_refund; TikTok/Lazada reverse API đổ vào sau. 0 = chưa có
  /// số hoàn thật (đơn hoàn chưa chốt → engine tạm tính thận trọng).
  refundedAmount      Decimal @default(0) @db.Decimal(12, 2)

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[] // các lần trừ/hoàn kho gắn với đơn này
  items         OrderItem[] // chi tiết dòng sản phẩm trong đơn
  invoiceLogs   InvoiceLog[] // hóa đơn điện tử đã phát hành cho đơn này
  lazadaSettlement LazadaOrderSettlement? // sao kê quyết toán chi tiết (chỉ đơn Lazada)
  deliveryFailNotice DeliveryFailNotice? // cảnh báo "giao 2 lần không thành công" (nếu có)
  deliveryTrackingTask DeliveryTrackingTask? // vé xếp hàng hỏi tracking (cứu đơn giao thất bại)
  kocAttribution KocOrderAttribution? // đơn affiliate quy cho KOC nào (Sổ KOC)

  // Mã đơn là DUY NHẤT trong một gian hàng — chốt để đồng bộ API sàn idempotent:
  // kéo cùng một đơn nhiều lần thì upsert đúng bản ghi đó, không tạo trùng.
  @@unique([channelId, orderCode])
  @@index([channelId])
  // Đếm "đơn phát sinh trong tháng" của trần gói (GĐ2 cưỡng chế) — createdAt
  // là NGÀY SÀN (mọi luồng upsert đều override default), không phải ngày ghi DB.
  @@index([channelId, createdAt])
  // Kiểm toán phí sàn rổ #3 ("giao xong quá hạn sàn chưa trả") + cột
  // pendingSettle của Báo cáo dòng tiền cùng lọc theo cặp này.
  @@index([channelId, isSettled])
}

/// Chi tiết dòng sản phẩm của một đơn hàng.
/// costPriceAtSale = GIÁ VỐN GỐC tại thời điểm phát sinh đơn (snapshot) —
/// dù sau này giá vốn sản phẩm thay đổi, báo cáo lãi/lỗ của đơn cũ vẫn chính xác.
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String? // sản phẩm gốc (SetNull nếu sản phẩm bị xoá)
  channelSku      String // SKU trên sàn
  productName     String // tên sản phẩm tại thời điểm bán
  quantity        Int
  price           Decimal @db.Decimal(12, 2) // giá bán tại thời điểm phát sinh đơn
  costPriceAtSale Decimal @default(0) @db.Decimal(12, 2) // giá vốn gốc tại thời điểm phát sinh đơn
  /// HOÀN/TRẢ CẤP DÒNG SKU (kịch bản trả 1 vài SP trong đơn nhiều SP):
  /// số lượng bị khách trả của riêng dòng này — 0 = dòng không bị trả.
  returnedQuantity Int @default(0)
  /// Hàng trả của dòng này ĐÃ nhập lại kho nguyên vẹn → giá vốn phần trả được
  /// thu hồi (không tính vào COGS nữa). false = chưa về kho / hư hỏng.
  returnRestocked Boolean @default(false)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Liên kết (mapping): một Sản phẩm kho gốc ↔ nhiều SKU trên các sàn.
/// Ví dụ: "Quần jean nữ ống rộng" (SP002) ↔ Shopee "SH-QUAN-DEN-M" và TikTok "TT-QUAN-JEAN".
/// TẦNG 2 — SẢN PHẨM SÀN (bảng đệm).
///
/// Hứng nguyên trạng danh mục kéo từ từng gian hàng về. Đồng bộ KHÔNG được tạo
/// thẳng Product: tên và mã trên các shop sàn thường lệch nhau, đẩy thẳng vào
/// kho vật lý là sinh rác không dọn nổi.
///
/// `productId = NULL` nghĩa là sản phẩm sàn này CHƯA được liên kết về kho gốc.
/// Nhiều dòng ở đây có thể cùng trỏ về một Product — đó chính là cách 3 gian
/// hàng khác tên map chung một mã gốc.
model ChannelProduct {
  id          String   @id @default(cuid())
  channelId   String // thuộc gian hàng nào
  channelSku  String // mã SKU trên sàn
  productName String // tên hiển thị trên sàn
  variantName String? // phân loại trên sàn (size/màu)
  price       Decimal  @default(0) @db.Decimal(12, 2) // giá niêm yết trên sàn
  imageUrl    String?
  externalId  String? // id sản phẩm bên phía sàn

  /// SKU TỔNG cấp sản phẩm (item_sku Shopee) — KHÁC channelSku vốn là SKU của
  /// từng phân loại. NULL = người bán không đặt / sàn chưa đổ về.
  itemSku String?

  /// Tồn kho TRÊN SÀN tại lần đồng bộ sản phẩm gần nhất (Shopee stock_info_v2 /
  /// Lazada quantity). NULL = sàn không trả số / chưa đồng bộ lại từ khi có cột.
  /// Dùng cho "đồng bộ lần đầu lấy tồn theo sàn" khi liên kết SKU kho tồn 0.
  channelStock Int?
  status      ChannelProductStatus @default(ACTIVE)
  lastSyncedAt DateTime? // lần cuối kéo về từ sàn
  createdAt   DateTime @default(now())

  /// Giá vốn RIÊNG của SKU sàn khi CHƯA liên kết kho gốc — cho khách không
  /// muốn quản tồn kho tập trung vẫn nhập được giá vốn để tính lãi/lỗ.
  /// Khi ĐÃ liên kết, giá vốn đọc từ Product (nguồn chân lý duy nhất);
  /// cột này chỉ là fallback lúc chưa nối. NULL = chưa từng nhập.
  costPrice Decimal? @db.Decimal(12, 2)

  /// NULL = chưa liên kết về kho gốc. Đây là cốt lõi của tầng đệm.
  productId String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  channel Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, channelSku]) // 1 SKU sàn chỉ nối vào tối đa 1 sản phẩm gốc
  @@index([productId])
  @@index([channelId])
}

/// Sản phẩm còn bán trên sàn hay đã bị gỡ niêm yết.
enum ChannelProductStatus {
  ACTIVE
  DELISTED
}

/// Nhật ký biến động tồn kho
model InventoryLog {
  id             String           @id @default(cuid())
  productId      String
  changeQuantity Int
  type           InventoryLogType
  reason         String?
  orderId        String? // đơn hàng gây ra biến động này (nếu có) — dùng để hoàn kho khi huỷ đơn & tính giá vốn
  createdAt      DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
}

/// Chi phí hoạt động của shop (cố định/biến đổi): mặt bằng, lương, đóng gói, quảng cáo sàn...
/// Dùng để tính Lợi nhuận thuần = Lợi nhuận gộp − Tổng chi phí hoạt động.
model OperatingExpense {
  id          String          @id @default(cuid())
  userId      String // thuộc về chủ shop
  name        String // tên/mô tả khoản, ví dụ "Thuê mặt bằng tháng 7" / "Hoàn tiền NCC"
  // CHI phí: category + type có ý nghĩa. THU: bỏ qua (luôn hiển thị nhãn "Thu").
  direction   TransactionDirection @default(EXPENSE)
  category    ExpenseCategory @default(OTHER)
  type        ExpenseType     @default(VARIABLE) // FIXED (cố định) | VARIABLE (biến đổi)
  // Chi phí VARIABLE có thể gắn trực tiếp vào 1 mã SKU (tiền Ads, book KOC...)
  // để tính Lời/Lỗ riêng cho sản phẩm đó. FIXED thì để trống (trừ vào tổng shop).
  appliedSku  String?
  amount      Decimal         @db.Decimal(12, 2) // luôn DƯƠNG; chiều do `direction` quyết định

  // NGUỒN TIỀN ÁP DỤNG — để đồng bộ sang bảng dòng tiền (cộng/trừ đúng cột của
  // đúng gian). Ba mức gắn:
  //   1) fundChannelId set                → đích danh MỘT gian hàng.
  //   2) fundChannelId null + fundPlatform set → CHUNG CẤP SÀN ("Lazada — Tất cả
  //      shop"): báo cáo tính khi lọc "Tất cả sàn" hoặc đúng sàn đó (tất cả
  //      shop); lọc đích danh 1 shop thì KHÔNG tính.
  //   3) cả hai null                     → CHUNG TOÀN SHOP (form gửi "ALL"/"ALL",
  //      hoặc data cũ/quick-add): chỉ tính ở chế độ lọc "Tất cả sàn".
  // Khoản chung (2)(3) không thuộc cột dòng tiền của riêng gian nào.
  fundChannelId String?
  fundPlatform  ChannelName?
  fundSource    FundSourceType?

  note        String?
  expenseDate DateTime        @default(now()) // ngày phát sinh
  createdAt   DateTime        @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fundChannel Channel? @relation(fields: [fundChannelId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([fundChannelId])
}

// ---------- ĐỒNG BỘ TỒN KHO TỰ ĐỘNG (Inventory Sync) ----------
//
// Ba bảng phục vụ luồng webhook Shopee → khóa/trừ kho → đẩy tồn ngược lên sàn:
//   1) ShopeeWebhookLog   — HÀNG ĐỢI BỀN cho sự kiện push (sống sót qua restart,
//      khác hàng đợi in-memory cũ). Worker xử lý FIFO + retry có giãn cách.
//   2) InventorySyncLog   — NHẬT KÝ ĐỐI SOÁT từng lượt đẩy tồn lên sàn
//      (SKU, số cũ, số mới, thành công/thất bại).
//   3) InventorySyncAlert — CẢNH BÁO trên UI khi retry đủ số lần vẫn thất bại,
//      chủ shop phải chỉnh tồn trên sàn thủ công kẻo bị phạt do hết hàng ảo.

/// Một sự kiện webhook Shopee đã nhận (đã QUA verify chữ ký) chờ/đã xử lý.
///
/// Route webhook chỉ INSERT vào đây rồi ack 200 ngay (yêu cầu <3s của Shopee);
/// mọi việc nặng (gọi API sàn, transaction kho) do worker nền làm sau. Nhờ nằm
/// trong DB, sự kiện không mất khi backend restart giữa chừng.
model ShopeeWebhookLog {
  id        String           @id @default(cuid())
  /// Mã sự kiện Shopee (3 logistics / 4 order status / 5 authorization).
  eventCode Int
  shopId    String
  /// Mã đơn trong payload (nếu là sự kiện đơn hàng) — để tra soát theo đơn.
  orderSn   String?
  /// SHA-256 của RAW body — chốt chống trùng BỀN: Shopee gửi lại y nguyên một
  /// sự kiện (retry mạng) thì insert đụng unique và bị bỏ qua ngay từ route.
  bodyHash  String           @unique
  /// Payload JSON nguyên văn (stringify) — worker đọc lại để xử lý.
  payload   String
  status    WebhookJobStatus @default(PENDING)
  /// Số lần đã thử xử lý. Quá MAX (3) → FAILED + bắn InventorySyncAlert.
  attempts  Int              @default(0)
  /// Thời điểm sớm nhất được thử lại (exponential backoff). NULL = xử lý ngay.
  nextRetryAt DateTime?
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([status, nextRetryAt, createdAt]) // worker quét job đến hạn theo FIFO
  @@index([orderSn])
  @@map("shopee_webhook_logs")
}

/// HÀNG ĐỢI BỀN WEBHOOK MISA meInvoice — cùng pattern shopee_webhook_logs:
/// route /v1/webhooks/misa-meinvoice CHỈ validate sơ bộ + INSERT một dòng rồi
/// ack 200 (<3s theo yêu cầu MISA); worker nền xử lý sau, lỗi thì retry tối đa
/// 3 lần cách nhau 5 phút (nextRetryAt) trước khi FAILED.
model MisaWebhookLog {
  id        String @id @default(cuid())
  /// Loại sự kiện MISA gửi: InvoicePublished | InvoiceCancelled | InvoiceReplaced…
  eventType String
  /// Mã giao dịch/mã tra cứu hóa đơn phía MISA — khớp InvoiceLog.transactionId.
  transactionId String?
  /// Số hóa đơn NCC cấp (VD "C26TAA-00001234") — có khi đã phát hành.
  invoiceNo String?
  /// Mã đơn hàng gốc Hubsell (MISA lưu làm RefID lúc phát hành) — để đối chiếu.
  orderCode String?
  /// SHA-256 của RAW body — chống trùng bền khi MISA retry y nguyên một sự kiện.
  bodyHash String @unique
  /// Payload JSON nguyên văn (stringify) — worker đọc lại để xử lý.
  payload String
  status  WebhookJobStatus @default(PENDING)
  /// Số lần đã thử xử lý. Quá MAX (3) → FAILED, chờ người xem trang Nhật ký.
  attempts Int @default(0)
  /// Thời điểm sớm nhất được thử lại (cách đều 5 phút). NULL = xử lý ngay.
  nextRetryAt DateTime?
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([status, nextRetryAt, createdAt]) // worker quét job đến hạn theo FIFO
  @@index([orderCode])
  @@map("misa_webhook_logs")
}

/// AUDIT LOG hóa đơn điện tử — mỗi dòng = MỘT lần trạng thái hóa đơn thay đổi
/// (từ webhook MISA hay thao tác trong Hubsell). Giai đoạn test Sandbox soi
/// bảng này để chứng minh sự kiện đã chạy đúng thứ tự; về sau là chứng cứ đối
/// soát với cơ quan thuế nên KHÔNG bao giờ update/xóa, chỉ insert.
model InvoiceStatusHistory {
  id           String @id @default(cuid())
  invoiceLogId String
  /// Bản sao bền của mã đơn — tra soát được cả khi đơn gốc đã xóa theo kênh.
  orderCode String
  /// NULL = bản ghi đầu tiên (hóa đơn vừa được webhook tạo, chưa có trạng thái cũ).
  fromStatus InvoiceLogStatus?
  toStatus   InvoiceLogStatus
  /// Nguồn phát sinh thay đổi: MISA_WEBHOOK | HUBSELL (thao tác trong app).
  source String @default("MISA_WEBHOOK")
  /// Ghi chú nghiệp vụ: kết quả đối soát thuế, lý do hủy/thay thế…
  note      String?
  createdAt DateTime @default(now())

  invoiceLog InvoiceLog @relation(fields: [invoiceLogId], references: [id], onDelete: Cascade)

  @@index([invoiceLogId, createdAt])
  @@index([orderCode])
}

/// Nhật ký MỘT lượt đẩy tồn kho lên sàn cho MỘT SKU sàn — bảng đối soát:
/// [thời gian] − [SKU] − [số cũ] − [số mới] − [trạng thái].
model InventorySyncLog {
  id        String @id @default(cuid())
  channelId String
  /// SKU trên sàn (ChannelProduct.channelSku) — khoá người vận hành tra được.
  channelSku String
  productId  String? // sản phẩm kho gốc (SetNull nếu bị xoá — log giữ nguyên SKU)
  /// Tồn KHẢ DỤNG trước/sau biến động (quantityInStock − holdQuantity).
  oldQuantity Int
  newQuantity Int
  status      StockSyncStatus
  /// Ngữ cảnh lượt đồng bộ (vd "webhook Shopee đơn XXX") + lỗi nếu thất bại.
  message     String?
  createdAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([status])
}

/// Cảnh báo lệch tồn hiển thị trên UI: đẩy tồn lên sàn thất bại sau khi đã
/// retry đủ số lần — tồn trên sàn ĐANG SAI so với Hubsell, cần xử lý tay.
/// resolvedAt = NULL nghĩa là còn treo (hiện badge); bấm "Đã xử lý" thì đóng.
model InventorySyncAlert {
  id         String    @id @default(cuid())
  channelId  String
  channelSku String?  // NULL khi lỗi ở cấp sự kiện (không rõ SKU nào)
  orderSn    String?  // đơn gây ra biến động (nếu có) — để tra soát
  message    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, resolvedAt])
}

/// CẤU HÌNH ĐỒNG BỘ TỒN KHO ĐA SÀN của một chủ shop (trang Quản lý Kho →
/// Đồng bộ tồn kho). Không có bản ghi = mặc định: autoSync TẮT, tồn an toàn 0.
model ShopSyncSetting {
  id     String @id @default(cuid())
  userId String @unique

  /// BẬT thì mọi biến động kho (đơn sàn, nhập/xuất tay, nhập hàng hoàn...) tự
  /// đẩy tồn khả dụng lên các gian đã liên kết SKU. TẮT (mặc định) thì chỉ nút
  /// [Sync ngay toàn bộ] và force-sync theo cảnh báo mới đẩy — an toàn cho shop
  /// mới chưa nhập đúng tồn kho vật lý (tránh ghi đè tồn sàn bằng số 0).
  autoSyncEnabled Boolean @default(false)

  /// Tồn an toàn MẶC ĐỊNH toàn shop — SKU nào không đặt riêng
  /// (Product.safetyStock = null) thì dùng số này.
  safetyStockDefault Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shop_sync_settings")
}

enum StockPushStatus {
  PENDING // chờ worker nhặt (kể cả đang chờ đến giờ retry)
  RUNNING // worker đang đẩy — enqueue mới trong lúc này sẽ ghi đè về PENDING
}

/// HÀNG ĐỢI ĐẨY TỒN ĐA SÀN — mỗi dòng là "cần đẩy tồn khả dụng mới nhất của
/// (gian × SKU sàn) lên sàn". UNIQUE (channelId, channelSku) để GỘP: 10 biến
/// động liên tiếp của cùng SKU chỉ còn 1 job, worker luôn đọc số MỚI NHẤT lúc
/// đẩy nên không cần rượt đuổi từng biến động (tự chống bão rate-limit).
/// Job xong (thành công hoặc hết lượt retry) là XÓA — audit nằm ở
/// InventorySyncLog, cảnh báo nằm ở InventorySyncAlert; bảng này luôn nhỏ.
model StockPushJob {
  id         String @id @default(cuid())
  channelId  String
  /// SKU trên sàn (ChannelProduct.channelSku) — worker đọc lại mapping theo cặp
  /// (channelId, channelSku) lúc đẩy; mapping đã bị gỡ thì job tự hủy.
  channelSku String
  productId  String

  /// Tồn khả dụng TRƯỚC biến động đầu tiên (snapshot lúc enqueue lần đầu) —
  /// chỉ phục vụ cột "số cũ" của InventorySyncLog; số đẩy luôn đọc mới nhất.
  oldAvailable Int?
  /// true = người dùng chủ động bấm sync (bỏ qua switch autoSyncEnabled).
  forced       Boolean @default(false)
  /// Nguồn biến động để ghi vào log (vd "webhook Shopee đơn X", "nhập kho tay").
  source       String?

  status      StockPushStatus @default(PENDING)
  attempts    Int             @default(0)
  nextRetryAt DateTime        @default(now())
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, channelSku])
  @@index([status, nextRetryAt])
  @@map("stock_push_jobs")
}

/// SAO KÊ QUYẾT TOÁN LAZADA CHI TIẾT — mỗi đơn Lazada MỘT dòng, số CÓ DẤU
/// NGUYÊN BẢN từ /finance/transaction/details/get (ÂM = sàn trừ shop, DƯƠNG =
/// sàn ghi có). Tách bảng riêng thay vì thêm cột lên Order vì danh mục phí
/// Lazada rất dài và chỉ có nghĩa với đơn Lazada; số GỘP vẫn ghi về các cột
/// GĐ2 của Order để công thức dùng chung (orderPlatformFee, cash-flow) không
/// phải biết chi tiết từng sàn. Nguồn sự thật là sao kê — đồng bộ lặp ghi đè.
model LazadaOrderSettlement {
  id      String @id @default(cuid())
  orderId String @unique

  // ===== DOANH THU =====
  /// "Giá trị sản phẩm" cộng các dòng GIẢM GIÁ đơn (đã phản ánh trong giá bán)
  itemRevenue Decimal @default(0) @db.Decimal(12, 2)

  // ===== CHI TIẾT PHÍ VẬN CHUYỂN =====
  shipFee              Decimal @default(0) @db.Decimal(12, 2) /// Phí vận chuyển (sàn ghi nhận)
  shipFeeCustomer      Decimal @default(0) @db.Decimal(12, 2) /// Khách trả
  shipDiscountPlatform Decimal @default(0) @db.Decimal(12, 2) /// Giảm giá VC từ nền tảng
  shipDiscountSeller   Decimal @default(0) @db.Decimal(12, 2) /// Giảm giá VC người bán chịu
  shipFeeReturn        Decimal @default(0) @db.Decimal(12, 2) /// Phí vận chuyển hoàn
  shipFeeAdjustment    Decimal @default(0) @db.Decimal(12, 2) /// Điều chỉnh phí vận chuyển

  // ===== PHÍ NỀN TẢNG (mỗi khoản MỘT cột — khớp từng dòng sao kê Lazada VN) =====
  feeFixed              Decimal @default(0) @db.Decimal(12, 2) /// "Phí cố định"
  feeOrderProcessing    Decimal @default(0) @db.Decimal(12, 2) /// "Phí xử lý đơn hàng"
  feePayment            Decimal @default(0) @db.Decimal(12, 2) /// Phí thanh toán (Payment Fee)
  feeCommission         Decimal @default(0) @db.Decimal(12, 2) /// Phí hoa hồng (Commission)
  feeShipSeller         Decimal @default(0) @db.Decimal(12, 2) /// Phí VC người bán trả
  shipSubsidySeller     Decimal @default(0) @db.Decimal(12, 2) /// Trợ giá vận chuyển (người bán)
  feeFreeshipMax        Decimal @default(0) @db.Decimal(12, 2) /// Phí Freeship Max
  feeCashbackMax        Decimal @default(0) @db.Decimal(12, 2) /// Phí Cashback Max
  feeSponsoredDiscovery Decimal @default(0) @db.Decimal(12, 2) /// Phí Discovery tài trợ
  feeLazadaBonus        Decimal @default(0) @db.Decimal(12, 2) /// Phí Lazada Bonus
  bonusLzdCofund        Decimal @default(0) @db.Decimal(12, 2) /// Lazada Bonus — LZD đồng tài trợ
  feeBuyerReview        Decimal @default(0) @db.Decimal(12, 2) /// Phí đánh giá người mua
  feeLazpick            Decimal @default(0) @db.Decimal(12, 2) /// Hoa hồng Lazpick/LazTop
  feeCampaign           Decimal @default(0) @db.Decimal(12, 2) /// Phí chiến dịch/khuyến mãi (LazCoins...)
  feeAffiliate          Decimal @default(0) @db.Decimal(12, 2) /// Phí tiếp thị liên kết
  feeInfrastructure     Decimal @default(0) @db.Decimal(12, 2) /// Phí hạ tầng (Infrastructure Fee)
  /// CHỐT CHẶN AN TOÀN: phí ÂM chưa nhận diện được — không bao giờ bỏ sót tiền.
  feeOther              Decimal @default(0) @db.Decimal(12, 2)
  /// CHỐT CHẶN AN TOÀN: khoản DƯƠNG chưa nhận diện được (sàn bù/hoàn).
  subsidyOther          Decimal @default(0) @db.Decimal(12, 2)

  // ===== VOUCHER & THUẾ =====
  /// "Giảm giá từ Cửa hàng" / "Giảm Giá Bằng Xu" — voucher NGƯỜI BÁN chịu.
  sellerVoucher Decimal @default(0) @db.Decimal(12, 2)
  vatFee       Decimal @default(0) @db.Decimal(12, 2) /// Thuế GTGT nhà bán hàng
  incomeTaxFee Decimal @default(0) @db.Decimal(12, 2) /// Thuế TNCN nhà bán hàng

  // ===== KẾT QUẢ =====
  /// TỔNG ĐẠI SỐ mọi dòng sao kê của đơn = tiền THỰC về ví (đúng bất kể phân loại).
  actualPayout Decimal @default(0) @db.Decimal(12, 2)
  /// Ngày giao dịch MỚI NHẤT trên sao kê — mốc ghi nhận vào Báo cáo dòng tiền.
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("lazada_order_settlements")
}

// ---------- AFFILIATE TIẾP THỊ & VÍ HUBSELL ----------
//
// Chương trình referral của CHÍNH nền tảng Hubsell (KHÁC module /koc-marketing
// đo Net-ROI creator cho chủ shop): Seller giới thiệu bạn bè dùng Hubsell, mỗi
// lượt THANH TOÁN THÀNH CÔNG của người được giới thiệu chia 10% hoa hồng vào
// Ví Hubsell của người giới thiệu — vĩnh viễn, mọi lần gia hạn về sau.
// Số dư ví dùng để GIA HẠN GÓI hoặc RÚT VỀ NGÂN HÀNG (duyệt thủ công).

/// Loại biến động số dư Ví Hubsell.
// ============================================================
// KHU ĐIỀU HÀNH HUBSELL (Hubsell HQ) — dữ liệu nội bộ công ty, KHÔNG phải
// dữ liệu shop của khách. Chỉ đọc/ghi qua /api/admin (cây quyền hq.*).
// ============================================================

/// Trạng thái chăm sóc một CHỦ SHOP trong CRM nội bộ — do Sale/CSKH đặt tay,
/// bổ trợ cho tín hiệu hoạt động tự suy (đơn hàng gần nhất).
enum PlatformCareStatus {
  NEW        // vừa đăng ký, chưa ai liên hệ
  CONTACTED  // đã liên hệ / đang tư vấn
  ACTIVE     // đang dùng ổn định
  CHURN_RISK // có dấu hiệu rời bỏ (lâu không hoạt động, phàn nàn...)
  CHURNED    // đã rời bỏ
}

/// HỒ SƠ CHĂM SÓC KHÁCH HÀNG (CRM nội bộ Hubsell) — 1-1 với chủ shop, tạo lười
/// khi nhân viên điều hành lần đầu cập nhật. Ghi chú là bản MỚI NHẤT (lịch sử
/// thay đổi nằm ở PlatformAuditLog, không nhân bản ở đây).
model PlatformCustomerCare {
  id     String             @id @default(cuid())
  /// Chủ shop được chăm sóc.
  userId String             @unique
  status PlatformCareStatus @default(NEW)
  /// Nhân viên điều hành phụ trách (User thuộc HQ) — null = chưa phân công.
  assigneeId String?
  /// Ghi chú chăm sóc mới nhất (thay thế mỗi lần lưu).
  note String?
  /// Ai cập nhật lần cuối — để hiển thị, chi tiết đầy đủ tra PlatformAuditLog.
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User  @relation("CareCustomer", fields: [userId], references: [id], onDelete: Cascade)
  assignee User? @relation("CareAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("platform_customer_care")
}

/// Vòng đời một LEAD TƯ VẤN từ landing (form "Đăng ký tư vấn" / dock nổi).
enum ConsultLeadStatus {
  NEW       // vừa gửi form, chưa ai gọi
  CONTACTED // sale đã gọi / đang tư vấn
  CONVERTED // đã chốt (khách đăng ký tài khoản / mua gói)
  DROPPED   // không chốt được / lead rác
}

/// LEAD TƯ VẤN TỪ LANDING (hubsell.tech) — khách CHƯA có tài khoản để lại
/// Tên + Email + SĐT qua form public. KHÁC PlanUpgradeRequest (khách ĐÃ đăng
/// nhập gửi từ /settings/plan). Gói khách chốt cuối cùng KHÔNG ghi ở đây —
/// nguồn sự thật là PackagePayment lúc kế toán ghi nhận thanh toán; trang HQ
/// tự match lead ↔ User theo email/SĐT để hiển thị "đã đăng ký → gói nào".
model ConsultLead {
  id    String @id @default(cuid())
  name  String
  email String
  phone String
  /// Khách bấm từ đâu: "pricing-enterprise" (card Enterprise) | "floating-consult" (dock nổi).
  source String
  status ConsultLeadStatus @default(NEW)
  /// Ghi chú sale (bản mới nhất — lịch sử nằm ở PlatformAuditLog).
  note String?
  /// Nhân viên sale phụ trách — null = chưa phân công.
  assigneeId String?
  assignee   User?   @relation("ConsultLeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
  @@map("consult_leads")
}

/// NHẬT KÝ THAO TÁC khu điều hành — sổ APPEND-ONLY, không sửa/xoá bản ghi.
/// Ghi mọi thao tác GHI của khu /admin (cập nhật chăm sóc, duyệt/từ chối lệnh
/// rút, tạo/sửa/xoá nhân viên điều hành) — điều kiện bắt buộc trước khi nhân
/// viên HQ được đụng dữ liệu khách hàng thật. Chỉ CHỦ NỀN TẢNG xem được.
model PlatformAuditLog {
  id      String  @id @default(cuid())
  /// Ai thao tác — SetNull khi tài khoản bị xoá, actorName vẫn giữ vết.
  actorId   String?
  actorName String
  /// Mã hành động phẳng: "care.update" / "withdrawal.approve" /
  /// "withdrawal.reject" / "staff.create" / "staff.update" / "staff.delete" /
  /// "staff.reset-password".
  action String
  /// Đối tượng bị tác động (chủ shop / nhân viên) + nhãn snapshot để log còn
  /// đọc được sau khi đối tượng bị xoá.
  targetUserId String?
  targetLabel  String?
  /// Chi tiết tuỳ hành động (giá trị mới, số tiền, lý do...) — hiển thị thô.
  detail    Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("platform_audit_logs")
}

/// Chiều dòng tiền của một bút toán sổ quỹ nội bộ Hubsell.
enum LedgerDirection {
  IN  // tiền VÀO (khách trả phí gói dịch vụ...)
  OUT // tiền RA  (chi trả hoa hồng, chi phí vận hành...)
}

/// Nguồn phát sinh bút toán — quyết định bút toán tự sinh hay ghi tay.
enum LedgerSource {
  SUBSCRIPTION    // thu phí đăng ký/gia hạn gói (ghi tay khi chưa có cổng thanh toán)
  REFERRAL_PAYOUT // chi trả lệnh rút hoa hồng giới thiệu — TỰ SINH khi duyệt lệnh
  OTHER           // khoản thu/chi khác (ghi tay)
}

/// Nghĩa vụ hóa đơn của bút toán THU: NONE = không cần (khoản chi/nội bộ),
/// PENDING = phải xuất mà chưa xuất, ISSUED = đã xuất (kèm số hóa đơn).
enum LedgerInvoiceStatus {
  NONE
  PENDING
  ISSUED
}

/// SỔ QUỸ NỘI BỘ HUBSELL (GĐ5) — mỗi dòng một khoản tiền vào/ra của CHÍNH công
/// ty Hubsell (không phải tiền của shop khách). `amount` luôn DƯƠNG, chiều do
/// `direction` quyết định — kế toán không phải nhớ quy ước dấu.
/// Bút toán tự sinh (withdrawalRequestId != null) KHÔNG sửa/xoá được số tiền —
/// nguồn sự thật là lệnh rút; chỉ bút toán ghi tay mới sửa/xoá trọn vẹn.
model PlatformLedgerEntry {
  id        String          @id @default(cuid())
  direction LedgerDirection
  source    LedgerSource
  amount    Decimal         @db.Decimal(14, 2)
  /// Diễn giải hiển thị trên sổ (vd "Thu phí gói Professional 12 tháng").
  note String?
  /// Chủ shop liên quan (người trả phí / người nhận hoa hồng) — SetNull khi xoá.
  customerId String?
  customer   User?   @relation("LedgerCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  /// Lệnh rút sinh ra bút toán này (chi hoa hồng) — null với bút toán ghi tay.
  withdrawalRequestId String? @unique
  /// Khoản thanh toán gói sinh ra bút toán này (thu phí gói TỰ SINH khi kế toán
  /// xác nhận đã nhận tiền) — null với bút toán ghi tay.
  packagePaymentId String?         @unique
  packagePayment   PackagePayment? @relation(fields: [packagePaymentId], references: [id], onDelete: SetNull)
  invoiceStatus       LedgerInvoiceStatus @default(NONE)
  invoiceNo           String?
  /// Ngày PHÁT SINH nghiệp vụ (kế toán chọn khi ghi tay — khác ngày nhập máy).
  occurredAt DateTime @default(now())
  /// Ai ghi bút toán — snapshot tên để sổ còn đọc được khi tài khoản bị xoá.
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())

  @@index([occurredAt])
  @@map("platform_ledger_entries")
}

/// Checklist thủ tục thuế của CHÍNH công ty Hubsell (tab Lịch thuế /admin/finance).
/// Mỗi dòng = một mốc ĐÃ XỬ LÝ (xóa dòng = bỏ đánh dấu); itemKey khớp dữ liệu
/// tĩnh trong frontend tax-calendar-section.tsx. Snapshot tên người đánh dấu
/// để lịch sử còn đọc được khi tài khoản bị xoá (cùng lý do PlatformLedgerEntry).
model PlatformTaxCheckItem {
  id         String   @id @default(cuid())
  itemKey    String   @unique
  doneAt     DateTime @default(now())
  doneById   String?
  doneByName String

  @@map("platform_tax_check_items")
}

enum WalletTxnType {
  COMMISSION      // +10% hoa hồng khi người được giới thiệu thanh toán thành công
  PACKAGE_RENEWAL // − trừ ví để gia hạn gói Hubsell
  WITHDRAWAL      // − rút về ngân hàng (tạo cùng WithdrawalRequest)
  ADJUSTMENT      // ± điều chỉnh thủ công (hoàn lại lệnh rút bị từ chối...)
}

enum WalletTxnStatus {
  PENDING   // lệnh rút đang chờ duyệt — tiền ĐÃ trừ khỏi balance (giữ chỗ)
  COMPLETED
  REJECTED  // lệnh rút bị từ chối — đã có bản ghi ADJUSTMENT hoàn tiền đi kèm
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// VÍ HUBSELL — số dư khả dụng của một user (1-1). Tạo lười khi phát sinh
/// giao dịch đầu tiên hoặc lần đầu mở trang Affiliate.
/// BẤT BIẾN: balance = Σ amount (có dấu) của mọi WalletTransaction không REJECTED.
model HubsellWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hubsell_wallets")
}

/// LỊCH SỬ biến động Ví Hubsell — sổ cái append-only, KHÔNG sửa/xoá bản ghi.
/// `amount` CÓ DẤU: dương = cộng vào ví, âm = trừ khỏi ví.
model WalletTransaction {
  id     String          @id @default(cuid())
  userId String
  type   WalletTxnType
  amount Decimal         @db.Decimal(14, 2)
  status WalletTxnStatus @default(COMPLETED)
  /// Diễn giải hiển thị thẳng trên UI (vd "Hoa hồng 10% từ abc@gmail.com").
  note   String?
  /// Với COMMISSION: user ĐÃ THANH TOÁN làm phát sinh hoa hồng (để đối soát).
  sourceUserId String?
  /// Với WITHDRAWAL/ADJUSTMENT hoàn tiền: lệnh rút liên quan.
  withdrawalRequestId String?
  createdAt DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequest WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

/// YÊU CẦU RÚT TIỀN ví Hubsell → ngân hàng. Tiền bị TRỪ NGAY khỏi balance lúc
/// đặt lệnh (chống rút trùng); REJECTED thì hoàn lại bằng txn ADJUSTMENT.
/// Duyệt thủ công (platform admin) — giai đoạn đầu chưa có cổng chi hộ.
model WithdrawalRequest {
  id     String                  @id @default(cuid())
  userId String
  amount Decimal                 @db.Decimal(14, 2)
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  status      WithdrawalRequestStatus @default(PENDING)
  /// Ghi chú của người duyệt (lý do từ chối / mã giao dịch chuyển khoản).
  reviewNote  String?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("withdrawal_requests")
}

// ============================================================
// GÓI DỊCH VỤ & THUÊ BAO (GĐ1 thương mại hóa, 22/08/2026)
//
// Nguyên tắc: giá/giới hạn/tính năng của gói là DỮ LIỆU (admin sửa trên trang
// /admin/plans), không phải code. Subscription + PackagePayment SNAPSHOT giá
// và tên gói tại thời điểm thanh toán — đổi bảng giá không bao giờ vỡ lịch sử,
// và "khách cũ giữ giá cũ" (grandfathering) chỉ là chuyện dữ liệu.
// ============================================================

enum BillingCycle {
  MONTHLY
  QUARTERLY // 3 tháng
  SEMIANNUAL // 6 tháng
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE // đang hiệu lực (quá hạn = suy ra từ currentPeriodEnd lúc đọc, không cần cron)
  CANCELLED
}

enum PackagePaymentMethod {
  BANK_TRANSFER // chuyển khoản tay — kế toán xác nhận trên /admin/plans
  WALLET // trừ Ví Hubsell (hoa hồng giới thiệu) — KHÔNG có tiền vào quỹ, không ghi sổ quỹ
  GATEWAY // cổng thanh toán (chờ đăng ký khi có GPKD) — webhook ghi qua externalRef
}

/// BẢNG GIÁ GÓI HUBSELL — mỗi dòng một gói (Beta 0đ, Starter, Professional...).
model ServicePlan {
  id String @id @default(cuid())
  /// Mã ngắn duy nhất (BETA/STARTER/PRO...) — bất biến sau khi tạo, dùng làm
  /// snapshot trên PackagePayment nên không bao giờ đổi.
  code        String  @unique
  name        String
  description String?
  /// Bậc gói để so nâng/hạ cấp (0 = thấp nhất). Hai gói được phép cùng bậc.
  tier         Int     @default(0)
  /// Giá theo kỳ — 0 = KHÔNG BÁN kỳ đó (khách chỉ thấy các kỳ có giá).
  priceMonthly    Decimal @default(0) @db.Decimal(14, 2)
  priceQuarterly  Decimal @default(0) @db.Decimal(14, 2)
  priceSemiannual Decimal @default(0) @db.Decimal(14, 2)
  priceYearly     Decimal @default(0) @db.Decimal(14, 2)
  /// Giới hạn sử dụng — null = không giới hạn. GĐ1 chỉ LƯU và hiển thị;
  /// cưỡng chế (chặn mềm + mời nâng gói) là việc của GĐ2.
  maxChannels       Int?
  maxOrdersPerMonth Int?
  maxStaff          Int?
  /// Cờ tính năng của gói, vd {"adsAssistant": true} — code chỉ hỏi theo khóa,
  /// thêm tính năng mới không cần migration.
  features Json @default("{}")
  /// Chỉ gói đang bán mới hiện cho khách chọn; gói tắt vẫn giữ nguyên cho
  /// thuê bao cũ đang chạy (không bao giờ xoá gói đã có người dùng).
  isActive Boolean @default(false)
  /// Gói mặc định gán cho tài khoản chủ shop mới đăng ký — tối đa MỘT gói bật
  /// cờ này (route ghi tự tắt cờ ở các gói khác).
  isDefault Boolean  @default(false)
  /// Số ngày DÙNG THỬ khi tài khoản mới được gán gói này (anh Trung chốt 22/08:
  /// mọi khách mới đều dùng thử; 14/30 là DATA — đổi một ô số, không sửa code).
  /// 0 = không có dùng thử (gán là tính tiền ngay / vô thời hạn nếu giá 0).
  trialDays Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("service_plans")
}

/// THUÊ BAO — mỗi chủ shop đúng MỘT dòng (gói hiện tại + kỳ hạn hiện tại).
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  planId String
  status SubscriptionStatus @default(ACTIVE)
  /// Đang trong kỳ DÙNG THỬ (chưa từng trả tiền) — thanh toán đầu tiên hạ cờ.
  isTrial Boolean @default(false)
  /// Kỳ hiện tại. currentPeriodEnd null = vô thời hạn.
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  /// ---- Theo dõi TRẦN ĐƠN THÁNG (GĐ2 cưỡng chế, plan-enforcement.ts) ----
  /// Tháng dương lịch "yyyy-MM" mà 2 cột dưới thuộc về — sang tháng tự reset
  /// LÚC ĐỌC (không cron). Ghi lười: chỉ update khi trạng thái đổi.
  quotaMonth String?
  /// Thời điểm ĐẦU TIÊN chạm 100% trần đơn trong tháng — mốc tính ân hạn
  /// 7 ngày trước khi khóa tầng giá trị gia tăng. Tụt dưới 100% (nâng gói/
  /// sang tháng) thì xoá.
  overQuotaSince DateTime?
  /// Mốc chuông đã phát trong tháng (0/80/100/120) — chống spam thông báo
  /// bền hơn cửa sổ dedupe 24h của notify().
  quotaNotifiedLevel Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     ServicePlan      @relation(fields: [planId], references: [id])
  payments PackagePayment[]

  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

enum PlanUpgradeRequestStatus {
  PENDING // khách vừa gửi — HQ liên hệ hướng dẫn thanh toán
  DONE // đã chốt: recordPackagePaymentTx TỰ đóng mọi PENDING của khách khi ghi nhận thanh toán
  CANCELLED // khách tự hủy, hoặc HQ hủy (khách đổi ý qua điện thoại)
}

/// YÊU CẦU MUA/NÂNG GÓI khách tự gửi từ trang /settings/plan (GĐ3) — cầu nối
/// bán hàng khi CHƯA có cổng thanh toán/STK: khách chọn gói + kỳ rồi bấm
/// "Đăng ký mua", HQ thấy trong /admin/plans và liên hệ hướng dẫn chuyển
/// khoản; kế toán "Ghi nhận thanh toán" là yêu cầu tự chuyển DONE. Mỗi khách
/// tối đa MỘT yêu cầu PENDING (gửi lại = cập nhật gói/kỳ trên yêu cầu cũ).
/// planCode/planName/listedPrice là SNAPSHOT lúc gửi — bảng giá đổi sau đó
/// thì HQ vẫn thấy đúng con số khách đã nhìn khi bấm mua.
model PlanUpgradeRequest {
  id       String       @id @default(cuid())
  userId   String
  planId   String
  planCode String
  planName String
  cycle    BillingCycle
  /// Giá niêm yết của (gói, kỳ) tại thời điểm gửi yêu cầu.
  /// 0 = yêu cầu TƯ VẤN (Enterprise "Liên hệ báo giá") — HQ hiện "Báo giá riêng".
  listedPrice Decimal                  @db.Decimal(14, 2)
  /// SĐT khách để lại khi gửi yêu cầu (anh Trung chốt 22/08 khuya: bắt buộc
  /// để HQ gọi lại được) — snapshot riêng, không phụ thuộc khách đổi hồ sơ sau đó.
  contactPhone String?
  status      PlanUpgradeRequestStatus @default(PENDING)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  resolvedAt  DateTime?
  /// Ai đóng yêu cầu — snapshot tên (kế toán ghi nhận / "Khách tự hủy").
  resolvedByName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("plan_upgrade_requests")
}

/// LỊCH SỬ THANH TOÁN GÓI — append-only, không sửa/xoá (chứng từ kế toán).
/// planCode/planName/amount là SNAPSHOT tại thời điểm thu — bảng giá đổi sau
/// đó không ảnh hưởng. Xác nhận thanh toán TỰ SINH: gia hạn Subscription +
/// bút toán THU sổ quỹ (trừ WALLET) + hoa hồng giới thiệu 10%.
model PackagePayment {
  id             String @id @default(cuid())
  subscriptionId String
  userId         String
  planCode       String
  planName       String
  cycle          BillingCycle
  /// Số tiền THỰC THU (kế toán sửa được lúc ghi nhận — khuyến mãi/thu lệch giá niêm yết).
  amount Decimal              @db.Decimal(14, 2)
  method PackagePaymentMethod
  /// Kỳ hạn được cộng nhờ khoản thanh toán này.
  periodStart DateTime
  periodEnd   DateTime
  /// Ngày THỰC NHẬN tiền (kế toán chọn — khớp sao kê ngân hàng).
  occurredAt DateTime @default(now())
  /// Mã giao dịch bên ngoài (webhook cổng thanh toán sau này) — unique chống
  /// ghi trùng khi cổng bắn lặp.
  externalRef String? @unique
  note        String?
  /// Ai xác nhận — snapshot tên để chứng từ còn đọc được khi tài khoản bị xoá.
  confirmedById   String?
  confirmedByName String
  createdAt       DateTime @default(now())

  subscription Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntry  PlatformLedgerEntry?

  @@index([userId, createdAt])
  @@index([occurredAt])
  @@map("package_payments")
}

/// THÔNG BÁO TRONG APP — chuông trên header (Tầng 3 kế hoạch UI).
/// Nguồn phát qua notify() trong src/notifications.ts (ghi DB + đẩy SSE xuống
/// trình duyệt đang mở): OpsAlert mới/tái phát của Trung tâm điều hành, đơn
/// sàn báo hoàn mới… GĐ1 chỉ CHỦ SHOP nhận (type tài chính nhạy cảm); mở rộng
/// cho nhân viên theo cây quyền là nợ ghi trong memory.
model Notification {
  id      String @id @default(cuid())
  ownerId String
  /// Nhóm sự kiện: ops-alert | return | system…
  type    String
  title   String
  body    String?
  /// Deep-link nội bộ frontend (VD /warehouse/returns) — bấm thông báo là tới.
  link    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId, createdAt])
  @@map("notifications")
}

/// NHẬT KÝ CÂU HỎI TRỢ LÝ HUBSELL (thác nước luật-trước-LLM-sau, chốt 16/08).
/// Ghi MỌI câu hỏi ngay từ ngày đầu — mục tiêu số 1 là tiết kiệm token: định kỳ
/// đọc các câu outcome=miss phổ biến để bồi thành intent luật mới (~15'/intent),
/// tầng luật tự nở ra thì tỷ lệ phải đi LLM (gói cao, sau này) tự co lại.
model AssistantQueryLog {
  id      String @id @default(cuid())
  ownerId String
  /// Câu hỏi nguyên văn người dùng gõ (hoặc nhãn chip khi bấm chip hỏi lại).
  question   String
  /// Bản chuẩn hoá không dấu lowercase — gom nhóm câu trùng khi đọc log.
  normalized String
  /// Intent tầng luật đã khớp; null khi miss/analysis (nguyên liệu bồi luật).
  intent String?
  /// answered | clarify | miss | analysis
  outcome   String
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([outcome, createdAt])
  @@map("assistant_query_log")
}

// ============================================================
// CỨU ĐƠN GIAO THẤT BẠI (delivery-fail, 21/08) — tab "Giao không thành công"
// trong Cấu hình kịch bản AI: worker đếm mốc FAILED_DELIVERED trong
// get_tracking_info Shopee, chạm ngưỡng 2 lượt thì phát cảnh báo + (tuỳ chọn)
// tự nhắn khách qua cổng chat sẵn có.
// ============================================================

/// Kết quả auto-chat của một cảnh báo giao thất bại.
enum DeliveryFailChatStatus {
  NONE // chỉ cảnh báo — auto-chat đang tắt lúc phát hiện
  SENT // đã gửi tin nhắn cho khách qua chat sàn
  FAILED // sàn từ chối gửi (khách chặn, hết cửa sổ chat…) — KHÔNG tự retry
  SKIPPED // đơn đã hủy/đang hoàn lúc phát hiện — nhắn khách không còn ý nghĩa
}

/// Kết quả CHỐT của một đơn từng cảnh báo giao thất bại — worker tự chốt từ
/// hành trình vận chuyển (probe 26/08: KHÔNG dựa được vào Order.shippingStatus
/// vì đơn giao xong nằm TO_CONFIRM_RECEIVE→SHIPPING nhiều ngày, kiện quay đầu
/// thì order_status Shopee đứng im ở SHIPPED — thẻ Cứu được/Mất đơn toàn 0 ảo).
enum DeliveryFailOutcome {
  PENDING // còn trên đường — chờ lượt giao lại
  SAVED // sàn xác nhận giao thành công — đơn được cứu
  LOST // hành trình đã có mốc HOÀN/HỦY — kiện quay đầu
}

/// Cấu hình "Cứu đơn giao thất bại" — 1 dòng/chủ shop. Không có dòng = mặc
/// định: cảnh báo BẬT, auto-chat TẮT, template mặc định trong code.
model DeliveryFailConfig {
  id      String @id @default(cuid())
  ownerId String @unique
  /// Bật chuông + thẻ Trung tâm điều hành khi phát hiện đơn chạm ngưỡng.
  alertEnabled Boolean @default(true)
  /// Tự nhắn khách qua chat sàn ngay khi phát hiện (cổng chờ nối chat —
  /// mặc định TẮT, chủ shop tin thì bật).
  autoChatEnabled Boolean @default(false)
  /// Mẫu tin nhắn gửi khách. Rỗng = dùng template mặc định trong code.
  /// Biến: {ten_khach} {ma_don} {ten_san_pham}.
  chatTemplate String  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("delivery_fail_config")
}

/// Loại việc trong hàng đợi hỏi tracking của Cứu đơn giao thất bại.
enum DeliveryTrackingTaskKind {
  DETECT // đơn SHIPPING chưa cảnh báo — dò lượt giao thất bại
  OUTCOME // đơn ĐÃ cảnh báo — chốt kết quả cứu được / mất đơn
}

/// HÀNG ĐỢI hỏi get_tracking_info (26/08, cùng khuôn StockPushJob) — thay hai
/// Map in-memory (mất khi restart) bằng vé bền trong DB: mỗi đơn MỘT vé
/// (orderId unique), worker mỗi nhịp chỉ nhặt vé ĐẾN HẠN (nextRunAt) theo trần
/// call/gian — lượng gọi API sàn bị chặn trên tuyệt đối dù có triệu đơn; nhịp
/// hỏi lại từng đơn co giãn theo pha giao (đang đi giao 20', chưa tới pha giao
/// thì thưa) nên real-time đúng chỗ cần mà không đốt quota chỗ không cần.
model DeliveryTrackingTask {
  id        String                   @id @default(cuid())
  channelId String
  orderId   String                   @unique
  kind      DeliveryTrackingTaskKind
  /// Hạn được hỏi tracking lần tới — worker chỉ nhặt vé nextRunAt <= now.
  nextRunAt DateTime  @default(now())
  lastRunAt DateTime?
  /// Lỗi LIÊN TIẾP khi hỏi tracking (reset 0 khi thành công) — quá trần thì
  /// bỏ vé (đơn tách kiện cần package_number là lỗi vĩnh viễn).
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([channelId, nextRunAt])
  @@map("delivery_tracking_tasks")
}

/// Một đơn ĐÃ chạm ngưỡng giao thất bại — orderId unique vừa là chống trùng
/// (mỗi đơn cảnh báo đúng một lần, không đốt quota hỏi lại) vừa là nhật ký UI.
model DeliveryFailNotice {
  id      String @id @default(cuid())
  ownerId String
  orderId String @unique
  /// Số mốc giao thất bại đếm được lúc phát hiện (≥ ngưỡng 2).
  failCount  Int
  detectedAt DateTime @default(now())

  chatStatus DeliveryFailChatStatus @default(NONE)
  /// Kết quả chốt từ tracking (worker re-check định kỳ); đơn hủy/hoàn theo
  /// trạng thái Order vẫn thắng khi hiển thị (mergeDeliveryFailOutcome).
  outcome   DeliveryFailOutcome @default(PENDING)
  outcomeAt DateTime?
  /// Mốc sàn tại thời điểm chốt (audit — vd "LOGISTICS_DELIVERY_DONE").
  outcomeNote String?
  /// Thông điệp lỗi sàn trả khi gửi chat thất bại — hiện trần cho chủ shop.
  chatError String?
  /// Nguyên văn tin đã gửi (audit — template có thể đổi sau này).
  sentMessage String?
  sentAt      DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([ownerId, detectedAt])
  @@map("delivery_fail_notices")
}

// ---------- SỔ KOC — MẠNG LƯỚI KOC & AFFILIATE (nhịp 1, 30/08/2026) ----------
//
// Thay tầng mock của /koc-marketing bằng bảng thật. Nguyên tắc tách 2 nguồn số
// giữ nguyên như thiết kế cũ (frontend/src/components/koc/koc-data.ts):
//   1. SÀN đổ về  : hoa hồng thật từng đơn (Order.affiliateFee, đối soát) +
//      danh tính KOC theo đơn qua IMPORT file "Báo cáo chuyển đổi" TTLK người
//      bán (KocOrderAttribution) — API seller không trả danh tính creator.
//   2. SELLER nhập: phiếu hàng mẫu (KocSampleShipment) + chi booking (KocExpense).
// Net-ROI/lãi ròng từng KOC là chỉ số DẪN XUẤT tính ở backend (routes/koc.ts,
// dựa computePnlRow) — không bảng nào lưu số dẫn xuất.
// KHÁC HOÀN TOÀN cụm "Affiliate Tiếp Thị" (referral của chính Hubsell).

/// Trạng thái hợp tác với một KOC
enum KocPartnerStatus {
  ACTIVE      // đang hợp tác
  PAUSED      // tạm dừng
  BLACKLISTED // bùng mẫu / vi phạm — chặn tạo phiếu mẫu mới
}

/// Vòng đời phiếu hàng mẫu. "Quá hạn" KHÔNG phải một trạng thái — suy từ
/// WAITING + now > postDeadlineAt (đỡ cần job chuyển trạng thái, không bao
/// giờ lệch đồng hồ); BURNED là xác nhận CỦA CHỦ SHOP sau khi quá hạn.
enum KocSampleStatus {
  WAITING // đã gửi mẫu, chờ KOC lên bài
  POSTED  // đã đăng content (kèm link nếu có)
  BURNED  // chủ shop xác nhận bùng — mất mẫu
}

enum KocExpenseKind {
  BOOKING      // booking lẻ một KOC
  MCN_CONTRACT // hợp đồng MCN trọn gói
}

enum KocExpenseState {
  PAID    // đã chi
  PENDING // chưa chi (dueDate = hạn thanh toán)
}

/// Hồ sơ một KOC trong mạng lưới của chủ shop
model KocPartner {
  id        String           @id @default(cuid())
  ownerId   String
  name      String
  /// Handle kênh — "@linhchi.daily"; trống nếu chưa rõ
  handle    String           @default("")
  /// Sàn hoạt động chính (badge hiển thị) — KOC đa sàn chọn sàn chủ lực
  platform  ChannelName      @default(SHOPEE)
  followers Int              @default(0)
  /// Liên hệ (SĐT/Zalo/email) — seller tự nhập, phục vụ chính họ
  contact   String           @default("")
  note      String           @default("")
  status    KocPartnerStatus @default(ACTIVE)
  createdAt DateTime         @default(now())

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  samples      KocSampleShipment[]
  expenses     KocExpense[]
  attributions KocOrderAttribution[]

  // Import file AMS auto-tạo KOC theo tên đối tác — unique để chạy lặp idempotent.
  @@unique([ownerId, name])
  @@index([ownerId, status])
  @@map("koc_partners")
}

/// Phiếu xuất hàng mẫu cho KOC
model KocSampleShipment {
  id          String          @id @default(cuid())
  ownerId     String
  kocId       String
  /// SKU kho vật lý nếu chọn từ kho (trừ tồn + ghi InventoryLog EXPORT);
  /// NULL = mẫu ngoài kho (nhập tay tên + giá trị)
  productId   String?
  sku         String          @default("")
  productName String
  qty         Int
  /// Giá vốn/đơn vị TẠI THỜI ĐIỂM XUẤT — chốt cứng, đổi giá vốn sau không làm
  /// lệch chi phí mẫu lịch sử
  unitCost    Decimal         @default(0) @db.Decimal(12, 2)
  cost        Decimal         @default(0) @db.Decimal(12, 2)
  exportedAt  DateTime        @default(now())
  /// Hạn lên bài — mặc định +14 ngày theo chuẩn Sample Integrity TikTok, cho sửa
  postDeadlineAt DateTime
  status      KocSampleStatus @default(WAITING)
  postedAt    DateTime?
  /// Link content khi POSTED — bằng chứng nghiệm thu seeding
  contentUrl  String          @default("")
  /// Phiếu này có trừ kho vật lý lúc xuất không (để biết đường hoàn tác)
  deductedStock Boolean       @default(false)
  note        String          @default("")

  koc     KocPartner @relation(fields: [kocId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, postDeadlineAt])
  @@map("koc_sample_shipments")
}

/// Khoản chi booking/hợp đồng MCN cho KOC — bảng RIÊNG, KHÔNG tự ghi sang
/// Thu chi vận hành (seller có thể đã nhập bên đó — tự ghi là đếm đôi chi phí;
/// UI ghi chú rõ, tích hợp 2 sổ để nhịp sau khi có ý kiến người dùng thật).
model KocExpense {
  id           String          @id @default(cuid())
  ownerId      String
  /// NULL = khoản không gắn 1 KOC cụ thể (hợp đồng MCN nhiều KOC)
  kocId        String?
  /// Tên hiển thị khi không gắn KOC ("MCN VieNetwork (5 KOC)")
  displayName  String          @default("")
  contractCode String          @default("")
  kind         KocExpenseKind  @default(BOOKING)
  amount       Decimal         @db.Decimal(14, 2)
  /// PENDING = hạn thanh toán; PAID = ngày đã chi
  dueDate      DateTime?
  state        KocExpenseState @default(PAID)
  note         String          @default("")
  createdAt    DateTime        @default(now())

  koc KocPartner? @relation(fields: [kocId], references: [id], onDelete: SetNull)

  @@index([ownerId, state])
  @@map("koc_expenses")
}

/// Cầu nối ĐƠN HÀNG ↔ KOC — nguồn danh tính duy nhất hiện có là file "Báo cáo
/// chuyển đổi" TTLK người bán (xuất từ web Seller Center) hoặc gán tay.
/// orderId UNIQUE: attribution last-click, 1 đơn thuộc đúng 1 KOC.
model KocOrderAttribution {
  id         String   @id @default(cuid())
  ownerId    String
  orderId    String   @unique
  kocId      String
  /// AMS_IMPORT (từ file) | MANUAL (gán tay)
  source     String   @default("AMS_IMPORT")
  /// Hoa hồng theo file sàn — đối chiếu với Order.affiliateFee từ đối soát
  commission Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  koc   KocPartner @relation(fields: [kocId], references: [id], onDelete: Cascade)

  @@index([kocId])
  @@index([ownerId])
  @@map("koc_order_attributions")
}
