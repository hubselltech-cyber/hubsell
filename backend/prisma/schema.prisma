// Prisma schema — định nghĩa cấu trúc database cho Hubsell
// Tài liệu: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUM ----------

enum ChannelName {
  SHOPEE
  LAZADA
  TIKTOK
  OFFLINE
}

/// Vòng đời đơn hàng TMĐT.
///
/// PROCESSED là mốc chống in trùng và đóng gói lặp: đơn đã được xác nhận và
/// chuẩn bị xong nhưng CHƯA bàn giao cho shipper. Thiếu mốc này thì đơn vừa
/// xác nhận đã nhảy thẳng sang "Đang giao", nhân viên khác nhìn vào tưởng hàng
/// đã đi rồi, hoặc ngược lại vào in lại phiếu của đơn người kia đang gói.
enum ShippingStatus {
  PENDING // Chờ xử lý — đơn mới đồng bộ từ sàn về
  PROCESSED // Đã xử lý — đã xác nhận, đang/đã đóng gói, chờ bàn giao
  SHIPPING // Đang giao — đã bàn giao cho đơn vị vận chuyển
  DELIVERED // Đã giao thành công
  CANCELLED // Hủy / hoàn trả
}

/// Tình trạng hàng hoàn về kho (RTS — Return To Seller).
///
/// Tách khỏi shippingStatus vì đây là hai trục khác nhau: đơn có thể đã HỦY từ
/// lâu (trục vận chuyển) nhưng kiện hàng vẫn đang trên đường quay về (trục
/// hoàn). Gộp chung thì không biết đơn nào đã thực sự cầm được hàng trong tay.
enum ReturnStatus {
  NONE // không phải đơn hoàn
  AWAITING // đang chờ hàng quay về kho
  RECEIVED_INTACT // đã nhận, hàng nguyên vẹn — ĐÃ cộng lại tồn kho
  DAMAGED // hư hỏng / mất / tráo hàng — KHÔNG cộng kho, chờ khiếu nại
  CLAIM_SETTLED // khiếu nại THẮNG — sàn/bưu cục đã đền bù
  WRITTEN_OFF // khiếu nại THUA — shop chịu hao hụt, tính vào lỗ
}

/// Đơn vị vận chuyển. Mỗi sàn thường dùng vài hãng, shop cần lọc theo hãng để
/// gom đơn giao cho đúng shipper khi họ đến lấy hàng.
enum Carrier {
  SPX // Shopee Express
  GHTK // Giao Hàng Tiết Kiệm
  GHN // Giao Hàng Nhanh
  JT // J&T Express
  VIETTEL_POST
  NINJA_VAN
  BEST // BEST Express
  KHAC // hãng khác / shop tự giao
}

enum InventoryLogType {
  IMPORT // Nhập kho
  EXPORT // Xuất kho
  SYNC   // Đồng bộ với sàn
}

enum ExpenseCategory {
  RENT      // Tiền mặt bằng
  SALARY    // Tiền nhân viên
  PACKAGING // Tiền đóng gói
  ADS       // Tiền quảng cáo sàn
  OTHER     // Chi phí khác
}

enum ExpenseType {
  FIXED    // Chi phí cố định (mặt bằng, lương...)
  VARIABLE // Chi phí biến đổi (quảng cáo, đóng gói...)
}

/// Trạng thái khiếu nại chênh lệch phí vận chuyển với sàn
enum ShippingDisputeStatus {
  CHO_KHIEU_NAI  // phát hiện lệch, chưa gửi khiếu nại
  DANG_KHIEU_NAI // đã gửi khiếu nại, đang chờ sàn xử lý
  DA_DOI_SOAT    // sàn đã đối soát/hoàn tiền xong
}

/// Vai trò tài khoản — quyết định thấy gì và làm được gì.
enum Role {
  ADMIN     // Chủ shop: toàn quyền, thấy mọi gian hàng và mọi chỉ số tài chính
  SALES     // Nhân viên vận hành: CHỈ các gian hàng được phân công, không thấy giá vốn/lợi nhuận
  WAREHOUSE // Nhân viên kho: thấy đơn của MỌI gian hàng để nhặt/đóng, không thấy tài chính
}

// ---------- BẢNG ----------

/// Người dùng của hệ thống (chủ shop / nhân viên)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(SALES)
  createdAt    DateTime @default(now())

  // Nhân viên thuộc về một chủ shop → dùng chung dữ liệu của shop đó.
  // ownerId = null nghĩa là chính user này là chủ shop.
  ownerId String?
  owner   User?   @relation("ShopStaff", fields: [ownerId], references: [id], onDelete: Cascade)
  staff   User[]  @relation("ShopStaff")

  channels          Channel[]
  products          Product[]
  operatingExpenses OperatingExpense[]

  // Phân quyền theo gian hàng — CHỈ có ý nghĩa với vai trò SALES.
  // Không gán gian nào = SALES đó chưa xem được đơn nào (mặc định đóng, an toàn
  // hơn là mở toàn bộ); ADMIN và WAREHOUSE vốn đã thấy mọi gian nên bỏ qua bảng này.
  staffChannels StaffChannel[] @relation("StaffChannels")
}

/// Kênh bán hàng đã kết nối (Shopee, Lazada, TikTok, Offline)
/// TẦNG 1 — GIAN HÀNG đã kết nối.
/// Một chủ shop có thể có NHIỀU gian hàng trên CÙNG một sàn (Shopee - Shop A,
/// Shopee - Shop B). `channelName` là SÀN, `shopName` mới là gian hàng.
model Channel {
  id          String      @id @default(cuid())
  userId      String
  channelName ChannelName // sàn: SHOPEE / LAZADA / TIKTOK / OFFLINE
  /// Tên gian hàng do chủ shop đặt — thứ phân biệt hai shop trên cùng một sàn.
  /// Mọi báo cáo phải hiển thị tên này, đừng gom theo channelName không thôi.
  shopName    String
  /// Id gian hàng bên phía sàn, để dành cho khi có tích hợp API thật
  externalShopId String?
  apiToken    String?
  status      String      @default("ACTIVE") // ví dụ: ACTIVE, DISCONNECTED
  // % phí sàn mặc định dùng để TẠM TÍNH lợi nhuận khi đơn chưa được quyết toán.
  // VD: 0.12 = 12%. Có thể chỉnh riêng cho từng gian hàng.
  feeRate     Decimal     @default(0) @db.Decimal(5, 4)
  createdAt   DateTime    @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  channelProducts ChannelProduct[]
  staffAccess     StaffChannel[]

  @@unique([userId, channelName, shopName]) // không trùng tên gian trong cùng sàn
  @@index([userId])
}

/// Phân quyền gian hàng cho nhân viên: nhân viên (staffId) được gán vào kênh
/// (channelId). Sự TỒN TẠI của bản ghi = nhân viên được phân công gian này (dùng
/// để lọc tầm nhìn dữ liệu ở channel-filter). Bốn cờ bên dưới tinh chỉnh nhân
/// viên được làm GÌ trong gian đó — bật/tắt độc lập từng chức năng.
///
/// Mặc định `true` để dữ liệu cũ (đã phân công trước khi có phân quyền chi tiết)
/// giữ nguyên toàn quyền như trước, không bị mất quyền âm thầm sau khi nâng cấp.
model StaffChannel {
  id        String @id @default(cuid())
  staffId   String
  channelId String

  canFinance   Boolean @default(true) // Tài chính — xem doanh thu/dòng tiền của gian
  canWarehouse Boolean @default(true) // Kho hàng — nhặt/đóng/đối soát hàng hoàn
  canAds       Boolean @default(true) // Quảng cáo — số liệu & tối ưu quảng cáo
  canOrders    Boolean @default(true) // Đơn hàng — xử lý đơn của gian

  staff   User    @relation("StaffChannels", fields: [staffId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([staffId, channelId])
  @@index([staffId])
}

/// Sản phẩm trong kho
model Product {
  id              String   @id @default(cuid())
  userId          String
  skuCode         String
  productName     String
  costPrice       Decimal  @default(0) @db.Decimal(12, 2) // giá vốn (cấu hình ở trang Cấu hình Giá vốn)
  sellingPrice    Decimal  @default(0) @db.Decimal(12, 2) // giá bán
  quantityInStock Int      @default(0)
  imageUrl        String? // ảnh sản phẩm (tuỳ chọn)

  // ── Thuế & Hóa đơn điện tử (module đang dựng khung — GIỮ CHỖ) ──
  // Tên sản phẩm in trên hóa đơn có thể khác tên bán hàng (theo danh mục hàng hóa).
  taxName String?
  // % thuế suất GTGT đầu ra của SKU: 0 / 5 / 8 / 10. Lưu tĩnh khi user cấu hình,
  // module hóa đơn/đối soát thuế sau này sẽ đọc để tính VAT đầu ra.
  vatRate Int @default(0)

  createdAt       DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]
  channelProducts ChannelProduct[]
  orderItems    OrderItem[]

  @@unique([userId, skuCode]) // mỗi user không trùng mã SKU
  @@index([userId])
}

/// Đơn hàng thuộc về một kênh bán
model Order {
  id             String   @id @default(cuid())
  channelId      String
  orderCode      String
  customerName   String
  // Số điện thoại khách — dùng để tra cứu nhanh khi khách gọi hỏi đơn.
  // Cho phép trống vì đơn cũ đồng bộ về trước đây không có trường này.
  customerPhone  String?
  totalAmount    Decimal  @default(0) @db.Decimal(12, 2)

  // ===== VẬN CHUYỂN =====
  // Đơn vị vận chuyển (SPX, GHTK, J&T…) và mã vận đơn để in phiếu giao hàng.
  // Trống = sàn chưa gán đơn vị vận chuyển cho đơn này.
  carrier      Carrier?
  trackingCode String?
  // Đã bấm "Xác nhận chuẩn bị hàng" chưa — mốc giữa lúc đơn về và lúc bàn giao
  // cho shipper, để chủ shop biết đơn nào đã đóng gói xong mà chưa ai đến lấy.
  packedAt DateTime?
  // Đã in phiếu giao hàng chưa. Đây là chốt chặn IN TRÙNG: nhiều nhân viên
  // cùng soát đơn thì người sau nhìn vào biết ngay phiếu đã được in, khỏi in
  // lại và gói lại đơn người khác đang làm.
  labelPrintedAt DateTime?

  // Số DÒNG HÀNG của đơn (đếm OrderItem, không phải tổng số lượng).
  // Lưu sẵn ở đây thay vì đếm quan hệ mỗi lần truy vấn, vì Prisma không lọc
  // được theo số lượng bản ghi con — mà kho cần lọc "đơn 1 sản phẩm" (dễ đóng,
  // làm trước) tách khỏi "đơn nhiều sản phẩm" (khó đóng, làm sau).
  // An toàn để lưu trùng: đơn ở Hubsell không sửa được dòng hàng sau khi tạo.
  itemCount Int @default(0)

  // ===== HÀNG HOÀN VỀ KHO (RTS) =====
  returnStatus ReturnStatus @default(NONE)
  returnNote   String? // ghi chú tình trạng kiện hàng khi nhận (vỡ, thiếu, bị tráo…)
  returnedAt   DateTime? // thời điểm kho xác nhận đã cầm hàng trên tay

  /// Số tiền bưu cục/sàn đã đền cho kiện hàng hỏng hoặc mất.
  ///
  /// Chỉ có giá trị khi returnStatus = CLAIM_SETTLED. Thua kiện (WRITTEN_OFF)
  /// thì bằng 0 — phần đó là hao hụt shop chịu.
  ///
  /// Đây là TIỀN THU VỀ, không phải hàng: module Tài chính dùng số này để hạch
  /// toán dòng tiền bồi thường. Đừng nhầm sang tồn kho — hàng đã hỏng/mất thật.
  compensationAmount Decimal @default(0) @db.Decimal(12, 2)

  /// Thời điểm SÀN báo đơn bắt đầu hoàn. Đây là mốc đếm ngược để đối soát:
  /// quá 7 ngày chưa quét trúng thì cảnh báo, quá 14 ngày thì coi như chưa về
  /// tay và làm căn cứ khiếu nại bưu cục.
  ///
  /// Để null khi KHÔNG BIẾT mốc này (đơn hoàn có từ trước khi hệ thống ghi
  /// nhận). Cố ý không lấy tạm createdAt để lấp chỗ trống: số ngày chờ là căn
  /// cứ đòi tiền bưu cục, bịa mốc ra là đi khiếu nại bằng số liệu sai.
  returnRequestedAt DateTime?

  /// CHỐT CHẶN CỘNG KHO TRÙNG.
  ///
  /// Tồn kho của một đơn chỉ được cộng lại ĐÚNG MỘT LẦN, dù đi qua đường nào:
  /// hủy đơn trước khi giao, hay nhận hàng hoàn về sau khi giao. Không có mốc
  /// này thì đơn bị hủy (đã cộng kho) mà nhân viên còn quét nhận hoàn nữa là
  /// kho phình ảo — bán ra hàng không có thật, đúng kiểu mất tiền âm thầm.
  stockRestoredAt DateTime?
  paymentStatus  String   @default("UNPAID")  // ví dụ: UNPAID, PAID, REFUNDED
  shippingStatus ShippingStatus @default(PENDING)
  createdAt      DateTime @default(now())

  // ===== PHÍ SÀN 2 GIAI ĐOẠN =====
  // GĐ1 — TẠM TÍNH: khi đơn mới về, lấy % mặc định của kênh để ước tính.
  platformFee Decimal @default(0) @db.Decimal(12, 2) // phí sàn TẠM TÍNH

  // GĐ2 — QUYẾT TOÁN: khi đơn hoàn tất, sàn trả về số liệu tài chính THỰC TẾ.
  // Các trường này ghi đè số tạm tính khi lên báo cáo dòng tiền.
  isSettled       Boolean   @default(false) // đã được sàn quyết toán/giải ngân chưa
  settledAt       DateTime? // thời điểm quyết toán
  fixedFee        Decimal   @default(0) @db.Decimal(12, 2) // phí cố định
  serviceFee      Decimal   @default(0) @db.Decimal(12, 2) // phí dịch vụ
  paymentFee      Decimal   @default(0) @db.Decimal(12, 2) // phí thanh toán
  affiliateFee    Decimal   @default(0) @db.Decimal(12, 2) // phí tiếp thị liên kết (Affiliate)
  sellerVoucher   Decimal   @default(0) @db.Decimal(12, 2) // voucher trợ giá do SHOP tự chịu
  // --- Phí vận chuyển & đối soát khiếu nại ---
  shippingFeeQuoted Decimal @default(0) @db.Decimal(12, 2) // phí ship SÀN BÁO lúc đặt đơn
  shippingFeeActual Decimal @default(0) @db.Decimal(12, 2) // phí ship THỰC TẾ sàn trừ khi quyết toán
  // Chênh lệch = thực tế − sàn báo. LƯU DƯƠNG = số tiền shop bị trừ thêm (cần đòi lại).
  shippingFeeDiff   Decimal @default(0) @db.Decimal(12, 2)
  shippingDisputeStatus ShippingDisputeStatus @default(CHO_KHIEU_NAI)
  platformSubsidy Decimal   @default(0) @db.Decimal(12, 2) // trợ giá từ SÀN (giảm chi phí cho shop)
  actualPayout    Decimal   @default(0) @db.Decimal(12, 2) // tiền thực nhận về ví

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[] // các lần trừ/hoàn kho gắn với đơn này
  items         OrderItem[] // chi tiết dòng sản phẩm trong đơn

  @@index([channelId])
}

/// Chi tiết dòng sản phẩm của một đơn hàng.
/// costPriceAtSale = GIÁ VỐN GỐC tại thời điểm phát sinh đơn (snapshot) —
/// dù sau này giá vốn sản phẩm thay đổi, báo cáo lãi/lỗ của đơn cũ vẫn chính xác.
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String? // sản phẩm gốc (SetNull nếu sản phẩm bị xoá)
  channelSku      String // SKU trên sàn
  productName     String // tên sản phẩm tại thời điểm bán
  quantity        Int
  price           Decimal @db.Decimal(12, 2) // giá bán tại thời điểm phát sinh đơn
  costPriceAtSale Decimal @default(0) @db.Decimal(12, 2) // giá vốn gốc tại thời điểm phát sinh đơn

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

/// Liên kết (mapping): một Sản phẩm kho gốc ↔ nhiều SKU trên các sàn.
/// Ví dụ: "Quần jean nữ ống rộng" (SP002) ↔ Shopee "SH-QUAN-DEN-M" và TikTok "TT-QUAN-JEAN".
/// TẦNG 2 — SẢN PHẨM SÀN (bảng đệm).
///
/// Hứng nguyên trạng danh mục kéo từ từng gian hàng về. Đồng bộ KHÔNG được tạo
/// thẳng Product: tên và mã trên các shop sàn thường lệch nhau, đẩy thẳng vào
/// kho vật lý là sinh rác không dọn nổi.
///
/// `productId = NULL` nghĩa là sản phẩm sàn này CHƯA được liên kết về kho gốc.
/// Nhiều dòng ở đây có thể cùng trỏ về một Product — đó chính là cách 3 gian
/// hàng khác tên map chung một mã gốc.
model ChannelProduct {
  id          String   @id @default(cuid())
  channelId   String // thuộc gian hàng nào
  channelSku  String // mã SKU trên sàn
  productName String // tên hiển thị trên sàn
  variantName String? // phân loại trên sàn (size/màu)
  price       Decimal  @default(0) @db.Decimal(12, 2) // giá niêm yết trên sàn
  imageUrl    String?
  externalId  String? // id sản phẩm bên phía sàn
  status      ChannelProductStatus @default(ACTIVE)
  lastSyncedAt DateTime? // lần cuối kéo về từ sàn
  createdAt   DateTime @default(now())

  /// NULL = chưa liên kết về kho gốc. Đây là cốt lõi của tầng đệm.
  productId String?

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  channel Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, channelSku]) // 1 SKU sàn chỉ nối vào tối đa 1 sản phẩm gốc
  @@index([productId])
  @@index([channelId])
}

/// Sản phẩm còn bán trên sàn hay đã bị gỡ niêm yết.
enum ChannelProductStatus {
  ACTIVE
  DELISTED
}

/// Nhật ký biến động tồn kho
model InventoryLog {
  id             String           @id @default(cuid())
  productId      String
  changeQuantity Int
  type           InventoryLogType
  reason         String?
  orderId        String? // đơn hàng gây ra biến động này (nếu có) — dùng để hoàn kho khi huỷ đơn & tính giá vốn
  createdAt      DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
}

/// Chi phí hoạt động của shop (cố định/biến đổi): mặt bằng, lương, đóng gói, quảng cáo sàn...
/// Dùng để tính Lợi nhuận thuần = Lợi nhuận gộp − Tổng chi phí hoạt động.
model OperatingExpense {
  id          String          @id @default(cuid())
  userId      String // thuộc về chủ shop
  name        String // tên/mô tả khoản chi, ví dụ "Thuê mặt bằng tháng 7"
  category    ExpenseCategory @default(OTHER)
  type        ExpenseType     @default(VARIABLE) // FIXED (cố định) | VARIABLE (biến đổi)
  // Chi phí VARIABLE có thể gắn trực tiếp vào 1 mã SKU (tiền Ads, book KOC...)
  // để tính Lời/Lỗ riêng cho sản phẩm đó. FIXED thì để trống (trừ vào tổng shop).
  appliedSku  String?
  amount      Decimal         @db.Decimal(12, 2)
  note        String?
  expenseDate DateTime        @default(now()) // ngày phát sinh chi phí
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
