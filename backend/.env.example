# Sao chép file này thành .env rồi điền thông tin thật
#
# DATABASE_URL — 2 môi trường:
#  · Local (docker-compose): chuỗi bên dưới, giữ nguyên.
#  · Cloud SUPABASE (Render/production): lấy ở Supabase → Connect → ORMs, dạng
#    Session pooler (cổng 5432, hợp với Prisma) và BẮT BUỘC kèm SSL. Nên kèm
#    connection_limit/pool_timeout: Supabase Free giới hạn ~15 kết nối qua
#    pooler — Prisma mặc định mở theo số CPU, dễ chiếm sạch pool khi webhook +
#    đồng bộ chạy song song. 5 kết nối là đủ cho Render Free (1 instance):
#    postgresql://postgres.<ref>:<MẬT_KHẨU>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=30
DATABASE_URL="postgresql://hubsell:hubsell_dev_password@localhost:5432/hubsell?schema=public"
# Render tự bơm PORT qua env — không cần đặt tay trên cloud; local giữ 4000.
PORT=4000
JWT_SECRET="doi_thanh_chuoi_ngau_nhien_bi_mat"

# URL gốc CÔNG KHAI của backend — nguồn suy ra mọi redirect OAuth / webhook đăng
# ký với sàn (xem src/backend-url.ts). Trên Render KHÔNG cần đặt: code tự đọc
# RENDER_EXTERNAL_URL (vd https://hubsell-backend.onrender.com). Chỉ đặt khi có
# domain riêng. Local bỏ trống = http://localhost:4000.
# BACKEND_URL=""

# ---- Tích hợp TikTok Shop API (App "Dịch vụ tùy chỉnh" trên Partner Center) ----
# Lấy trong Partner Center → App của bạn. KHÔNG commit giá trị thật (file .env đã gitignore).
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
# service_id của app — dùng dựng URL uỷ quyền cho người bán
TIKTOK_SERVICE_ID=""
# Phải TRÙNG KHỚP tuyệt đối Redirect URL đã đăng ký trên Partner Center
TIKTOK_REDIRECT_URI="https://localhost:3000/channels/tiktok/callback"

# ---- HTTPS ở local (tuỳ chọn — cần để test OAuth/webhook TikTok) ----
# Tạo cert: `bash scripts/gen-certs.sh`. Bỏ trống = chạy HTTP.
SSL_KEY_FILE="../certs/localhost-key.pem"
SSL_CERT_FILE="../certs/localhost.pem"

# ---- Tích hợp Shopee Open Platform ----
# Lấy trong Shopee Open Platform Console → App của bạn. KHÔNG commit giá trị thật.
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
# sandbox | production (chọn host API tương ứng). Production đặt "production".
SHOPEE_ENV="sandbox"
# (tuỳ chọn) Ghi đè URL callback OAuth. BỎ TRỐNG = tự suy từ BACKEND_URL /
# RENDER_EXTERNAL_URL (Render ra https://<app>.onrender.com/api/auth/shopee/callback
# — đăng ký đúng domain đó trên Console). Local test sandbox qua trick hosts thì
# đặt "http://hubsell.tech/api/auth/shopee/callback".
# SHOPEE_REDIRECT_URI=""
# (tuỳ chọn) Ghi đè URL webhook Push — là THÀNH PHẦN CHUỖI KÝ nên phải trùng
# TỪNG KÝ TỰ với URL khai trên Console. Bỏ trống = tự suy từ URL gốc backend
# (Render: https://<app>.onrender.com/api/webhook/shopee).
# SHOPEE_WEBHOOK_URL=""
# Push Partner Key — key RIÊNG Shopee dùng ký webhook push (lấy ở Console →
# Push Mechanism → Set Push, KHÁC API Partner Key). Bỏ trống = dùng API key
# (chỉ đúng cho test tự ký; nhận push thật BẮT BUỘC điền).
# SHOPEE_PUSH_PARTNER_KEY=""
# (tuỳ chọn) ghi đè host API của Shopee
# SHOPEE_API_BASE=""

# ---- Hubsell Ads — app "Ads Service" RIÊNG trên Shopee (docs/HUBSELL-ADS.md) ----
# App chính lên ISV (ERP System) mất Ads API → Trợ lý quảng cáo chạy trên app
# Hubsell Ads với partner riêng; gian phải ủy quyền THÊM cho app này. BỎ TRỐNG
# = chưa bật, Trợ lý dùng token app chính như cũ.
# HUBSELL_ADS_PARTNER_ID=""
# HUBSELL_ADS_PARTNER_KEY=""
# sandbox | production — bỏ trống = theo SHOPEE_ENV (đặt "sandbox" để test app
# Ads trong khi app chính đã production).
# HUBSELL_ADS_ENV=""
# (tuỳ chọn) ghi đè callback; bỏ trống = <backend>/api/auth/hubsell-ads/callback
# HUBSELL_ADS_REDIRECT_URI=""
# Nhịp TỰ ĐỘNG đồng bộ đa sàn (phút): đơn Shopee+Lazada mỗi nhịp, đối soát phí
# Lazada mỗi 6 nhịp (~1 giờ). Mặc định 10; "0" = tắt. (SHOPEE_AUTO_SYNC_MINUTES
# cũ vẫn được đọc để tương thích.)
# AUTO_SYNC_MINUTES="10"
# URL frontend để backend redirect về sau callback
APP_FRONTEND_URL="https://localhost:3000"

# ---- Cổng thanh toán payOS (thu tiền gói Hubsell, 09/09/2026) ----
# Lấy 3 khóa ở my.payos.vn → Kênh thanh toán (tài khoản MB doanh nghiệp Hubsell).
# Thiếu bất kỳ khóa nào = cổng TẮT: khách chỉ thấy "Đăng ký mua → HQ liên hệ".
# Sau khi đặt env, đăng ký URL webhook: npx tsx scripts/payos-confirm-webhook.ts
# (hoặc dán https://<backend>/api/webhooks/payos trên my.payos.vn).
# PAYOS_CLIENT_ID=""
# PAYOS_API_KEY=""
# PAYOS_CHECKSUM_KEY=""
# (tùy chọn) mã đối tác chương trình Đối tác tích hợp payOS
# PAYOS_PARTNER_CODE=""
# Nhận diện sản phẩm trên SAO KÊ ngân hàng khi nhiều sản phẩm (Hubsell/Hubtax…)
# cùng nhận tiền một tài khoản: tiền tố in vào nội dung chuyển khoản
# ("HS GROWTH"…). Mỗi sản phẩm = 1 Kênh thanh toán riêng trên my.payos.vn
# (bộ 3 khóa riêng) + 1 tiền tố riêng. Xem docs/PAYOS-KENH-THANH-TOAN.md.
# PAYOS_TRANSFER_PREFIX="HS"
# Trần ký tự nội dung chuyển khoản: 9 khi tài khoản ngân hàng CHƯA liên kết payOS
# (mặc định), đổi thành 25 SAU KHI liên kết xong → nội dung có đủ tên gói + đuôi
# mã đơn ("HS BUSINESS 00000123"), đối chiếu sao kê dễ hơn.
# PAYOS_DESCRIPTION_MAX="9"
# (LOCAL) mở thêm listener HTTP ở cổng này để callback Shopee qua http://hubsell.tech
# tới được (backend chính vẫn HTTPS ở PORT). Bỏ trống = tắt. Test sandbox đặt "80".
# SHOPEE_CALLBACK_HTTP_PORT="80"

# ---- Tích hợp MISA meInvoice (Hóa đơn kê khai) ----
# Lấy ClientID/ClientSecret ở developer.misa.vn → Quản lý ứng dụng → app của bạn
# → Open API → "Hóa đơn điện tử". KHÔNG commit giá trị thật.
# LƯU Ý: mọi API đi qua cổng developer.misa.vn — host testapi.meinvoice.vn KHÔNG dùng.
MISA_API_BASE="https://developer.misa.vn/apis/itg/meinvoice"
MISA_CLIENT_ID=""
MISA_CLIENT_SECRET=""
# Auth: POST /invoice/token — ClientID/ClientSecret ở HEADER, 3 dòng dưới ở BODY.
MISA_TAX_CODE=""
MISA_USERNAME=""
MISA_PASSWORD=""
# Tài khoản sandbox meInvoice (MISA gửi kèm bộ kit) — auth cần đủ bộ này:
# MISA_TAX_CODE=""
# MISA_USERNAME=""
# MISA_PASSWORD=""
# (tuỳ chọn) Secret ký webhook — có thì route BẮT BUỘC kiểm header x-misa-signature
# MISA_WEBHOOK_SECRET=""
# (tuỳ chọn) Biên độ lệch thuế cho phép khi đối soát (đồng) — mặc định 500
# MISA_TAX_TOLERANCE_VND="500"

# ---- MISA meInvoice — HÓA ĐƠN ĐẦU VÀO (dịch vụ riêng, bộ khóa RIÊNG) ----
# Kit "Thông tin tích hợp API — Hóa đơn điện tử đầu vào". Auth 2 bước
# validateUser → jwttoken (xem src/integrations/invoice/misa-inbot.ts).
# Test:  npx tsx scripts/misa-sandbox-test.ts inbot-auth
MISA_INBOT_API_BASE="https://developer.misa.vn/apis"
MISA_INBOT_CLIENT_ID=""
MISA_INBOT_CLIENT_SECRET=""
MISA_INBOT_TAX_CODE=""
MISA_INBOT_USERNAME=""
MISA_INBOT_PASSWORD=""
# Bỏ trống = code TỰ TRA qua /subscribers/code/{taxcode} + /{sub}/organizations.
MISA_INBOT_SUBSCRIBER_ID=""
MISA_INBOT_ORG_ID=""

# ---- CHỐT AN TOÀN PHÁT HÀNH HÓA ĐƠN ----
# ĐỂ TRỐNG = CHẶN mọi lệnh phát hành (mặc định an toàn — xem misa-safety.ts).
# Chỉ đặt "1" khi đã xác nhận môi trường đang trỏ tới được phép phát hành;
# hóa đơn có mã CQT là chứng từ pháp lý, KHÔNG xoá được.
# MISA_ALLOW_PUBLISH=""

# ---- MISA meInvoice POS — HÓA ĐƠN MÁY TÍNH TIỀN (tuỳ chọn) ----
# Cặp khóa RIÊNG cho luồng máy tính tiền nếu MISA cấp tách app; bỏ trống =
# dùng chung MISA_CLIENT_ID/SECRET.
# MISA_POS_CLIENT_ID=""
# MISA_POS_CLIENT_SECRET=""

# ---- MISA eSign — CHỮ KÝ SỐ TỪ XA ----
# Kit "Thông tin tích hợp API — Chữ ký số Esign". Login bằng header
# x-clientId/x-clientKey + tài khoản (xem src/integrations/invoice/misa-esign.ts).
# Test:  npx tsx scripts/misa-sandbox-test.ts esign-auth
# Bỏ trống = https://developer.misa.vn/apis (cổng chung). Header: ClientID/ClientSecret.
MISA_ESIGN_API_BASE=""
MISA_ESIGN_CLIENT_ID=""
MISA_ESIGN_CLIENT_KEY=""
MISA_ESIGN_USERNAME=""
MISA_ESIGN_PASSWORD=""

# Worker bồi đơn tài khoản trial reviewer ISV (gian demo không token). 0 = tắt.
REVIEWER_DEMO_TOPUP_MINUTES="30"
REVIEWER_DEMO_EMAIL="reviewer@hubsell.vn"

# ---- Nhịp quảng cáo (config/ads-cadence.ts, docs/ADS-NHIP-CANH-BAO.md, 12/09/2026) ----
# XUNG ads Shopee (phút): cấu hình campaign + số hôm nay + ví cho gian đang chi tiêu.
# Đây là độ trễ tối đa của cảnh báo "cắn tiền"/"ví cạn". Anh Trung chốt 30.
# ADS_PULSE_MINUTES="30"
# XUNG ads Lazada (phút) — 60 tới khi có quota app ISV.
# ADS_PULSE_LAZADA_MINUTES="60"
# Tầng LỊCH SỬ ads (giờ): kéo lại 7 ngày cho số sàn chỉnh muộn. Mặc định 6.
# ADS_SYNC_HOURS="6"
# Trần call/giây MỖI app cho nhóm Ads API (token bucket, services/api-budget.ts).
# Thận trọng 3 tới khi Shopee trả lời ticket quota. Nhiều worker → chia đều.
# ADS_APP_QPS="3"
