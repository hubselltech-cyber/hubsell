# Sao chép file này thành .env rồi điền thông tin thật
#
# DATABASE_URL — 2 môi trường:
#  · Local (docker-compose): chuỗi bên dưới, giữ nguyên.
#  · Cloud SUPABASE (Render/production): lấy ở Supabase → Connect → ORMs, dạng
#    Session pooler (cổng 5432, hợp với Prisma) và BẮT BUỘC kèm SSL. Nên kèm
#    connection_limit/pool_timeout: Supabase Free giới hạn ~15 kết nối qua
#    pooler — Prisma mặc định mở theo số CPU, dễ chiếm sạch pool khi webhook +
#    đồng bộ chạy song song. 5 kết nối là đủ cho Render Free (1 instance):
#    postgresql://postgres.<ref>:<MẬT_KHẨU>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=30
DATABASE_URL="postgresql://hubsell:hubsell_dev_password@localhost:5432/hubsell?schema=public"
# Render tự bơm PORT qua env — không cần đặt tay trên cloud; local giữ 4000.
PORT=4000
JWT_SECRET="doi_thanh_chuoi_ngau_nhien_bi_mat"

# ---- Mã hóa bí mật trong DB (src/lib/secret-box.ts) ----
# Mật khẩu meInvoice của khách + các khóa NCC hóa đơn được mã hóa AES-256-GCM
# trước khi ghi DB; khóa nằm Ở ĐÂY (env), không nằm trong DB hay repo.
# Dạng "<mã khóa>:<base64 32 byte>"; nhiều khóa cách nhau dấu phẩy — khóa ĐẦU để
# mã hóa, mọi khóa đều giải mã được (xoay khóa). Tạo khóa:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Bỏ trống = ghi chữ thường như trước + cảnh báo lúc khởi động (chỉ chấp nhận ở
# máy dev). MẤT KHÓA = mọi bí mật đã mã hóa thành rác → cất thêm một bản ở nơi an
# toàn. Đọc docs/BAO-MAT-MA-HOA-BI-MAT.md trước khi đặt trên production.
SECRET_ENC_KEYS=""
# Đặt "1" SAU KHI production đã có khóa và kiểm xong: thiếu khóa là máy chủ từ
# chối khởi động / từ chối lưu bí mật, thay vì lặng lẽ ghi chữ thường.
# SECRET_ENC_REQUIRED="1"

# URL gốc CÔNG KHAI của backend — nguồn suy ra mọi redirect OAuth / webhook đăng
# ký với sàn (xem src/backend-url.ts). Trên Render KHÔNG cần đặt: code tự đọc
# RENDER_EXTERNAL_URL (vd https://hubsell-backend.onrender.com). Chỉ đặt khi có
# domain riêng. Local bỏ trống = http://localhost:4000.
# BACKEND_URL=""

# ---- Tích hợp TikTok Shop API (App "Dịch vụ tùy chỉnh" trên Partner Center) ----
# Lấy trong Partner Center → App của bạn. KHÔNG commit giá trị thật (file .env đã gitignore).
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
# service_id của app — dùng dựng URL uỷ quyền cho người bán
TIKTOK_SERVICE_ID=""
# Phải TRÙNG KHỚP tuyệt đối Redirect URL đã đăng ký trên Partner Center
TIKTOK_REDIRECT_URI="https://localhost:3000/channels/tiktok/callback"

# ---- TikTok Ads — app RIÊNG trên TikTok Marketing API (business-api.tiktok.com), quảng cáo GMV Max ----
# My Apps → Hubsell → Basic Information. Khác hẳn TIKTOK_APP_KEY (TikTok Shop Partner API) ở trên.
TIKTOK_ADS_APP_ID=""
TIKTOK_ADS_SECRET=""
# Bỏ trống = https://app.hubsell.tech/ads/tiktok/callback (đúng Redirect URL đã khai trên portal)
# TIKTOK_ADS_REDIRECT_URI=""

# ---- HTTPS ở local (tuỳ chọn — cần để test OAuth/webhook TikTok) ----
# Tạo cert: `bash scripts/gen-certs.sh`. Bỏ trống = chạy HTTP.
SSL_KEY_FILE="../certs/localhost-key.pem"
SSL_CERT_FILE="../certs/localhost.pem"

# ---- Tích hợp Shopee Open Platform ----
# Lấy trong Shopee Open Platform Console → App của bạn. KHÔNG commit giá trị thật.
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
# sandbox | production (chọn host API tương ứng). Production đặt "production".
SHOPEE_ENV="sandbox"
# (tuỳ chọn) Ghi đè URL callback OAuth. BỎ TRỐNG = tự suy từ BACKEND_URL /
# RENDER_EXTERNAL_URL (Render ra https://<app>.onrender.com/api/auth/shopee/callback
# — đăng ký đúng domain đó trên Console). Local test sandbox qua trick hosts thì
# đặt "http://hubsell.tech/api/auth/shopee/callback".
# SHOPEE_REDIRECT_URI=""
# (tuỳ chọn) Ghi đè URL webhook Push — là THÀNH PHẦN CHUỖI KÝ nên phải trùng
# TỪNG KÝ TỰ với URL khai trên Console. Bỏ trống = tự suy từ URL gốc backend
# (Render: https://<app>.onrender.com/api/webhook/shopee).
# SHOPEE_WEBHOOK_URL=""
# Push Partner Key — key RIÊNG Shopee dùng ký webhook push (lấy ở Console →
# Push Mechanism → Set Push, KHÁC API Partner Key). Bỏ trống = dùng API key
# (chỉ đúng cho test tự ký; nhận push thật BẮT BUỘC điền).
# SHOPEE_PUSH_PARTNER_KEY=""
# (tuỳ chọn) ghi đè host API của Shopee
# SHOPEE_API_BASE=""

# ---- Hubsell Ads — app "Ads Service" RIÊNG trên Shopee (docs/HUBSELL-ADS.md) ----
# App chính lên ISV (ERP System) mất Ads API → Trợ lý quảng cáo chạy trên app
# Hubsell Ads với partner riêng; gian phải ủy quyền THÊM cho app này. BỎ TRỐNG
# = chưa bật, Trợ lý dùng token app chính như cũ.
# HUBSELL_ADS_PARTNER_ID=""
# HUBSELL_ADS_PARTNER_KEY=""
# sandbox | production — bỏ trống = theo SHOPEE_ENV (đặt "sandbox" để test app
# Ads trong khi app chính đã production).
# HUBSELL_ADS_ENV=""
# (tuỳ chọn) ghi đè callback; bỏ trống = <backend>/api/auth/hubsell-ads/callback
# HUBSELL_ADS_REDIRECT_URI=""
# Nhịp gốc tầng NHANH của worker quét sàn (phút): đơn/hoàn/cứu đơn theo LỊCH TỪNG
# GIAN, giãn ×2 khi gian im ắng tới AUTO_SYNC_MAX_MINUTES (60). Đối soát phí mỗi
# giờ, ads theo ADS_* bên dưới. Mặc định 10; "0" = tắt. (SHOPEE_AUTO_SYNC_MINUTES
# cũ vẫn được đọc để tương thích.)
# AUTO_SYNC_MINUTES="10"
# URL frontend để backend redirect về sau callback
APP_FRONTEND_URL="https://localhost:3000"

# ---- Tài khoản nhận tiền gói (chuyển khoản tay, 17/09/2026) ----
# Đủ 3 biến thì /settings/plan + popup nâng gói hiện hướng dẫn chuyển khoản.
# Phải trùng số in ở trang /payment của landing (hubsell-landing/src/lib/site.ts).
# PLAN_PAYMENT_BANK_NAME="MB Bank (Ngân hàng Quân đội)"
# PLAN_PAYMENT_BANK_ACCOUNT="55995995995"
# PLAN_PAYMENT_BANK_HOLDER="CONG TY TNHH CONG NGHE HUBSELL"

# ---- Cổng thanh toán payOS (thu tiền gói Hubsell, 09/09/2026) ----
# Lấy 3 khóa ở my.payos.vn → Kênh thanh toán (tài khoản MB doanh nghiệp Hubsell).
# Thiếu bất kỳ khóa nào = cổng TẮT: khách chỉ thấy "Đăng ký mua → HQ liên hệ".
# Sau khi đặt env, đăng ký URL webhook: npx tsx scripts/payos-confirm-webhook.ts
# (hoặc dán https://<backend>/api/webhooks/payos trên my.payos.vn).
# PAYOS_CLIENT_ID=""
# PAYOS_API_KEY=""
# PAYOS_CHECKSUM_KEY=""
# (tùy chọn) mã đối tác chương trình Đối tác tích hợp payOS
# PAYOS_PARTNER_CODE=""
# Nhận diện sản phẩm trên SAO KÊ ngân hàng khi nhiều sản phẩm (Hubsell/Hubtax…)
# cùng nhận tiền một tài khoản: tiền tố in vào nội dung chuyển khoản
# ("HS GROWTH"…). Mỗi sản phẩm = 1 Kênh thanh toán riêng trên my.payos.vn
# (bộ 3 khóa riêng) + 1 tiền tố riêng. Xem docs/PAYOS-KENH-THANH-TOAN.md.
# PAYOS_TRANSFER_PREFIX="HS"
# Trần ký tự nội dung chuyển khoản: 9 khi tài khoản ngân hàng CHƯA liên kết payOS
# (mặc định), đổi thành 25 SAU KHI liên kết xong → nội dung có đủ tên gói + đuôi
# mã đơn ("HS BUSINESS 00000123"), đối chiếu sao kê dễ hơn.
# PAYOS_DESCRIPTION_MAX="9"
# (LOCAL) mở thêm listener HTTP ở cổng này để callback Shopee qua http://hubsell.tech
# tới được (backend chính vẫn HTTPS ở PORT). Bỏ trống = tắt. Test sandbox đặt "80".
# SHOPEE_CALLBACK_HTTP_PORT="80"

# ---- Tích hợp MISA meInvoice (Hóa đơn kê khai) ----
# Lấy ClientID/ClientSecret ở developer.misa.vn → Quản lý ứng dụng → app của bạn
# → Open API → "Hóa đơn điện tử". KHÔNG commit giá trị thật.
# LƯU Ý: mọi API đi qua cổng developer.misa.vn — host testapi.meinvoice.vn KHÔNG dùng.
MISA_API_BASE="https://developer.misa.vn/apis/itg/meinvoice"
MISA_CLIENT_ID=""
MISA_CLIENT_SECRET=""
# Auth: POST /invoice/token — ClientID/ClientSecret ở HEADER, 3 dòng dưới ở BODY.
MISA_TAX_CODE=""
MISA_USERNAME=""
MISA_PASSWORD=""
# Tài khoản sandbox meInvoice (MISA gửi kèm bộ kit) — auth cần đủ bộ này:
# MISA_TAX_CODE=""
# MISA_USERNAME=""
# MISA_PASSWORD=""
# (tuỳ chọn) Secret ký webhook — có thì route BẮT BUỘC kiểm header x-misa-signature
# MISA_WEBHOOK_SECRET=""
# (tuỳ chọn) Biên độ lệch thuế cho phép khi đối soát (đồng) — mặc định 500
# MISA_TAX_TOLERANCE_VND="500"

# ---- MISA meInvoice — HÓA ĐƠN ĐẦU VÀO (dịch vụ riêng, bộ khóa RIÊNG) ----
# Kit "Thông tin tích hợp API — Hóa đơn điện tử đầu vào". Auth 2 bước
# validateUser → jwttoken (xem src/integrations/invoice/misa-inbot.ts).
# Test:  npx tsx scripts/misa-sandbox-test.ts inbot-auth
MISA_INBOT_API_BASE="https://developer.misa.vn/apis"
MISA_INBOT_CLIENT_ID=""
MISA_INBOT_CLIENT_SECRET=""
MISA_INBOT_TAX_CODE=""
MISA_INBOT_USERNAME=""
MISA_INBOT_PASSWORD=""
# Bỏ trống = code TỰ TRA qua /subscribers/code/{taxcode} + /{sub}/organizations.
MISA_INBOT_SUBSCRIBER_ID=""
MISA_INBOT_ORG_ID=""

# ---- CHỐT AN TOÀN PHÁT HÀNH HÓA ĐƠN ----
# ĐỂ TRỐNG = CHẶN mọi lệnh phát hành (mặc định an toàn — xem misa-safety.ts).
# Chỉ đặt "1" khi đã xác nhận môi trường đang trỏ tới được phép phát hành;
# hóa đơn có mã CQT là chứng từ pháp lý, KHÔNG xoá được.
# MISA_ALLOW_PUBLISH=""

# ---- MISA meInvoice POS — HÓA ĐƠN MÁY TÍNH TIỀN (tuỳ chọn) ----
# Cặp khóa RIÊNG cho luồng máy tính tiền nếu MISA cấp tách app; bỏ trống =
# dùng chung MISA_CLIENT_ID/SECRET.
# MISA_POS_CLIENT_ID=""
# MISA_POS_CLIENT_SECRET=""

# ---- MISA eSign — CHỮ KÝ SỐ TỪ XA ----
# Kit "Thông tin tích hợp API — Chữ ký số Esign". Login bằng header
# x-clientId/x-clientKey + tài khoản (xem src/integrations/invoice/misa-esign.ts).
# Test:  npx tsx scripts/misa-sandbox-test.ts esign-auth
# Bỏ trống = https://developer.misa.vn/apis (cổng chung). Header: ClientID/ClientSecret.
MISA_ESIGN_API_BASE=""
MISA_ESIGN_CLIENT_ID=""
MISA_ESIGN_CLIENT_KEY=""
MISA_ESIGN_USERNAME=""
MISA_ESIGN_PASSWORD=""

# Cổng chặn chat Shopee (integrations/shopee/chat-gate.ts, 15/09/2026): app ISV/ERP
# System không có Chat API → gặp error_api_permission thì ngưng gọi sellerchat
# trong N phút rồi tự thử lại (sàn cấp quyền là tự thông). 0 = tắt cổng.
SHOPEE_CHAT_DENIED_TTL_MINUTES="360"

# ---- Nhịp quảng cáo (config/ads-cadence.ts, docs/ADS-NHIP-CANH-BAO.md, 12/09/2026) ----
# XUNG ads Shopee (phút): cấu hình campaign + số hôm nay + ví cho gian đang chi tiêu.
# Đây là độ trễ tối đa của cảnh báo "cắn tiền"/"ví cạn". Anh Trung chốt 30.
# ADS_PULSE_MINUTES="30"
# XUNG ads Lazada (phút) — 60 tới khi có quota app ISV.
# ADS_PULSE_LAZADA_MINUTES="60"

# Lazada app ISV (14/09/2026): seller phải đăng ký gói Hubsell trên Service
# Marketplace trước khi ủy quyền. Link phân phối SKU free — mặc định trong code
# khi LAZADA_APP_KEY=142085; đặt biến này để ghi đè (đổi gói/SKU) hoặc bật
# bước đăng ký cho app khác. Bỏ trống với app in-house.
# LAZADA_SERVICE_SUBSCRIBE_URL="https://marketplace.lazada.vn/web/detail.html?articleCode=FW_GOODS-1000034551&itemCode=FW_GOODS-1000034551-1"
# Tắt chuông nhắc gia hạn kỳ dịch vụ Lazada (mặc định bật, nhắc 14/7/1 ngày trước hạn).
# LAZADA_RENEWAL_REMINDER_OFF="1"
# Tầng LỊCH SỬ ads (giờ): kéo lại 7 ngày cho số sàn chỉnh muộn. Mặc định 6.
# ADS_SYNC_HOURS="6"
# Trần call/giây MỖI app cho nhóm Ads API (token bucket, services/api-budget.ts).
# Thận trọng 3 tới khi Shopee trả lời ticket quota. Nhiều worker → chia đều.
# ADS_APP_QPS="3"
# LÀN ADS RIÊNG (19/10/2026, docs/ADS-NHIP-CANH-BAO.md mục 13 lát 1 — chống lỗi dây chuyền):
# xung + lịch sử ads do worker ads-lane nhặt với vé riêng (Channel.adsLockedAt), không giữ
# chỗ của đồng bộ đơn. "0" = ĐƯỜNG LUI: về vòng đồng bộ đơn như trước 19/10.
# ADS_LANE="1"
# Số gian chạy xung/lịch sử ads song song trong một worker (tự chọn, đo lại mốc Đ1/Đ2).
# ADS_CONCURRENCY="2"
# Vé làn Ads cũ hơn N phút = worker chết → nhặt lại (lượt ngày TikTok dài nên rộng hơn 15' của đơn).
# ADS_LOCK_STALE_MINUTES="30"
# Bão 429: số gian dính phải ≥ tỷ lệ này trong số gian đã gọi 10' qua mới đóng cầu dao theo app (tự chọn 17/10).
# ADS_STORM_RATIO="0.2"
# LÁT 2 cách ly theo gian (docs 13.8): gian dính 429 tầng shop lùi RIÊNG theo bậc (15' × 2^bậc, trần 120'),
# bậc lưu DB (Channel.adsBackoffLevel/adsBackoffUntil); lượt thành công → bậc 0. Số tự chọn, đo lại Đ1.
# ADS_SHOP_BACKOFF_MIN="15"
# ADS_SHOP_BACKOFF_MAX_MIN="120"
# Giãn lệnh trong MỘT xung của cùng gian (giây), 0 = tắt. Thử 5 để kiểm giả thuyết "lệnh thứ 4 dính 429".
# ADS_SHOP_CALL_GAP_SEC="0"
# THIẾT KẾ 13.9 BƯỚC A (21/10/2026): lệnh Ads Shopee đi qua CỔNG GỌI SÀN (services/marketplace-gateway.ts — GCRA chung
# Postgres theo khóa app / app×gian / app×endpoint, AIMD khi 429, dừng app chỉ khi mã cứng) thay cho withApiBudget.
# "0" = ĐƯỜNG LUI về withApiBudget (token bucket RAM + cầu dao bão) như trước 21/10.
# ADS_GATEWAY="1"
# Trần khởi điểm (lượt/giây) cho mọi endpoint Ads Shopee chưa có dòng riêng trong RATE_LIMITS (tự chọn, cổng tự hạ AIMD).
# GATEWAY_SHOPEE_ADS_PER_SEC="2"
# THIẾT KẾ 13.9 BƯỚC B (21/10/2026, services/ads-demand.ts): nhịp xung từng LỚP gian tự co theo sức chứa khóa — chính sách,
# không phải ngưỡng phản ứng. Nhu cầu ≤ tỷ lệ này × sức chứa (0,8 chừa 20 % cho lệnh tay).
# ADS_DEMAND_UTILIZATION="0.8"
# Trần nhịp xung (phút) khi phải giãn: lớp 1 (tiêu tiền + Trợ lý bật) / lớp 2 (có chiến dịch) / lớp 3 (không chiến dịch).
# ADS_DEMAND_CAP_P1_MIN="120"
# ADS_DEMAND_CAP_P2_MIN="360"
# ADS_DEMAND_CAP_P3_MIN="1440"
# Xung trễ quá nhịp lớp × hệ số này = "trễ hạn chót" (đo cho HQ, không bỏ xung).
# ADS_PULSE_DEADLINE_X="2"
# Tính lại nhịp theo sức chứa mỗi N phút (đếm gian theo lớp + hệ số AIMD từ api_rate_keys).
# ADS_DEMAND_REFRESH_MIN="5"
# Tầng lịch sử cho gian lớp 3 (nối Ads, không chiến dịch) mỗi N giờ thay vì ADS_SYNC_HOURS (không chiến dịch thì chi 30 ngày không đổi).
# ADS_SYNC_HOURS_NO_CAMPAIGN="24"

# ---- Sức khỏe HQ (docs/HQ-SUC-KHOE.md, 12/09/2026) ----
# Worker chụp snapshot + kiểm mốc 2 lần/ngày (chỉ ghi DB; trang HQ → Sức khỏe tự đỏ khi
# vượt ngưỡng — không email, không chuông theo anh Trung 12/09). "1" = tắt.
# HEALTH_WATCH_OFF=""

# Bồi đơn tài khoản trial reviewer ISV/TikTok (worker reviewer-demo-topup): "0" = tắt
REVIEWER_DEMO_TOPUP_MINUTES="30"
REVIEWER_DEMO_EMAIL="reviewer@hubsell.vn"

# ---- Gửi email hệ thống (lib/mailer.ts) ----
# Từ 19/09/2026 gửi qua Zoho Mail của hubsell.vn (SMTP_USER = hộp dev@hubsell.vn,
# SMTP_PASS = Mật khẩu ứng dụng tạo trong Zoho Accounts, KHÔNG phải mật khẩu
# đăng nhập). Chưa đặt 3 biến SMTP_* thì mọi thư tự động lặng lẽ không gửi.
# Tài khoản tổ chức trả tiền dùng smtppro.zoho.com (smtp.zoho.com là của tài khoản cá nhân miễn phí).
SMTP_HOST="smtppro.zoho.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Người gửi theo vai — phải là bí danh của hộp SMTP_USER. Bỏ trống thì rơi về
# MAIL_FROM, rồi "Hubsell <SMTP_USER>".
MAIL_FROM="Hubsell <dev@hubsell.vn>"
MAIL_FROM_NOREPLY="Hubsell <no-reply@hubsell.vn>"
MAIL_FROM_BILLING="Hubsell Thanh toán <billing@hubsell.vn>"
# Địa chỉ nhận khi khách bấm Trả lời (mặc định support@ / billing@hubsell.vn)
# MAIL_REPLY_TO_SUPPORT="support@hubsell.vn"
# MAIL_REPLY_TO_BILLING="billing@hubsell.vn"
# Nhắc hạn gói 7 ngày / 1 ngày trước hạn (worker subscription-reminder): "1" = tắt
# SUBSCRIPTION_REMINDER_OFF="1"
# Lưới an toàn tự xuất HĐĐT bán gói + gửi email PDF cho khách (workers/hq-invoice-auto.ts):
# nhịp quét phút, mặc định 30; "0" = tắt worker (luồng tức thì sau thanh toán vẫn chạy).
# Công tắc bật/tắt tự xuất nằm ở HQ → Sổ quỹ → meInvoice (không phải env).
# HQ_INVOICE_AUTO_MINUTES="30"
# Egress Supabase / băng thông Render (sự cố 09/2026, docs/DEPLOY-RENDER-SUPABASE.md):
# cache nền P&L 30 ngày của Trợ lý quảng cáo theo gian (phút, 0 = tắt cache)
# ADS_PNL_CACHE_MIN="30"
# giãn cách quét cảnh báo vận hành mỗi chủ shop (phút)
# OPS_SCAN_INTERVAL_MIN="30"
# Giới hạn pool kết nối Prisma ghép vào DATABASE_URL lúc khởi động (backend/src/lib/db-url.ts, M1 27/09/2026).
# Chuỗi đã có connection_limit/pool_timeout thì giữ nguyên. Mặc định 5 / 30 giây.
# DB_CONNECTION_LIMIT="5"
# DB_POOL_TIMEOUT="30"
# Hàng đợi bền pg-boss (giai đoạn 2, backend/src/lib/queue.ts, docs/HANG-DOI-BEN.md).
# Pool kết nối RIÊNG của pg-boss ở tiến trình worker (web luôn 1, tự trả khi nghỉ). Mặc định 2.
# QUEUE_POOL_MAX="2"
# Chuỗi kết nối riêng cho pg-boss; bỏ trống = dùng DATABASE_URL. Dùng khi cần trỏ pg-boss
# sang cổng 6543 (chế độ giao dịch của bộ gộp Supabase) lúc số worker tăng chật trần chế độ phiên.
# QUEUE_DATABASE_URL=""
# LISTEN/NOTIFY (08/10/2026, giảm băng thông Render): worker giữ 1 kết nối LISTEN, việc mới được
# đánh thức ngay, hỏi việc chỉ là lưới đỡ. Mặc định bật; "off" = chỉ còn nhịp hỏi (đường lui).
# CHÚ Ý: chỉ chạy ở cổng 5432 (chế độ phiên); QUEUE_DATABASE_URL trỏ 6543 thì thư viện tự báo
# warning và về nhịp hỏi.
# QUEUE_LISTEN_NOTIFY="on"
# Nhịp hỏi lưới đỡ khi NOTIFY đang hoạt động (giây, 0,5–3600). Mặc định 30 = mặc định pg-boss.
# QUEUE_NOTIFY_POLL_SECONDS="30"
# Thời hạn chờ cho lệnh gọi sàn Shopee / Lazada / TikTok (ms, backend/src/lib/platform-http.ts).
# Không đặt = 30000 (30 giây, bật 05/10/2026 theo số đo "[SanHTTP]" 02–05/10: lệnh hợp lệ chậm
# nhất 15,0 giây). Đặt 0 = tắt hẳn thời hạn (đường lui, như trước 05/10/2026).
# PLATFORM_HTTP_TIMEOUT_MS="30000"
# Số việc "kéo lại đơn theo sự kiện sàn" chạy cùng lúc ở một tiến trình worker. Mặc định 4.
# QUEUE_EVT_ORDER_CONCURRENCY="4"

# ---- Cây sản phẩm sàn (docs/MO-HINH-CAY-SAN-PHAM-SAN.md, 18/10/2026) ----
# Sau mỗi lượt kéo danh mục một gian, worker vá dòng đơn giá vốn 0 mà lá nay đã có
# giá hiệu lực (mục 9; chỉ dòng đang 0, không đụng productId). "1" = tắt riêng bước vá.
# COST_ZERO_REPAIR_OFF=""

# ============================================================
# BIẾN CÒN THIẾU TRONG TỆP MẪU — bổ sung 21/10/2026 khi rà dọn (grep process.env
# toàn backend/src đối chiếu tệp này). Tất cả đều TÙY CHỌN: không đặt = mặc định
# trong mã, ghi cạnh từng dòng kèm tệp đọc biến. Đừng đặt trừ khi biết vì sao.
# ============================================================

# ---- Vai trò tiến trình & hạ tầng ----
# all | web | worker — Render đặt trong render.yaml (src/index.ts, services/platform-health.ts).
# HUBSELL_ROLE="all"
# Origin được phép gọi API, cách nhau dấu phẩy, thêm vào danh sách mặc định (src/app.ts).
# CORS_ORIGINS=""
# Nhịp ghi RSS/heap ra log (giây, src/lib/memory-watch.ts). Mặc định 5.
# MEMORY_WATCH_SECONDS="5"
# "0" = tắt làn đọc sàn mới (Pha C, src/workers/read-lanes.ts). Mặc định bật.
# READ_LANES="1"
# Chỉ cho test: ghi đơn kể cả khi không đổi (src/integrations/order-sync-write.ts).
# SYNC_WRITE_ALWAYS=""
# Cửa sổ quét đơn theo mốc nước (services/order-watermark.ts, docs/DONG-BO-GIAI-DOAN-3.md).
# ORDER_SYNC_WINDOW=""

# ---- Sàn ----
# LAZADA_APP_SECRET=""
# LAZADA_REDIRECT_URI=""              # mặc định ghép từ BACKEND_URL (integrations/lazada/config.ts)
# "new" = luồng ủy quyền open.shopee.com/auth; mặc định legacy (integrations/shopee/config.ts).
# SHOPEE_AUTH_FLOW="legacy"
# Ghi đè host Hubsell Ads (integrations/hubsell-ads/config.ts); mặc định theo HUBSELL_ADS_ENV.
# HUBSELL_ADS_API_BASE=""
# Số đơn hoàn tra cứu mỗi lượt TikTok (integrations/tiktok/returns-sync.ts).
# TIKTOK_RETURN_LOOKUP_BATCH=""
# Số đơn gom RAM tối đa mỗi lượt đối soát TikTok trước khi ghi (21/10/2026, integrations/tiktok/service.ts). Mặc định 20000.
# TIKTOK_SETTLE_FLUSH_ORDERS="20000"
# "0" = thôi in hình dạng sự kiện TikTok lần đầu (integrations/tiktok/delivery-fail.ts).
# TIKTOK_SHAPE_LOG="1"

# ---- Trợ lý quảng cáo TikTok ----
# QPS gọi Marketing API mỗi app (integrations/tiktok-ads/client.ts). Mặc định 3 — tự chọn, chưa có công bố.
# ADS_TIKTOK_APP_QPS="3"
# Trần video "theo dõi, chưa áp luật" mỗi lượt (integrations/tiktok-ads/auto-run.ts). Mặc định 10.
# ADS_TIKTOK_TRACK_UNRULED_MAX="10"
# "1" = tắt cảnh báo lời khuyên chiến dịch TikTok (integrations/tiktok-ads/advice-alerts.ts).
# ADS_TIKTOK_ADVICE_ALERTS_OFF=""
# "1" = tắt worker tóm tắt ads hằng ngày (workers/ads-daily-summary.ts).
# ADS_DAILY_SUMMARY_OFF=""

# ---- Đăng nhập Google / Apple (docs/DANG-NHAP-GOOGLE-APPLE-TRONG-APP.md) ----
# GOOGLE_CLIENT_ID=""                 # web OAuth (services/google-oauth.ts)
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""              # mặc định ghép từ BACKEND_URL
# GOOGLE_IOS_CLIENT_ID=""             # audience id_token từ app (services/social-login.ts)
# GOOGLE_ANDROID_CLIENT_ID=""
# APPLE_SIWA_ENABLED="1"              # "0" = tắt Sign in with Apple
# APPLE_SIWA_CLIENT_ID="vn.hubsell.app"
# APPLE_SIWA_TEAM_ID=""
# APPLE_SIWA_KEY_ID=""
# APPLE_SIWA_PRIVATE_KEY=""           # nội dung .p8 (xuống dòng thay bằng \n)

# ---- Mua gói trong app iOS (docs/APPLE-IAP-MUA-GOI-TRONG-APP.md) ----
# APPLE_IAP_BUNDLE_ID="vn.hubsell.app"
# APPLE_IAP_APP_APPLE_ID="6819512670"
# APPLE_IAP_ROOT_CA_DIR=""            # mặc định backend/certs/apple (integrations/apple-iap/verifier.ts)

# ---- payOS ----
# PAYOS_API_BASE="https://api-merchant.payos.vn"

# ---- AI ----
# ANTHROPIC_API_KEY=""                # Trợ lý Hubsell trong app (integrations/ai/copilot.ts)
# COPILOT_MODEL="claude-opus-5"
# ANTHROPIC_API_KEY_HQ=""             # đọc hóa đơn đầu vào HQ (integrations/invoice/input-invoice-reader.ts)
# HQ_INVOICE_MODEL="claude-sonnet-5"

# ---- Supabase Storage (ảnh yêu cầu hỗ trợ, chứng từ HQ — src/lib/supabase-storage.ts) ----
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPPORT_ATTACHMENT_BUCKET="support-attachments"
# HQ_DOCUMENT_BUCKET="hq-documents"

# ---- Nhịp worker (mặc định trong từng tệp workers/*.ts) ----
# TOKEN_REFRESH_MINUTES=""            # workers/token-refresh.ts
# LOG_CLEANUP_HOURS=""                # workers/log-cleanup.ts
# STOCK_RECONCILE_HOURS=""            # workers/stock-reconcile.ts
# INVOICE_AUTO_ISSUE_MINUTES=""       # workers/invoice-lanes.ts
# INVOICE_AUTO_ISSUE_MAX_ATTEMPTS=""  # workers/invoice-auto-issue.ts
# INVOICE_CQT_SWEEP_MINUTES=""        # workers/invoice-cqt-follow.ts
# INVOICE_UNKNOWN_RECHECK_SECONDS=""  # workers/invoice-unknown-recheck.ts
# INVOICE_LANE_CONCURRENCY=""         # src/lib/queue-config.ts
# INVOICE_HTTP_TIMEOUT_MS=""          # integrations/invoice/provider-http.ts

# ---- Sổ cái đơn (docs/SO-CAI-DON.md, workers/order-ledger.ts) ----
# LEDGER_WORKER_ON="1"                # PHẢI = "1" worker ghi sổ mới chạy (render.yaml đã đặt)
# LEDGER_WORKER_OFF=""                # "1" = tắt khẩn
# LEDGER_POLL_MS="2000"
# LEDGER_BATCH="100"                  # 50–2000
# LEDGER_CHUNK_PAUSE_MS="500"         # nghỉ giữa các lô (sự cố 30/09/2026)
# LEDGER_AUDIT_SAMPLE="200"

# ---- Công tắc tắt khẩn từng worker ("1" = tắt) ----
# ONBOARDING_REMINDER_OFF=""
# ORDER_LINE_ID_BACKFILL_OFF=""
# PLAN_HIBERNATE_OFF=""
# PRODUCT_CATALOG_SYNC_OFF=""
# REVIEW_AUTO_REPLY_OFF=""
# TAX_DEADLINE_REMINDER_OFF=""
# WEEKLY_REPORT_OFF=""

# ---- Khác ----
# REFERRAL_LINK_BASE="https://hubsell.vn/register"   # routes/referral.ts
# MISA_SANDBOX_TEST_ENABLED=""        # "1" mở cụm /api/test/misa-sandbox trên production (routes/test-misa-sandbox.ts)
# TAX_DECLARATION_BY_DELIVERED=""     # cơ sở kỳ tờ khai (services/tax-declaration.ts, docs tờ khai theo ngày giao)
