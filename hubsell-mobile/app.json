{
  "expo": {
    "name": "Hubsell",
    "slug": "hubsell-mobile",
    "owner": "hubselltech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "hubsellmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "vn.hubsell.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon-1024.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Hubsell",
        "CFBundleLocalizations": [
          "vi"
        ],
        "CFBundleDevelopmentRegion": "vi"
      }
    },
    "android": {
      "package": "vn.hubsell.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/logo-hubsell.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hubsell dùng Face ID để mở khóa app, bảo vệ số liệu bán hàng của bạn."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hubsell cần Camera để quét mã vận đơn trên kiện hàng hoàn."
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hubsell cần mở thư viện ảnh để bạn chọn ảnh gửi cho khách trong tin nhắn."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hubsell cần Micro để bạn hỏi Trợ lý bằng giọng nói thay vì gõ tay.",
          "speechRecognitionPermission": "Hubsell dùng nhận dạng giọng nói của máy để chuyển câu hỏi của bạn thành chữ."
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "3182c4de-dbee-40e8-8728-b7149848673f"
      }
    }
  }
}
