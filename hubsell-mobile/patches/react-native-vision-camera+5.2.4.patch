diff --git a/node_modules/react-native-vision-camera/ios/Utils/HubsellTimestampOverlay.swift b/node_modules/react-native-vision-camera/ios/Utils/HubsellTimestampOverlay.swift
new file mode 100644
index 0000000..0eda50a
--- /dev/null
+++ b/node_modules/react-native-vision-camera/ios/Utils/HubsellTimestampOverlay.swift
@@ -0,0 +1,219 @@
+///
+/// HubsellTimestampOverlay.swift
+/// HUBSELL - ban thu lat 0, cua 4 tren iPhone (14/11/2026); them MA VAN DON + MA DON HANG 18/11/2026.
+/// !!! Phan them 18/11 viet tren Windows, CHUA DICH THU, CHUA CHAY LAN NAO !!!
+///
+/// In vao goc TRAI TREN cua tung khung hinh TRUOC khi khung duoc ghi bang AVAssetWriter (duong quay
+/// `enablePersistentRecorder`), nen chu nam trong tep video:
+///   dong 1: NGAY GIO (dd/MM/yyyy HH:mm:ss), gio lay tu dong ho DIEN THOAI;
+///   dong 2-4: cac dong chu do man quay (JS) dua xuong - hien la "Ma van don: ..." va "Ma don hang: ...".
+/// Anh Trung 18/11: "cu thu duong in them ma don hang va ma van don kem xem sao" (dao quyet dinh 14/11
+/// "chi can ngay gio thoi") - san doi video phai THAY RO ma van don, tem that trong hinh qua nho.
+///
+/// DUONG TRUYEN CHU tu JS: JS goi `Settings.set({ hubsellPackOverlayLabel: "dong 1\ndong 2" })` cua React
+/// Native -> NSUserDefaults.standard; lop nay doc lai khoa do o MOI khung hinh (doc tu bo nho, re). JS dat
+/// chu SAU khi clip cu da dung va TRUOC khi mo clip moi, nen clip nao mang dung ma cua clip do. Chuoi rong
+/// = chi in ngay gio. Noi dung chu do JS quyet -> doi cau chu khong can dung lai app.
+///
+/// Ve thang len bo dem hinh:
+///   - 4:2:0 hai mat phang 8 bit (dinh dang goc thuong gap): ve chu trang + nen den mo len mat phang
+///     DO SANG bang CGContext xam, roi dat mau cua vung nen ve trung tinh (128).
+///   - BGRA: ve bang CGContext RGB.
+///   - Dinh dang khac (10 bit / HDR...): KHONG ve, in mot dong nhat ky.
+/// Lop phu nay KHONG hien tren man xem truoc cua iPhone (man xem truoc lay hinh thang tu camera) -
+/// man thu tu ve lai cac dong nay len tren.
+///
+
+import AVFoundation
+import CoreGraphics
+import CoreText
+import CoreVideo
+import Foundation
+
+final class HubsellTimestampOverlay {
+  /// Khoa NSUserDefaults ma man quay (JS) ghi cac dong chu can in, cach nhau bang dau xuong dong.
+  static let labelKey = "hubsellPackOverlayLabel"
+  /// Toi da ngan nay dong chu them (ngoai dong ngay gio) va ngan nay ky tu moi dong.
+  static let maxLabelLines = 3
+  static let maxLabelChars = 44
+
+  var enabled = true
+
+  private let formatter: DateFormatter
+  /// Dong chu da dung san: "<co chu>|<chuoi>" -> CTLine. Ngay gio doi moi giay, ma doi moi clip.
+  private var lineCache: [String: CTLine] = [:]
+  private var loggedFormat = false
+
+  /// Mot hop chu da tinh xong vi tri (toa do CGContext: goc o DUOI TRAI).
+  private struct Box {
+    let line: CTLine
+    let rect: CGRect
+    let textOrigin: CGPoint
+    /// Mep tren / duoi cua hop tinh tu DINH hinh (de xoa mau o mat phang mau).
+    let top: CGFloat
+    let bottom: CGFloat
+  }
+
+  init() {
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: "en_US_POSIX")
+    formatter.dateFormat = "dd/MM/yyyy HH:mm:ss"
+    self.formatter = formatter
+  }
+
+  private func makeLine(_ text: String, fontSize: CGFloat) -> CTLine {
+    let key = "\(Int(fontSize))|\(text)"
+    if let cached = lineCache[key] { return cached }
+    if lineCache.count > 24 { lineCache.removeAll() }
+    let font = CTFontCreateWithName("Menlo-Bold" as CFString, fontSize, nil)
+    let attributes: [NSAttributedString.Key: Any] = [
+      NSAttributedString.Key(kCTFontAttributeName as String): font,
+      NSAttributedString.Key(kCTForegroundColorAttributeName as String): CGColor(gray: 1.0, alpha: 1.0),
+    ]
+    let made = CTLineCreateWithAttributedString(NSAttributedString(string: text, attributes: attributes) as CFAttributedString)
+    lineCache[key] = made
+    return made
+  }
+
+  /// Cac dong chu JS dua xuong (da cat bot so dong va do dai).
+  private func labelLines() -> [String] {
+    guard let raw = UserDefaults.standard.string(forKey: HubsellTimestampOverlay.labelKey), !raw.isEmpty else {
+      return []
+    }
+    var lines: [String] = []
+    for part in raw.components(separatedBy: "\n") {
+      let trimmed = part.trimmingCharacters(in: .whitespaces)
+      if trimmed.isEmpty { continue }
+      lines.append(String(trimmed.prefix(HubsellTimestampOverlay.maxLabelChars)))
+      if lines.count >= HubsellTimestampOverlay.maxLabelLines { break }
+    }
+    return lines
+  }
+
+  func draw(on sampleBuffer: CMSampleBuffer) {
+    guard enabled, let pixelBuffer = CMSampleBufferGetImageBuffer(sampleBuffer) else { return }
+    let pixelFormat = CVPixelBufferGetPixelFormatType(pixelBuffer)
+    let width = CVPixelBufferGetWidth(pixelBuffer)
+    let height = CVPixelBufferGetHeight(pixelBuffer)
+    guard width > 16, height > 16 else { return }
+
+    let isBiPlanar8 =
+      pixelFormat == kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange
+      || pixelFormat == kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+    let isBGRA = pixelFormat == kCVPixelFormatType_32BGRA
+    if !loggedFormat {
+      loggedFormat = true
+      print("[HubsellTimestamp] khung=\(width)x\(height) dinhDang=\(pixelFormat) ve=\(isBiPlanar8 || isBGRA)")
+    }
+    guard isBiPlanar8 || isBGRA else { return }
+
+    // Kich thuoc theo canh ngan cua KHUNG VIDEO, giong ban Android: ngay gio cao ~3,5 % (720 -> ~25 diem anh);
+    // dong ma to hon mot bac (~4,2 %) vi day la thu san can doc.
+    let frameW = CGFloat(width)
+    let frameH = CGFloat(height)
+    let shortSide = min(frameW, frameH)
+    let stampSize = (shortSide * 0.035).rounded()
+    let codeSize = (shortSide * 0.042).rounded()
+    let margin = (shortSide * 0.02).rounded()
+    let gap = max(CGFloat(2), (shortSide * 0.004).rounded())
+    let available = frameW - margin * 2
+
+    var texts: [String] = [formatter.string(from: Date())]
+    var sizes: [CGFloat] = [stampSize]
+    for label in labelLines() {
+      texts.append(label)
+      sizes.append(codeSize)
+    }
+
+    // Xep cac hop tu tren xuong. Dong nao rong hon khung thi thu nho co chu cho vua.
+    var boxes: [Box] = []
+    var top = margin
+    for index in 0..<texts.count {
+      let text = texts[index]
+      var fontSize = sizes[index]
+      var pad = (fontSize * 0.3).rounded()
+      var line = makeLine(text, fontSize: fontSize)
+      var ascent: CGFloat = 0
+      var descent: CGFloat = 0
+      var leading: CGFloat = 0
+      var textWidth = CGFloat(CTLineGetTypographicBounds(line, &ascent, &descent, &leading))
+      if textWidth + pad * 2 > available && textWidth > 0 {
+        let shrunk = (fontSize * (available - pad * 2) / textWidth).rounded(.down)
+        fontSize = max(CGFloat(8), shrunk)
+        pad = (fontSize * 0.3).rounded()
+        line = makeLine(text, fontSize: fontSize)
+        textWidth = CGFloat(CTLineGetTypographicBounds(line, &ascent, &descent, &leading))
+      }
+      let boxWidth = (textWidth + pad * 2).rounded(.up)
+      let boxHeight = (ascent + descent + pad * 2).rounded(.up)
+      // Het cho (khung qua nho / qua nhieu dong) thi dung, khong ve ra ngoai bo dem.
+      if margin + boxWidth >= frameW || top + boxHeight + margin >= frameH { break }
+      let box = Box(
+        line: line,
+        rect: CGRect(x: margin, y: frameH - top - boxHeight, width: boxWidth, height: boxHeight),
+        textOrigin: CGPoint(x: margin + pad, y: frameH - top - pad - ascent),
+        top: top,
+        bottom: top + boxHeight)
+      boxes.append(box)
+      top += boxHeight + gap
+    }
+    guard !boxes.isEmpty else { return }
+
+    guard CVPixelBufferLockBaseAddress(pixelBuffer, []) == kCVReturnSuccess else { return }
+    defer { CVPixelBufferUnlockBaseAddress(pixelBuffer, []) }
+
+    if isBGRA {
+      guard let base = CVPixelBufferGetBaseAddress(pixelBuffer) else { return }
+      let bitmapInfo = CGImageAlphaInfo.premultipliedFirst.rawValue | CGBitmapInfo.byteOrder32Little.rawValue
+      guard
+        let context = CGContext(
+          data: base, width: width, height: height, bitsPerComponent: 8,
+          bytesPerRow: CVPixelBufferGetBytesPerRow(pixelBuffer),
+          space: CGColorSpaceCreateDeviceRGB(), bitmapInfo: bitmapInfo)
+      else { return }
+      for box in boxes {
+        context.setFillColor(red: 0, green: 0, blue: 0, alpha: 0.6)
+        context.fill(box.rect)
+        context.textPosition = box.textOrigin
+        CTLineDraw(box.line, context)
+      }
+      return
+    }
+
+    // 4:2:0 hai mat phang: mat phang 0 = do sang (1 byte / diem anh).
+    guard let lumaBase = CVPixelBufferGetBaseAddressOfPlane(pixelBuffer, 0) else { return }
+    let lumaWidth = CVPixelBufferGetWidthOfPlane(pixelBuffer, 0)
+    let lumaHeight = CVPixelBufferGetHeightOfPlane(pixelBuffer, 0)
+    guard
+      let context = CGContext(
+        data: lumaBase, width: lumaWidth, height: lumaHeight, bitsPerComponent: 8,
+        bytesPerRow: CVPixelBufferGetBytesPerRowOfPlane(pixelBuffer, 0),
+        space: CGColorSpaceCreateDeviceGray(), bitmapInfo: CGImageAlphaInfo.none.rawValue)
+    else { return }
+    for box in boxes {
+      context.setFillColor(gray: 0.0, alpha: 0.6)
+      context.fill(box.rect)
+      context.textPosition = box.textOrigin
+      CTLineDraw(box.line, context)
+    }
+
+    // Mat phang 1 = mau (Cb, Cr xen ke; moi chieu bang mot nua). Dat vung nen ve 128 = khong mau,
+    // de chu trang khong bi am mau cua canh ben duoi.
+    guard let chromaBase = CVPixelBufferGetBaseAddressOfPlane(pixelBuffer, 1) else { return }
+    let chromaWidth = CVPixelBufferGetWidthOfPlane(pixelBuffer, 1)
+    let chromaHeight = CVPixelBufferGetHeightOfPlane(pixelBuffer, 1)
+    let chromaBytesPerRow = CVPixelBufferGetBytesPerRowOfPlane(pixelBuffer, 1)
+    let chromaLeft = Int(margin) / 2
+    for box in boxes {
+      let chromaRight = min(chromaWidth, (Int(margin + box.rect.width) + 1) / 2)
+      let topRow = Int(box.top) / 2
+      let bottomRow = min(chromaHeight, (Int(box.bottom) + 1) / 2)
+      if chromaRight <= chromaLeft || bottomRow <= topRow { continue }
+      let byteCount = min((chromaRight - chromaLeft) * 2, chromaBytesPerRow - chromaLeft * 2)
+      if byteCount <= 0 { continue }
+      for row in topRow..<bottomRow {
+        memset(chromaBase.advanced(by: row * chromaBytesPerRow + chromaLeft * 2), 128, byteCount)
+      }
+    }
+  }
+}
