+++ b/node_modules/react-native-vision-camera/android/src/main/java/com/margelo/nitro/camera/session/TimestampOverlay.kt
@@ -0,0 +1,143 @@
+package com.margelo.nitro.camera.session
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.PorterDuff
+import android.graphics.Typeface
+import android.os.Handler
+import android.os.HandlerThread
+import android.util.Log
+import androidx.camera.core.CameraEffect
+import androidx.camera.core.Preview
+import androidx.camera.core.UseCase
+import androidx.camera.effects.OverlayEffect
+import androidx.camera.video.VideoCapture
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * HUBSELL - ban thu lat 0, cua 4 (14/11/2026).
+ * In NGAY GIO (dd/MM/yyyy HH:mm:ss, chay tung giay) vao goc TRAI TREN cua hinh, ngay luc quay:
+ * lop phu cua CameraX duoc tron vao khung hinh truoc khi toi bo ma hoa, nen chu nam trong tep MP4.
+ * Chi in ngay gio - khong ma van don, khong ten shop (anh Trung chot 14/11).
+ * Gio lay tu dong ho DIEN THOAI (ban thu chua co may chu).
+ */
+object TimestampOverlay {
+  private const val TAG = "HubsellTimestamp"
+
+  /** Tat = quay hinh tron nhu truoc (de so sanh cua 2 / cua 3). */
+  @Volatile
+  var enabled: Boolean = true
+
+  /** Canh dai / canh ngan cua KHUNG TEP VIDEO (16:9 mac dinh, 4:3 khi dau quay duoc ep 4:3). */
+  @Volatile
+  var videoLongOverShort: Float = 16f / 9f
+
+  private val thread by lazy { HandlerThread("HubsellTimestampOverlay").apply { start() } }
+  private val handler by lazy { Handler(thread.looper) }
+  private val format = SimpleDateFormat("dd/MM/yyyy HH:mm:ss", Locale.US)
+  private val textPaint =
+    Paint(Paint.ANTI_ALIAS_FLAG).apply {
+      color = Color.WHITE
+      typeface = Typeface.create(Typeface.MONOSPACE, Typeface.BOLD)
+    }
+  private val boxPaint = Paint().apply { color = Color.argb(150, 0, 0, 0) }
+  private var effect: OverlayEffect? = null
+  private var loggedGeometry = false
+
+  /**
+   * Tra ve lop phu neu phien co CA xem truoc lan quay video; khong thi null (phien chi quet ma,
+   * chi chup anh... giu nguyen nhu thu vien goc).
+   */
+  @Synchronized
+  fun effectFor(useCases: List<UseCase>): CameraEffect? {
+    if (!enabled) return null
+    val hasPreview = useCases.any { it is Preview }
+    val hasVideo = useCases.any { it is VideoCapture<*> }
+    if (!hasPreview || !hasVideo) return null
+    effect?.let { return it }
+
+    val created =
+      OverlayEffect(
+        CameraEffect.PREVIEW or CameraEffect.VIDEO_CAPTURE,
+        0, // khong xep hang khung hinh: chu khong phu thuoc ket qua phan tich
+        handler,
+      ) { error -> Log.e(TAG, "Lop phu ngay gio loi", error) }
+    created.setOnDrawListener { frame ->
+      try {
+        val canvas = frame.overlayCanvas
+        canvas.drawColor(Color.TRANSPARENT, PorterDuff.Mode.CLEAR)
+        val crop = frame.cropRect
+        val rotation = ((frame.rotationDegrees % 360) + 360) % 360
+        if (!loggedGeometry) {
+          loggedGeometry = true
+          Log.i(TAG, "khung=${frame.size} cat=$crop xoay=$rotation")
+        }
+        draw(canvas, crop.left.toFloat(), crop.top.toFloat(), crop.width().toFloat(), crop.height().toFloat(), rotation)
+      } catch (e: Throwable) {
+        Log.e(TAG, "Ve ngay gio loi", e)
+      }
+      true
+    }
+    effect = created
+    Log.i(TAG, "Da tao lop phu ngay gio")
+    return created
+  }
+
+  /**
+   * Ve trong he toa do "nguoi xem": (0,0) la goc trai tren cua hinh SAU khi xoay cho dung chieu.
+   * Vung dem (w x h, goc tai left/top) phai xoay `rotation` do theo chieu kim dong ho moi dung chieu.
+   */
+  private fun draw(canvas: Canvas, left: Float, top: Float, w: Float, h: Float, rotation: Int) {
+    canvas.save()
+    canvas.translate(left, top)
+    val viewW: Float
+    val viewH: Float
+    when (rotation) {
+      90 -> {
+        canvas.translate(0f, h)
+        canvas.rotate(-90f)
+        viewW = h
+        viewH = w
+      }
+      180 -> {
+        canvas.translate(w, h)
+        canvas.rotate(180f)
+        viewW = w
+        viewH = h
+      }
+      270 -> {
+        canvas.translate(w, 0f)
+        canvas.rotate(90f)
+        viewW = h
+        viewH = w
+      }
+      else -> {
+        viewW = w
+        viewH = h
+      }
+    }
+    // Luong chung cho xem truoc + quay la 4:3, con tep video la 16:9 cat GIUA (nhat ky ban 7:
+    // khung 1440x1080, video cat Rect(0,135-1440,945)). Lop phu khong duoc biet vung cat cua video,
+    // nen dat chu trong vung 16:9 nam giua - neu khong, dau dong chu bi cat khoi tep quay.
+    val targetRatio = if (viewW < viewH) 1f / videoLongOverShort else videoLongOverShort
+    var safeW = viewW
+    var safeH = viewH
+    if (viewW / viewH > targetRatio) safeW = viewH * targetRatio else safeH = viewW / targetRatio
+    canvas.translate((viewW - safeW) / 2f, (viewH - safeH) / 2f)
+    val shortSide = minOf(safeW, safeH)
+    val textSize = shortSide * 0.035f // 720 px -> chu cao ~25 px
+    val margin = shortSide * 0.02f
+    val pad = textSize * 0.3f
+    textPaint.textSize = textSize
+    val text = format.format(Date())
+    val textW = textPaint.measureText(text)
+    val metrics = textPaint.fontMetrics
+    val boxH = (metrics.descent - metrics.ascent) + pad * 2
+    canvas.drawRect(margin, margin, margin + textW + pad * 2, margin + boxH, boxPaint)
+    canvas.drawText(text, margin + pad, margin + pad - metrics.ascent, textPaint)
+    canvas.restore()
+  }
+}
