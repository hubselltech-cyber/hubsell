diff --git a/node_modules/react-native-vision-camera/android/src/main/java/com/margelo/nitro/camera/session/TimestampOverlay.kt b/node_modules/react-native-vision-camera/android/src/main/java/com/margelo/nitro/camera/session/TimestampOverlay.kt
